# Keep public previews out of search results. Change to production only for the
# final domain build after content, media, and legal review are complete.
PUBLIC_SITE_ENV=staging

# Public media base URL for future Cloudflare R2 integration.
PUBLIC_MEDIA_BASE_URL=https://media.yayasangambut.org

# Public, read-only WebGIS API endpoint. Never place API secrets in PUBLIC_ variables.
PUBLIC_WEBGIS_API_URL=https://webgisyg.id/api/public
