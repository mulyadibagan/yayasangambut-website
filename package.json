{
  "name": "yayasangambut-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run content:validate-programs && astro build --mode staging",
    "build:production": "npm run content:validate-programs && node scripts/build-production.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "content:import-wordpress": "node scripts/import-wordpress.mjs",
    "content:validate-programs": "node scripts/validate-programs.mjs",
    "deploy": "gh workflow run publish-staging.yml --ref main --repo mulyadibagan/yayasangambut-website"
  },
  "dependencies": {
    "astro": "^7.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.135.0"
  }
}
