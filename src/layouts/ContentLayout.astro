---
import BaseLayout from './BaseLayout.astro'; const { title,intro,eyebrow }=Astro.props;
---
<BaseLayout title={`${title} — Yayasan Gambut`} description={intro}><header class="page-hero"><div class="container">{eyebrow&&<p class="eyebrow">{eyebrow}</p>}<h1>{title}</h1><p class="lede">{intro}</p></div></header><slot/></BaseLayout>
<style>.page-hero{padding:clamp(2rem,4vw,3.5rem) 0 clamp(1.8rem,3vw,2.5rem);background:linear-gradient(115deg,var(--paper) 68%,rgba(145,196,205,.18));border-bottom:1px solid var(--line)}h1{max-width:25ch;margin-bottom:1rem}</style>
