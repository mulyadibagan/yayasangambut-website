---
import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import { organisation, pagePairs } from '../data/site'; import '../styles/global.css';
const { title, description, article=false, image }=Astro.props; const canonical=new URL(Astro.url.pathname,Astro.site); const lang=Astro.currentLocale??'id';
const currentPath=Astro.url.pathname.endsWith('/')?Astro.url.pathname:`${Astro.url.pathname}/`; const alternatePath=pagePairs[currentPath];
const idPath=alternatePath?(lang==='id'?currentPath:alternatePath):null; const enPath=alternatePath?(lang==='en'?currentPath:alternatePath):null;
const socialImage=image?new URL(image,Astro.site).href:new URL('/brand/yayasan-gambut-logo.png',Astro.site).href;
const schema=article?{'@context':'https://schema.org','@type':'Article',headline:title,description,mainEntityOfPage:canonical.href,image}:{'@context':'https://schema.org','@type':'Organization',name:'Yayasan Gambut',url:'https://yayasangambut.org',logo:'https://yayasangambut.org/brand/yayasan-gambut-logo.png',email:organisation.email,address:[organisation.headOffice,organisation.pekanbaruOffice],sameAs:[organisation.facebook,organisation.instagram,organisation.linkedin,organisation.youtube,'https://webgisyg.id/']};
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="generator" content={Astro.generator}/><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{alternatePath&&<Fragment><link rel="alternate" hreflang="id" href={new URL(idPath!,Astro.site)}/><link rel="alternate" hreflang="en" href={new URL(enPath!,Astro.site)}/><link rel="alternate" hreflang="x-default" href={new URL(idPath!,Astro.site)}/></Fragment>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={socialImage}/><meta name="twitter:card" content={image?'summary_large_image':'summary'}/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><script type="application/ld+json" set:html={JSON.stringify(schema)}></script><title>{title}</title></head><body><a class="skip-link" href="#main">{lang==='id'?'Lewati ke isi utama':'Skip to main content'}</a><Header/><main id="main"><slot/></main><Footer/></body></html>
