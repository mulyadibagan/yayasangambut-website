---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organisation, pagePairs } from '../data/site';
import { excerpt } from '../utils/text';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  article?: boolean;
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  headline?: string;
  noIndex?: boolean;
  minimalChrome?: boolean;
  schemaType?: 'organization' | 'webpage';
}

const {
  title,
  description,
  article = false,
  image,
  publishedTime,
  modifiedTime,
  author,
  headline,
  noIndex = false,
  minimalChrome = false,
  schemaType = 'webpage',
} = Astro.props;
const lang = Astro.currentLocale ?? 'id';
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(currentPath, Astro.site).href;
const alternatePath = pagePairs[currentPath];
const alternateLang = lang === 'id' ? 'en' : 'id';
const socialImage = image
  ? new URL(image, Astro.site).href
  : new URL('/brand/yayasan-gambut-logo.png', Astro.site).href;
// Search indexing is opt-in. A plain `astro build` must not become indexable
// merely because Vite's default mode is named "production".
const isProduction = import.meta.env.PUBLIC_SITE_ENV === 'production';
const metaDescription = excerpt(description, 155);

const organisationSchema = {
  '@type': 'Organization',
  name: 'Yayasan Gambut',
  url: 'https://yayasangambut.org',
  logo: 'https://yayasangambut.org/brand/yayasan-gambut-logo.png',
};

const postalAddress = (streetAddress: string, addressLocality: string, postalCode: string) => ({
  '@type': 'PostalAddress',
  streetAddress,
  addressLocality,
  postalCode,
  addressCountry: 'ID',
});

const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: headline ?? title,
      description: metaDescription,
      mainEntityOfPage: canonical,
      image: socialImage,
      ...(publishedTime && { datePublished: publishedTime }),
      ...(modifiedTime && { dateModified: modifiedTime }),
      ...(author && { author: { '@type': 'Organization', name: author } }),
      publisher: organisationSchema,
    }
  : schemaType === 'organization'
    ? {
      '@context': 'https://schema.org',
      ...organisationSchema,
      email: organisation.email,
      address: [
        postalAddress('Taman Puri Bintaro PB.11 Nomor 16, Bintaro Sektor 9, Kelurahan Sawah Baru, Kecamatan Ciputat', 'Kota Tangerang Selatan', '15413'),
        postalAddress('Jalan Gulama No. 8, Kelurahan Tangkerang Barat, Kecamatan Marpoyan Damai', 'Kota Pekanbaru', '28282'),
      ],
      sameAs: [organisation.facebook, organisation.instagram, organisation.linkedin, organisation.youtube, 'https://webgisyg.id/'],
    }
    : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description: metaDescription,
      url: canonical,
      inLanguage: lang,
      ...(image && { primaryImageOfPage: socialImage }),
      isPartOf: {
        '@type': 'WebSite',
        name: 'Yayasan Gambut',
        url: 'https://yayasangambut.org',
      },
      about: organisationSchema,
    };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={isProduction && !noIndex ? 'index, follow' : 'noindex, nofollow, noarchive'} />
    <meta name="theme-color" content="#0a2c27" />
    <link rel="canonical" href={canonical} />
    {alternatePath && <link rel="alternate" hreflang={alternateLang} href={new URL(alternatePath, Astro.site).href} />}
    <link rel="alternate" hreflang={lang} href={canonical} />
    {alternatePath && <link rel="alternate" hreflang="x-default" href={lang === 'id' ? canonical : new URL(alternatePath, Astro.site).href} />}
    <link rel="icon" type="image/png" href="/brand/yayasan-gambut-logo.png?v=2" />
    <link rel="apple-touch-icon" href="/brand/yayasan-gambut-logo.png?v=2" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Yayasan Gambut" />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={image ? title : 'Logo Yayasan Gambut'} />
    {article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={image ? title : 'Logo Yayasan Gambut'} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'id' ? 'Lewati ke isi utama' : 'Skip to main content'}</a>
    {!minimalChrome && <Header />}
    <main id="main"><slot /></main>
    {!minimalChrome && <Footer />}
  </body>
</html>
