---
import CollectionPage from '../../components/CollectionPage.astro'; import GalleryPage from '../../components/GalleryPage.astro'; import InfoPage from '../../components/InfoPage.astro'; import type { Lang } from '../../data/site';
export function getStaticPaths(){return[
  {params:{lang:'id',page:'tentang-kami'},props:{kind:'info'}},{params:{lang:'id',page:'program'},props:{kind:'programs'}},{params:{lang:'id',page:'lokasi-kerja'},props:{kind:'info'}},{params:{lang:'id',page:'dampak'},props:{kind:'info'}},{params:{lang:'id',page:'cerita'},props:{kind:'articles'}},{params:{lang:'id',page:'publikasi'},props:{kind:'publications'}},{params:{lang:'id',page:'galeri'},props:{kind:'gallery'}},{params:{lang:'id',page:'hubungi-kami'},props:{kind:'info'}},
  {params:{lang:'en',page:'about'},props:{kind:'info'}},{params:{lang:'en',page:'programs'},props:{kind:'programs'}},{params:{lang:'en',page:'where-we-work'},props:{kind:'info'}},{params:{lang:'en',page:'impact'},props:{kind:'info'}},{params:{lang:'en',page:'field-stories'},props:{kind:'articles'}},{params:{lang:'en',page:'publications'},props:{kind:'publications'}},{params:{lang:'en',page:'gallery'},props:{kind:'gallery'}},{params:{lang:'en',page:'contact'},props:{kind:'info'}},
]}; const {lang,page}=Astro.params as {lang:Lang,page:string}; const {kind}=Astro.props;
---
{kind==='info'?<InfoPage lang={lang} page={page}/>:kind==='gallery'?<GalleryPage lang={lang}/>:<CollectionPage lang={lang} type={kind}/>}
