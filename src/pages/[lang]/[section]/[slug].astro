---
import { getCollection, render } from 'astro:content'; import BaseLayout from '../../../layouts/BaseLayout.astro';
export async function getStaticPaths(){const all=[...(await getCollection('programs')),...(await getCollection('articles')),...(await getCollection('publications'))];return all.filter(e=>e.data.status==='published').map(entry=>{const lang=entry.data.language;const section=entry.collection==='programs'?(lang==='id'?'program':'programs'):entry.collection==='articles'?(lang==='id'?'cerita':'field-stories'):(lang==='id'?'publikasi':'publications');return{params:{lang,section,slug:entry.data.slug},props:{entry}}})}
const {entry}=Astro.props; const {Content}=await render(entry); const lang=entry.data.language; const isArticle=entry.collection==='articles';
---
<BaseLayout title={`${entry.data.title} — Yayasan Gambut`} description={entry.data.summary} article={isArticle} image={isArticle?entry.data.featuredImage:undefined}><article class="detail"><header class="container"><p class="eyebrow">{entry.collection==='publications'?entry.data.year:('category'in entry.data?entry.data.category:entry.data.eyebrow)}</p><h1>{entry.data.title}</h1><p class="lede">{entry.data.summary}</p>{isArticle&&<p class="meta">{entry.data.author} · {entry.data.date.toLocaleDateString(lang==='id'?'id-ID':'en-GB',{year:'numeric',month:'long',day:'numeric'})}</p>}</header>{isArticle&&<figure><img src={entry.data.featuredImage} width="1600" height="900" alt={entry.data.imageAlt}/>{entry.data.imageCredit&&<figcaption>{entry.data.imageCredit}</figcaption>}</figure>}<div class="container prose"><Content/>{entry.collection==='publications'&&<p><a class="button primary" href={entry.data.fileUrl}>{lang==='id'?'Unduh publikasi (segera tersedia)':'Download publication (coming soon)'}</a></p>}</div></article></BaseLayout>
<style>.detail>header{padding:clamp(4rem,8vw,8rem) 0 3rem}.detail h1{max-width:15ch}.meta{font-weight:750;color:var(--coast-700)}figure{width:min(calc(100% - 2rem),86rem);margin:0 auto}figure img{max-height:46rem;object-fit:cover;border-radius:var(--radius-lg)}figcaption{padding:.5rem 0;color:var(--muted);font-size:.75rem}.prose{max-width:48rem;padding-top:3rem;padding-bottom:7rem}.prose :global(h2){font-size:2rem;margin-top:2.5rem}.prose :global(p),.prose :global(li){font-size:1.08rem;color:var(--muted)}</style>
