---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categoryLabel, excerpt } from '../../../utils/text';
export async function getStaticPaths(){
  const all=[...(await getCollection('programs')),...(await getCollection('articles')),...(await getCollection('publications'))];
  return all.filter(e=>e.data.status==='published').map(entry=>{
    const lang=entry.data.language;
    const section=entry.collection==='programs'?(lang==='id'?'program':'programs'):entry.collection==='articles'?(lang==='id'?'cerita':'field-stories'):(lang==='id'?'publikasi':'publications');
    return{params:{lang,section,slug:entry.data.slug},props:{entry}};
  });
}
const {entry}=Astro.props;
const {Content}=await render(entry);
const lang=entry.data.language;
const isProgram=entry.collection==='programs';
const isArticle=entry.collection==='articles';
const isPublication=entry.collection==='publications';
const collectionUrl=`/${lang}/${entry.collection==='programs'?(lang==='id'?'program':'programs'):isArticle?(lang==='id'?'cerita':'field-stories'):(lang==='id'?'publikasi':'publications')}/`;
const collectionLabel=entry.collection==='programs'?(lang==='id'?'Program':'Programs'):isArticle?(lang==='id'?'Cerita Lapangan':'Field Stories'):(lang==='id'?'Publikasi':'Publications');
const summary=excerpt(entry.data.summary,220);
const metaDescription=excerpt(entry.data.summary,155);
const eyebrow=isPublication?entry.data.year:('category'in entry.data?categoryLabel(entry.data.category,lang):entry.data.eyebrow);
---
<BaseLayout title={`${excerpt(entry.data.title,48)} — Yayasan Gambut`} description={metaDescription} article={isArticle} headline={isArticle?entry.data.title:undefined} image={isArticle?entry.data.featuredImage:entry.data.cover} publishedTime={isArticle?entry.data.date.toISOString():undefined} modifiedTime={isArticle?entry.data.modified?.toISOString():undefined} author={isArticle?entry.data.author:undefined}>
  <article class="detail">
    <header class="container"><nav class="breadcrumb" aria-label={lang==='id'?'Navigasi halaman':'Breadcrumb'}><a href={collectionUrl}>{collectionLabel}</a><span aria-hidden="true">／</span><span aria-current="page">{entry.data.title}</span></nav><p class="eyebrow">{eyebrow}</p><h1>{entry.data.title}</h1><p class="lede">{summary}</p>{isArticle&&<p class="meta">{entry.data.author} · <time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString(lang==='id'?'id-ID':'en-GB',{year:'numeric',month:'long',day:'numeric'})}</time></p>}{isPublication&&<dl class="publication-meta"><div><dt>{lang==='id'?'Jenis':'Type'}</dt><dd>{entry.data.category}</dd></div><div><dt>{lang==='id'?'Tahun':'Year'}</dt><dd>{entry.data.year}</dd></div><div><dt>{lang==='id'?'Bahasa dokumen':'Document language'}</dt><dd>{entry.data.documentLanguage==='en'?'English':'Bahasa Indonesia'}</dd></div></dl>}</header>
    {isArticle&&entry.data.featuredImage&&<figure class="featured"><img src={entry.data.featuredImage} width="1600" height="900" alt={entry.data.imageAlt||entry.data.title}/>{entry.data.imageCredit&&<figcaption>{entry.data.imageCredit}</figcaption>}</figure>}
    {isPublication&&entry.data.cover&&<figure class="publication-cover"><img src={entry.data.cover} width="900" height="1200" alt={entry.data.title}/></figure>}
    <div class="container prose"><Content/>
      {isPublication&&<p><a class="button primary" href={entry.data.fileUrl} target="_blank" rel="noreferrer">{lang==='id'?'Buka atau unduh PDF ↗':'Open or download PDF ↗'}</a></p>}
      {isProgram&&<aside class="program-actions"><h2>{lang==='id'?'Jelajahi data dan peluang kolaborasi':'Explore data and collaboration'}</h2><p>{lang==='id'?'Lihat peta serta pemantauan yang telah dipublikasikan melalui YG GeoPortal, atau hubungi tim kami untuk membahas kebutuhan dan peluang kerja sama.':'View published maps and monitoring through the YG GeoPortal, or contact our team to discuss needs and opportunities for collaboration.'}</p><div><a class="button primary" href="https://webgisyg.id/" target="_blank" rel="noreferrer">{lang==='id'?'Buka YG GeoPortal ↗':'Open YG GeoPortal ↗'}</a><a class="button secondary" href={lang==='id'?'/id/hubungi-kami/':'/en/contact/'}>{lang==='id'?'Hubungi Kami':'Contact Us'}</a></div></aside>}
    </div>
  </article>
</BaseLayout>
<style>
  .detail>header{padding:clamp(3rem,7vw,7rem) 0 3rem}.detail h1{max-width:22ch;font-size:clamp(2.45rem,5vw,5.25rem);letter-spacing:-.045em}.breadcrumb{display:flex;gap:.5rem;align-items:center;margin-bottom:2.5rem;color:var(--muted);font-size:.78rem}.breadcrumb span:last-child{overflow:hidden;max-width:32rem;text-overflow:ellipsis;white-space:nowrap}.meta{font-weight:750;color:var(--coast-700)}.publication-meta{display:flex;flex-wrap:wrap;gap:.75rem 2rem;margin:2rem 0 0}.publication-meta div{display:grid;gap:.2rem}.publication-meta dt{color:var(--muted);font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.publication-meta dd{margin:0;font-weight:750}.featured{width:min(calc(100% - 2rem),86rem);margin:0 auto}.featured img{max-height:46rem;object-fit:cover;border-radius:var(--radius-lg)}figcaption{padding:.5rem 0;color:var(--muted);font-size:.75rem}.publication-cover{width:min(calc(100% - 2rem),42rem);margin:0 auto}.publication-cover img{max-height:44rem;object-fit:contain;border-radius:var(--radius-md);background:white}.prose{max-width:48rem;padding-top:3rem;padding-bottom:7rem}.prose :global(h2){font-size:2rem;margin-top:2.5rem}.prose :global(h3){margin-top:2rem;font-size:1.35rem}.prose :global(p),.prose :global(li){font-size:1.08rem;color:var(--muted)}.prose :global(img){margin:2rem 0;border-radius:var(--radius-md)}.prose :global(a){overflow-wrap:anywhere}.program-actions{margin-top:4rem;padding:clamp(1.5rem,4vw,2.5rem);border-radius:var(--radius-md);background:#dce8e6}.program-actions h2{margin-top:0!important}.program-actions>div{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}
</style>
