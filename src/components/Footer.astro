---
import Logo from './Logo.astro'; import { routeMap, type Lang } from '../data/site'; const lang=(Astro.currentLocale??'id') as Lang; const r=routeMap[lang];
---
<footer><div class="container footer-grid"><div class="intro"><Logo inverse={true}/><p>{lang==='id'?'Bekerja bersama masyarakat untuk bentang alam yang pulih, tangguh, dan berkeadilan.':'Working with communities for landscapes that are restored, resilient, and just.'}</p></div><div><h2>{lang==='id'?'Jelajahi':'Explore'}</h2><a href={r.about}>{lang==='id'?'Tentang kami':'About'}</a><a href={r.programs}>{lang==='id'?'Program':'Programs'}</a><a href={r.publications}>{lang==='id'?'Publikasi':'Publications'}</a><a href="https://webgisyg.id/">WebGIS ↗</a></div><div><h2>{lang==='id'?'Kontak':'Contact'}</h2><p><span class="placeholder">{lang==='id'?'Data sementara':'Temporary data'}</span><br/>{lang==='id'?'Alamat kantor akan diverifikasi sebelum peluncuran.':'Office address will be verified before launch.'}</p><a href={r.contact}>{lang==='id'?'Hubungi tim':'Contact the team'}</a></div><div><h2>{lang==='id'?'Organisasi':'Organisation'}</h2><a href={r.about+'#legalitas'}>{lang==='id'?'Legalitas':'Legal status'}</a><a href={`/${lang}/privacy/`}>{lang==='id'?'Kebijakan privasi':'Privacy policy'}</a><span class="socials">Instagram · LinkedIn · YouTube</span></div></div><div class="container bottom"><span>© {new Date().getFullYear()} Yayasan Gambut</span><span>yayasangambut.org · staging</span></div></footer>
<style>footer{padding:4.5rem 0 1.5rem;background:var(--forest-950);color:white}.footer-grid{display:grid;gap:2.5rem}.footer-grid>div:not(.intro){display:grid;align-content:start;gap:.5rem}.intro p{max-width:22rem;color:rgba(255,255,255,.72)}h2{margin-bottom:.6rem;font:800 .72rem/1 var(--sans);letter-spacing:.15em;text-transform:uppercase;color:var(--coast-300)}a{width:fit-content;color:white;text-decoration-color:rgba(255,255,255,.35)}.footer-grid p,.socials{color:rgba(255,255,255,.7);font-size:.9rem}.placeholder{color:#f1bf75;font-weight:800;text-transform:uppercase;font-size:.68rem;letter-spacing:.1em}.bottom{display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem;margin-top:4rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.16);color:rgba(255,255,255,.55);font-size:.78rem}@media(min-width:760px){.footer-grid{grid-template-columns:2fr 1fr 1.3fr 1fr}}</style>
