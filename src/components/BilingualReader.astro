---
interface Props { language: 'id'|'en'; alternatePath: string; }
const {language,alternatePath}=Astro.props;
const target=language==='id'?'en':'id';
---
<section class="bilingual-reader" data-bilingual-reader data-language={language} data-target={target}>
  <aside class="reader-guide" aria-label={language==='id'?'Baca dalam dua bahasa':'Read in two languages'}>
    <span><strong>{language==='id'?'Baca dalam dua bahasa':'Read in two languages'}</strong><br />{language==='id'?'Blok teks atau tekan EN di samping paragraf untuk membandingkan bahasa.':'Select text or tap ID beside a paragraph to compare languages.'}</span>
    <a href={alternatePath}>{language==='id'?'Artikel English ↗':'Artikel Indonesia ↗'}</a>
  </aside>
  <div data-reader-content><slot /></div>
  <template data-reader-alternate><slot name="alternate" /></template>
  <button type="button" class="reader-selection" data-reader-selection hidden aria-haspopup="dialog">{language==='id'?'Lihat bahasa Inggris':'Lihat bahasa Indonesia'}</button>
  <dialog class="reader-dialog" data-reader-dialog aria-labelledby="reader-dialog-title">
    <header><div><p>{language==='id'?'BACA & BANDINGKAN':'READ & COMPARE'}</p><h2 id="reader-dialog-title">{language==='id'?'Indonesia · English':'English · Indonesia'}</h2></div><button type="button" data-reader-close aria-label={language==='id'?'Tutup perbandingan':'Close comparison'}>×</button></header>
    <div class="reader-columns">
      <section aria-label={language==='id'?'Teks bahasa Indonesia':'English text'}><h3>{language==='id'?'Bahasa Indonesia':'English'}</h3><div data-reader-source lang={language}></div></section>
      <section aria-label={target==='id'?'Teks bahasa Indonesia':'English text'}><h3>{target==='id'?'Bahasa Indonesia':'English'}</h3><div data-reader-target lang={target}></div></section>
    </div>
    <footer>{language==='id'?'Padanan dari versi artikel yang telah diterbitkan.':'Text from the published language editions.'} <a href={alternatePath}>{language==='id'?'Buka artikel English ↗':'Buka artikel Indonesia ↗'}</a></footer>
  </dialog>
</section>
<script>
  import '../scripts/bilingual-reader.js';
</script>
<style is:global>
  .bilingual-reader .reader-guide{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;margin:0 0 2rem;padding:1rem 1.25rem;background:#e8f0ed;border:1px solid #c7d9d2;border-radius:.8rem;font-size:.88rem;color:#254d43;line-height:1.6}
  .bilingual-reader .reader-guide a{flex-shrink:0;font-weight:700;font-size:.78rem}
  .bilingual-reader .reader-block{position:relative;padding-right:2.8rem}
  .bilingual-reader .reader-paragraph{position:absolute;right:0;top:.12rem;padding:.28rem .4rem;border:1px solid #b8d0c7;border-radius:.45rem;background:#f0f6f3;color:#135347;font:700 .7rem/1.3 system-ui;cursor:pointer;opacity:.35;transition:opacity .15s}
  .bilingual-reader .reader-block:hover>.reader-paragraph,.bilingual-reader .reader-paragraph:focus-visible{opacity:1}
  .bilingual-reader .reader-paragraph:focus-visible,.bilingual-reader .reader-selection:focus-visible{outline:3px solid #148292;outline-offset:3px}
  .bilingual-reader .reader-selection{position:fixed;z-index:100;padding:.65rem 1rem;border:0;border-radius:.6rem;background:#075243;color:white;font:700 .85rem/1.4 system-ui;box-shadow:0 5px 20px #0b302b35;cursor:pointer;max-width:calc(100vw - 24px)}
  .bilingual-reader .reader-selection[hidden]{display:none}
  .bilingual-reader .reader-dialog{width:min(920px,calc(100vw - 2rem));max-height:calc(100dvh - 2rem);padding:0;border:1px solid #bad1c8;border-radius:1rem;background:#fafbf7;color:#183d33;box-shadow:0 20px 70px #092b2755;overflow:auto}
  .bilingual-reader .reader-dialog::backdrop{background:#0a292866;backdrop-filter:blur(3px)}
  .bilingual-reader .reader-dialog>header{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.3rem 1.5rem;border-bottom:1px solid #d4e1db;background:#eaf2ee}
  .bilingual-reader .reader-dialog>header p{font-size:.68rem!important;color:#477568!important;letter-spacing:.12em;margin:0 0 .35rem;font-weight:800}
  .bilingual-reader .reader-dialog>header h2{font-size:1.3rem!important;margin:0!important}
  .bilingual-reader [data-reader-close]{width:2.5rem;height:2.5rem;border:1px solid #b8cfc4;border-radius:50%;background:white;color:#214d40;font-size:1.5rem;cursor:pointer}
  .bilingual-reader .reader-columns{display:grid;grid-template-columns:1fr 1fr;gap:0;padding:1.5rem}
  .bilingual-reader .reader-columns>section{min-width:0;padding:0 1.25rem 0 0}
  .bilingual-reader .reader-columns>section+section{border-left:1px solid #d2e0d9;padding:0 0 0 1.25rem}
  .bilingual-reader .reader-columns h3{font:800 .8rem/1.4 system-ui!important;text-transform:uppercase;letter-spacing:.04em;margin:0 0 1rem!important;color:#176d5d}
  .bilingual-reader .reader-columns p{font-size:1rem!important;line-height:1.85;white-space:pre-wrap;color:#314f45!important;margin:0 0 1rem}
  .bilingual-reader .reader-dialog>footer{padding:1rem 1.5rem;border-top:1px solid #d4e1db;font-size:.75rem;color:#537469;line-height:1.7}
  .bilingual-reader .reader-dialog>footer a{display:inline-block;margin-left:.5rem;font-weight:700}
  @media(hover:none){.bilingual-reader .reader-paragraph{opacity:1}}
  @media(max-width:600px){.bilingual-reader .reader-guide{align-items:flex-start;flex-direction:column;gap:.5rem;padding:1rem}.bilingual-reader .reader-columns{grid-template-columns:1fr;padding:1.25rem}.bilingual-reader .reader-columns>section{padding:0}.bilingual-reader .reader-columns>section+section{border-left:0;border-top:1px solid #d2e0d9;padding:1.25rem 0 0;margin-top:.5rem}.bilingual-reader .reader-dialog>header{padding:1.1rem 1.25rem}}
</style>
