---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, impact, routeMap, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang }; const c=copy[lang]; const r=routeMap[lang];
const programs=(await getCollection('programs',({data})=>data.language===lang&&data.status==='published')).sort((a,b)=>a.data.order-b.data.order);
const stories=(await getCollection('articles',({data})=>data.language===lang&&data.status==='published')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
const publications=(await getCollection('publications',({data})=>data.language===lang&&data.status==='published')).sort((a,b)=>b.data.year-a.data.year).slice(0,2);
const heroImage='https://singapore.aramco.com/-/jssmedia/news/2023/aas-csr-indonesia-community.jpg?cx=0.5&cy=0.5';
const fieldImage='https://cdn.unenvironment.org/s3fs-public/inline-images/47057912054_4f93355c39_k.jpeg';
---
<BaseLayout title={lang==='id'?'Yayasan Gambut — Aksi bentang alam berbasis masyarakat':'Yayasan Gambut — Community-led landscape action'} description={c.heroText}>
  <section class="hero">
    <div class="container hero-copy"><p class="eyebrow">{c.heroKicker}</p><h1>{c.heroTitle}</h1><p class="hero-text">{c.heroText}</p><div class="hero-actions"><a class="button primary" href={r.programs}>{c.seePrograms}</a><a class="button secondary" href="https://webgisyg.id/" target="_blank" rel="noreferrer">{c.exploreWebgis} ↗</a></div></div>
    <figure class="hero-figure"><img src={heroImage} width="1600" height="900" alt={lang==='id'?'Warga dan mitra menanam mangrove bersama di Riau':'Community members and partners planting mangroves together in Riau'} fetchpriority="high"/><figcaption>{lang==='id'?'Aksi konservasi mangrove berbasis masyarakat, Riau. Foto: Aramco Asia Singapore.':'Community-based mangrove conservation, Riau. Photo: Aramco Asia Singapore.'}</figcaption></figure>
  </section>

  <section class="section impact-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.impactEyebrow}</p><h2>{c.impactTitle}</h2></div><span class="notice">{c.temporary}</span></div><div class="impact-grid">{impact.map(item=><article><strong>{item.value}</strong><p>{item[lang]}</p><small>{lang==='id'?'Menunggu verifikasi dan koneksi API/JSON publik':'Awaiting verification and public API/JSON connection'}</small></article>)}</div></div></section>

  <section class="section programs"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.programEyebrow}</p><h2>{c.programTitle}</h2></div><a class="text-link" href={r.programs}>{c.latest}</a></div><div class="program-grid">{programs.map((program,index)=><a class="program-card" href={`/${lang}/${lang==='id'?'program':'programs'}/${program.data.slug}/`}><span>0{index+1}</span><h3>{program.data.title}</h3><p>{program.data.summary}</p><b aria-hidden="true">↗</b></a>)}</div></div></section>

  <section class="section location"><div class="container location-grid"><div><p class="eyebrow">{c.locationEyebrow}</p><h2>{c.locationTitle}</h2><p class="lede">{c.locationText}</p><a class="text-link" href={r.locations}>{c.latest}</a></div><div class="map-visual" role="img" aria-label={lang==='id'?'Visual lokasi kerja awal di Provinsi Riau':'Visual of initial work locations in Riau Province'}><span class="coordinate">0.5071° N · 101.4478° E</span><span class="pin">Riau</span><div class="map-label coast">{lang==='id'?'Pesisir':'Coast'}</div><div class="map-label peat">{lang==='id'?'Gambut':'Peatland'}</div><div class="map-label forest">{lang==='id'?'Hutan':'Forest'}</div><a href="https://webgisyg.id/">WebGIS ↗</a></div></div></section>

  <section class="field-band"><img src={fieldImage} width="2048" height="1365" loading="lazy" alt={lang==='id'?'Perempuan menanam bibit untuk pemulihan lahan gambut di Riau':'Women planting seedlings for peatland restoration in Riau'}/><div><p class="eyebrow">{lang==='id'?'Bekerja dari pengetahuan tapak':'Grounded in field knowledge'}</p><blockquote>{lang==='id'?'“Data membantu kita melihat perubahan. Masyarakat membuat perubahan itu mungkin.”':'“Data helps us see change. Communities make that change possible.”'}</blockquote><small>{lang==='id'?'Foto kegiatan pemulihan gambut di Riau: UNEP':'Peatland restoration activity in Riau. Photo: UNEP'}</small></div></section>

  <section class="section stories"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.storyEyebrow}</p><h2>{c.storyTitle}</h2></div><a class="text-link" href={r.stories}>{c.latest}</a></div><div class="story-grid">{stories.map(story=><article><img src={story.data.featuredImage} width="900" height="600" loading="lazy" alt={story.data.imageAlt}/><div><p class="meta">{story.data.category} · {story.data.date.toLocaleDateString(lang==='id'?'id-ID':'en-GB',{year:'numeric',month:'long',day:'numeric'})}</p><h3>{story.data.title}</h3><p>{story.data.summary}</p><a class="text-link" href={`/${lang}/${lang==='id'?'cerita':'field-stories'}/${story.data.slug}/`}>{c.read}</a></div></article>)}</div></div></section>

  <section class="section publication-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.publicationEyebrow}</p><h2>{c.publicationTitle}</h2></div><a class="text-link" href={r.publications}>{c.latest}</a></div><div class="publication-grid">{publications.map(pub=><article><span>{pub.data.year}</span><div><p class="meta">{pub.data.category}</p><h3>{pub.data.title}</h3><p>{pub.data.summary}</p></div><a class="text-link" href={`/${lang}/${lang==='id'?'publikasi':'publications'}/${pub.data.slug}/`}>{c.view}</a></article>)}</div></div></section>

  <section class="data-band"><div class="container"><div><p class="eyebrow">Data &amp; WebGIS</p><h2>{c.dataTitle}</h2></div><div><p>{c.dataText}</p><a class="button light" href="https://webgisyg.id/" target="_blank" rel="noreferrer">{c.exploreWebgis} ↗</a></div></div></section>
  <section class="section partners"><div class="container"><p class="eyebrow">{lang==='id'?'Mitra':'Partners'}</p><h2>{c.partners}</h2><p class="lede">{c.partnersText}</p><div class="partner-row"><span>{lang==='id'?'Komunitas lokal':'Local communities'}</span><span>{lang==='id'?'Pemerintah':'Government'}</span><span>{lang==='id'?'Akademisi':'Academia'}</span><span>{lang==='id'?'Mitra pembangunan':'Development partners'}</span></div></div></section>
</BaseLayout>

<style>
  .hero{padding:clamp(3rem,7vw,7rem) 0 0;overflow:hidden;background:linear-gradient(125deg,var(--paper) 68%,rgba(145,196,205,.28))}.hero-copy{position:relative;z-index:2}.hero h1{max-width:14ch;margin-bottom:1.4rem}.hero-text{max-width:43rem;font-size:clamp(1.08rem,2vw,1.35rem);color:var(--muted)}.hero-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin:2rem 0 3.5rem}.hero-figure{position:relative;margin:0 auto;width:min(calc(100% - 2rem),86rem);height:clamp(20rem,47vw,43rem);overflow:hidden;border-radius:var(--radius-lg) var(--radius-lg) 0 0;background:var(--forest-800)}.hero-figure img{height:100%;object-fit:cover}.hero-figure figcaption{position:absolute;right:1rem;bottom:1rem;max-width:25rem;padding:.55rem .75rem;background:rgba(10,44,39,.82);color:white;font-size:.7rem;border-radius:.3rem}.impact-section{background:var(--paper-bright)}.impact-grid{display:grid;border-top:1px solid var(--line)}.impact-grid article{padding:1.6rem 0;border-bottom:1px solid var(--line)}.impact-grid strong{font:500 4rem/1 var(--serif)}.impact-grid p{margin:.5rem 0}.impact-grid small{color:var(--muted)}.program-grid{display:grid;gap:.75rem}.program-card{position:relative;min-height:18rem;padding:1.4rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright);text-decoration:none;transition:transform .2s,background .2s}.program-card:hover{transform:translateY(-4px);background:#fff}.program-card span{font-weight:800;color:var(--coast-700)}.program-card h3{margin:4rem 0 .7rem;font:500 1.65rem/1.05 var(--serif)}.program-card p{color:var(--muted)}.program-card b{position:absolute;right:1.2rem;top:1.2rem}.location{background:#dce8e6}.location-grid{display:grid;gap:3rem}.map-visual{position:relative;min-height:28rem;overflow:hidden;border-radius:var(--radius-lg);background-color:var(--forest-950);background-image:linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px);background-size:3rem 3rem;color:white}.coordinate{position:absolute;top:1rem;left:1rem;font-size:.72rem;letter-spacing:.1em}.pin{position:absolute;left:47%;top:45%;display:grid;place-items:center;width:5.5rem;height:5.5rem;border:1px solid var(--coast-300);border-radius:50%;background:var(--coast-700);font-weight:800;box-shadow:0 0 0 1rem rgba(145,196,205,.13)}.map-label{position:absolute;padding:.45rem .7rem;border:1px solid rgba(255,255,255,.28);border-radius:999px;font-size:.75rem}.coast{right:12%;top:20%}.peat{left:15%;bottom:22%}.forest{right:16%;bottom:12%}.map-visual>a{position:absolute;right:1rem;bottom:1rem;font-weight:800}.field-band{display:grid;background:var(--peat-700);color:white}.field-band img{height:100%;max-height:43rem;object-fit:cover}.field-band>div{display:grid;align-content:center;padding:clamp(2rem,6vw,6rem)}blockquote{margin:0 0 1.5rem;font:500 clamp(2rem,4vw,4rem)/1.1 var(--serif);letter-spacing:-.03em}.field-band .eyebrow{color:#efd8b7}.field-band small{color:rgba(255,255,255,.68)}.story-grid{display:grid;gap:1rem}.story-grid article{overflow:hidden;border-radius:var(--radius-md);background:var(--paper-bright);box-shadow:0 1px 0 var(--line)}.story-grid img{aspect-ratio:3/2;object-fit:cover}.story-grid article>div{padding:1.4rem}.story-grid h3{font:500 1.8rem/1.1 var(--serif)}.meta{font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--coast-700)}.publication-section{background:var(--paper-bright)}.publication-grid{display:grid;border-top:1px solid var(--line)}.publication-grid article{display:grid;gap:1rem;padding:1.4rem 0;border-bottom:1px solid var(--line)}.publication-grid>article>span{font:500 2.5rem/1 var(--serif);color:var(--peat-700)}.publication-grid h3{font:500 1.55rem/1.1 var(--serif)}.data-band{padding:clamp(4rem,8vw,8rem) 0;background:var(--coast-700);color:white}.data-band>.container{display:grid;gap:2rem}.data-band .eyebrow{color:#bde0e6}.data-band h2{max-width:12ch}.data-band p{max-width:36rem;font-size:1.1rem}.partner-row{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:2.5rem}.partner-row span{padding:.7rem 1rem;border:1px solid var(--line);border-radius:999px;background:var(--paper-bright);font-weight:750}
  @media(min-width:680px){.impact-grid{grid-template-columns:repeat(2,1fr)}.impact-grid article:nth-child(odd){padding-right:2rem;border-right:1px solid var(--line)}.impact-grid article:nth-child(even){padding-left:2rem}.program-grid{grid-template-columns:repeat(2,1fr)}.story-grid{grid-template-columns:repeat(2,1fr)}.publication-grid article{grid-template-columns:8rem 1fr auto;align-items:start}}
  @media(min-width:980px){.hero-copy{padding-right:20%}.impact-grid{grid-template-columns:repeat(4,1fr)}.impact-grid article{padding:2rem!important;border-right:1px solid var(--line)}.impact-grid article:last-child{border-right:0}.program-grid{grid-template-columns:repeat(5,1fr)}.field-band{grid-template-columns:1.05fr .95fr}.location-grid,.data-band>.container{grid-template-columns:1fr 1fr;align-items:center}}
</style>
