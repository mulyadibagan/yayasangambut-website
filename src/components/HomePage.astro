---
import PartnersSection from './PartnersSection.astro';
import WorkAreaMap from './WorkAreaMap.astro';
import { getCollection } from 'astro:content';
import { programPhotos } from '../data/program-photos';
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, impactSnapshot, pageContent, routeMap, type Lang } from '../data/site';
import { categoryLabel, excerpt } from '../utils/text';
const { lang } = Astro.props as { lang: Lang }; const c=copy[lang]; const r=routeMap[lang];
const [allPrograms,allArticles,allPublications]=await Promise.all([
  getCollection('programs'), getCollection('articles'), getCollection('publications'),
]);
const programs=allPrograms.filter(({data})=>data.language===lang&&data.status==='published'&&data.featured).sort((a,b)=>a.data.order-b.data.order);
const publishedArticles=allArticles.filter(({data})=>data.status==='published');
const nativeStories=publishedArticles.filter(({data})=>data.language===lang);
const stories=nativeStories.sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
const publishedPublications=allPublications.filter(({data})=>data.status==='published');
const nativePublications=publishedPublications.filter(({data})=>data.language===lang).sort((a,b)=>b.data.year-a.data.year);
const publicationPool=nativePublications.length?nativePublications:publishedPublications.filter(({data})=>data.language==='id').sort((a,b)=>b.data.year-a.data.year);
const annualReport=publicationPool.find(({data})=>/laporan tahunan|annual report/i.test(data.category));
const publications=[...(annualReport?[annualReport]:[]),...publicationPool.filter(pub=>pub!==annualReport)].slice(0,2);
const publicationFallback=!nativePublications.length;

const archiveMetrics=impactSnapshot[lang].map((item,index)=>({...item,...(lang==='id'?[
{label:'Data lokasi & kegiatan',note:'Tersaji pada peta program YG.'},
{label:'Laporan lapangan',note:'Dokumentasi kegiatan dan pemantauan.'},
{label:'Flora & fauna terdokumentasi',note:'29 flora dan 11 fauna atau biota mangrove.'}
]:[
{label:'Location & activity records',note:'Mapped across YG programs.'},
{label:'Field reports',note:'Activity and monitoring documentation.'},
{label:'Documented flora & fauna',note:'29 flora and 11 fauna or other mangrove biota.'}
])[index]}));
const heroImage='/images/community-mangrove-main.webp';
const vision=pageContent[lang][lang==='id'?'tentang-kami':'about'].sections[1][1];
---
<BaseLayout title={lang==='id'?'Yayasan Gambut — Konservasi Berbasis Masyarakat':'Yayasan Gambut — Community-led landscape action'} description={c.heroText} schemaType="organization">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Yayasan Gambut</p>
        <h1>{lang==='id'?'Bersama menjaga lahan basah dan':'Together for wetlands and'} <span>{lang==='id'?'kehidupan.':'life.'}</span></h1>
        <p class="hero-text">{lang==='id'?'Kami bekerja bersama masyarakat dan mitra untuk mendukung pengelolaan lahan basah serta ekosistem lainnya secara berkelanjutan.':'Supporting sustainable management of wetlands and other ecosystems through strategic partnerships with communities.'}</p>
        <div class="hero-actions"><a class="button primary" href={lang==='id'?'/id/tentang-kami/':'/en/about/'}>{lang==='id'?'Kenali Yayasan Gambut':'About Yayasan Gambut'}</a><a class="button secondary" href="#wilayah-kerja">{lang==='id'?'Jelajahi wilayah kerja':'Explore Our Work Locations'}</a></div>
      </div>
      <figure class="hero-figure"><img src={heroImage} width="1920" height="1281" alt={lang==='id'?'Masyarakat dan mitra Yayasan Gambut bersama di lokasi pemulihan mangrove':'Community members and Yayasan Gambut partners at a mangrove restoration site'} fetchpriority="high" decoding="async"/><figcaption>{lang==='id'?'Bersama masyarakat dan mitra · Dokumentasi Yayasan Gambut':'Together with communities and partners · Yayasan Gambut documentation'}</figcaption></figure>
    </div>
  </section>

  

  <section class="section programs"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.programEyebrow}</p><h2>{lang==='id'?'Melindungi ekosistem, memperkuat penghidupan.':'Healthy ecosystems. Thriving lives.'}</h2></div><a class="text-link" href={r.programs}>{lang==='id'?'Lihat semua program':c.latest}</a></div><div class="program-grid">{programs.map((program,index)=><a class="program-card" href={`/${lang}/${lang==='id'?'program':'programs'}/${program.data.slug}/`}><div class="program-copy"><h3>{program.data.title}</h3><p>{excerpt(program.data.summary,150)}</p><span class="program-action">{lang==='id'?'Jelajahi program':'Explore program'} <b aria-hidden="true">→</b></span></div></a>)}</div></div></section>

  <section class="section location" id="wilayah-kerja"><div class="container"><WorkAreaMap lang={lang}/><a class="text-link" style="margin-top:1.25rem" href={r.locations}>{lang==='id'?'Lihat wilayah kerja':'Discover our work locations'}</a></div></section>

  <section class="section stories"><div class="container"><div class="section-heading"><div><p class="eyebrow">{lang==='id'?'Cerita lapangan':c.storyEyebrow}</p><h2>{lang==='id'?'Kegiatan dan pembelajaran dari lapangan':'Stories from the field.'}</h2></div><a class="text-link" href={r.stories}>{lang==='id'?'Lihat semua cerita':c.latest}</a></div><div class="story-grid">{stories.map(story=><article>{story.data.featuredImage&&<img src={story.data.featuredImage} width="900" height="600" loading="lazy" alt={story.data.imageAlt||story.data.title}/>}<div><p class="meta">{lang==='en'&&<>{categoryLabel(story.data.category,lang)} · </>}<time datetime={story.data.date.toISOString()}>{story.data.date.toLocaleDateString(lang==='id'?'id-ID':'en-GB',{year:'numeric',month:'long',day:'numeric'})}</time></p><h3>{story.data.title}</h3><p>{excerpt(story.data.summary,170)}</p><a class="text-link" href={`/${lang}/${lang==='id'?'cerita':'field-stories'}/${story.data.slug}/`}>{c.read}</a></div></article>)}</div></div></section>

  <section class="section publication-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{lang==='id'?'Publikasi':c.publicationEyebrow}</p><h2>{lang==='id'?'Laporan dan pengetahuan untuk dibagikan':c.publicationTitle}</h2>{publicationFallback&&<p class="archive-language">{lang==='en'?'Documents are available in their original Indonesian editions.':''}</p>}</div><a class="text-link" href={r.publications}>{lang==='id'?'Lihat semua publikasi':c.latest}</a></div><div class="publication-grid">{publications.map(pub=><article>{pub.data.cover&&<img class="publication-cover" src={pub.data.cover} alt="" width="360" height="480" loading="lazy"/>}<div class="publication-copy"><p class="meta">{pub===annualReport?(lang==='id'?'Laporan tahunan terbaru':'Latest annual report'):(lang==='id'?'Publikasi pilihan':'Featured publication')} · {pub.data.year}</p><h3 lang={pub.data.language}>{pub.data.title}</h3><p lang={pub.data.language}>{excerpt(pub.data.summary,180)}</p><span class="document-language">PDF · {(pub.data.documentLanguage||pub.data.language)==='id'?'Bahasa Indonesia':'English'}</span><a class="text-link external" href={pub.data.fileUrl} target="_blank" rel="noreferrer">{lang==='id'?'Buka PDF':'Open PDF'}<span class="sr-only"> — {pub.data.title}</span></a></div></article>)}</div></div></section>

<section class="section recognition" id="pengakuan"><div class="container"><p class="eyebrow">{lang==='id'?'Pengakuan internasional':'International recognition'}</p><h2>RestorLife Awards</h2><div class="recognition-feature"><figure class="recognition-photo"><a href="https://about.restor.eco/blog/meet-the-10-finalists-of-the-restorlife-awards-2026" target="_blank" rel="noreferrer"><img src="https://framerusercontent.com/images/Xw4yCwBAraWCEt1aEHbTLYLEY.png?scale-down-to=1024" width="1024" height="576" loading="lazy" decoding="async" alt={lang==='id'?'Poster resmi RestorLife Awards 2026: 10 finalis kategori NGO':'Official RestorLife Awards 2026 poster: 10 NGO finalists'}/></a><figcaption>{lang==='id'?'Finalis RestorLife Awards 2026 · Sumber: Restor':'Official 2026 NGO finalists artwork · Source: Restor'}</figcaption></figure><div class="recognition-grid"><article><span class="award-year">2026</span><h3>{lang==='id'?'Salah satu dari 10 finalis':'One of 10 finalists'}</h3><p>{lang==='id'?'Yayasan Gambut terpilih sebagai salah satu dari 10 finalis RestorLife Awards 2026. Restor menyoroti kerja bersama masyarakat dalam pemulihan gambut dan mangrove, pengurangan risiko kebakaran, serta penguatan penghidupan.':'Yayasan Gambut is among the 10 finalists of the RestorLife Awards 2026. Restor highlights our work with communities to restore peatlands and mangroves, reduce fire risk, and support sustainable livelihoods.'}</p><a class="text-link external" href="https://about.restor.eco/blog/meet-the-10-finalists-of-the-restorlife-awards-2026" target="_blank" rel="noreferrer">{lang==='id'?'Pengumuman Restor · 17 Juni 2026':'Restor announcement · 17 June 2026'}</a></article><article><span class="award-year">2025</span><h3>{lang==='id'?'Finalis kategori organisasi nirlaba':'NGO Award finalist'}</h3><p>{lang==='id'?'Yayasan Gambut menjadi salah satu dari 16 finalis kategori organisasi nirlaba (NGO) pada RestorLife Awards 2025.':'In 2025, Yayasan Gambut was also named among the 16 NGO Award finalists in the RestorLife Awards.'}</p><a class="text-link external" href="https://about.restor.eco/blog/meet-restorlife-awards-2025-finalists" target="_blank" rel="noreferrer">{lang==='id'?'Pengumuman Restor · 11 April 2025':'Restor announcement · 11 April 2025'}</a></article></div></div></div></section>
  <PartnersSection lang={lang}/>
</BaseLayout>

<style>
.hero{padding:3rem 0 3.5rem;background:radial-gradient(ellipse at 85% 15%,#dceade 0,transparent 55%),var(--paper)}
.hero-grid{display:grid;gap:2.5rem;align-items:center}.hero h1{max-width:16ch;font-size:clamp(2.5rem,4.6vw,4.2rem);line-height:1.04;margin-bottom:1.25rem}.hero-text{max-width:36rem;color:var(--muted);font-size:1.05rem}.hero-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.5rem}.hero-proof{display:flex;gap:2rem;margin-top:1.7rem;padding-top:1.1rem;border-top:1px solid var(--line)}.hero-proof span{display:grid;gap:.3rem;color:var(--muted);font-size:.8rem}.hero-proof b{color:var(--ink);font-size:1.1rem}
.hero-visual{position:relative;padding:0 0 3rem 1.5rem}.hero-figure{margin:0;height:26rem;overflow:hidden;border-radius:4rem 1.4rem 4rem 1.4rem;background:var(--forest-800)}.hero-figure img{height:100%;object-fit:cover}.hero-figure figcaption{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.community-photo{position:absolute;bottom:0;left:0;width:56%;margin:0;padding:.4rem;background:white;border-radius:1.2rem;box-shadow:0 12px 35px #102e2820;transform:rotate(-3deg)}.community-photo img{aspect-ratio:3/2;object-fit:cover;border-radius:.9rem}.community-photo figcaption{padding:.6rem .4rem .35rem;font-size:.78rem;font-weight:700}
.impact-section{background:white}.archive-heading-actions{display:grid;gap:.5rem}.impact-grid{display:grid;gap:1rem}.impact-grid>a{position:relative;display:flex;gap:1rem;align-items:center;padding:1.3rem 1rem;border-top:2px solid #b6ccb8;text-decoration:none}.impact-grid strong{font-size:2.6rem;line-height:1;color:var(--forest-800);letter-spacing:-.05em}.impact-grid p{margin:0 0 .3rem;font-weight:750}.impact-grid small{display:block;color:var(--muted);font-size:.8rem;line-height:1.4}.impact-grid b{position:absolute;right:0;top:.3rem;color:var(--coast-700)}
.program-grid{display:grid;gap:1.2rem}.program-card{position:relative;overflow:hidden;border-radius:1.2rem;background:white;text-decoration:none;transition:transform .2s,box-shadow .2s}.program-card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}.program-card>img{height:11rem;object-fit:cover}.program-copy{position:relative;padding:1.2rem}.program-copy>span{font-size:.8rem;color:var(--forest-650);font-weight:800}.program-card h3{margin:.6rem 0;font-size:1.25rem;line-height:1.2}.program-card p{margin:0;font-size:.9rem;color:var(--muted)}
.location{background:#e7eee4}.location-grid{display:grid;gap:2.5rem;align-items:center}.landscape-photo{position:relative;margin:0}.landscape-photo img{height:22rem;object-fit:cover;border-radius:1.2rem 3rem 1.2rem 3rem}.landscape-photo figcaption{position:absolute;bottom:1rem;left:1rem;padding:.5rem .8rem;border-radius:2rem;background:#ffffffed;font-size:.8rem}.location h2{max-width:20ch}.gallery-link{display:block;width:fit-content;margin-top:1.2rem;font-size:.9rem;color:var(--forest-800)}
.story-grid{display:grid;gap:1.5rem}.story-grid article{overflow:hidden;background:white;border-radius:1rem}.story-grid img{aspect-ratio:3/2;object-fit:cover}.story-grid article>div{padding:1.25rem}.story-grid h3{font-size:1.2rem;line-height:1.3}.story-grid article>div>p:not(.meta){color:var(--muted);font-size:.9rem}.meta{font-size:.78rem;font-weight:700;color:var(--forest-650)}
.publication-section{background:white}.publication-grid article{display:grid;gap:1rem;padding:1.4rem 0;border-top:1px solid var(--line)}.publication-grid>article>span{font-size:1.5rem;color:var(--peat-700)}.publication-grid h3{font-size:1.2rem;line-height:1.3;margin-bottom:.5rem}.publication-grid p{color:var(--muted);margin:.4rem 0}.archive-language{color:var(--muted)}
.data-band{padding:3rem 0;background:var(--forest-950);color:white}.data-band>.container{display:grid;gap:1.5rem}.data-band .eyebrow{color:#bbd5ba}.data-band h2{max-width:20ch;margin:0}.data-band p{margin-top:0;color:#dae7dc}.partner-row{display:flex;flex-wrap:wrap;gap:.6rem;margin:1.2rem 0}.partner-row span{font-size:.85rem;padding:.45rem .8rem;border-radius:2rem;background:#e7eee4}.partner-montage{max-width:55rem;max-height:24rem;object-fit:contain;margin:1.5rem auto 2rem;border-radius:1rem;background:white}.award{padding:1.5rem 0;border-top:1px solid var(--line)}.award h3{font-size:1.3rem;margin-bottom:.6rem}.award p:not(.eyebrow){max-width:55rem;color:var(--muted)}.collaboration-callout{display:grid;gap:1.5rem;align-items:center;padding:2rem;background:#e3ecdf;border-radius:1.5rem}.collaboration-callout h3{max-width:30ch;font-size:1.7rem;line-height:1.15;margin-bottom:.7rem}.collaboration-callout p:not(.eyebrow){max-width:46rem;color:var(--muted)}.collaboration-callout .button{width:fit-content}
@media(min-width:680px){.impact-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.impact-grid>a{display:block}.impact-grid strong{display:block;margin-bottom:.7rem}.program-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.story-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.collaboration-callout{grid-template-columns:1fr auto}}
@media(min-width:980px){.hero-grid{grid-template-columns:1fr 1fr;gap:3rem}.location-grid{grid-template-columns:1.05fr 1fr;gap:4rem}.data-band>.container{grid-template-columns:1fr 1fr;align-items:center}.program-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:679px){.hero{padding:2rem 0}.hero-proof{gap:1rem}.hero-figure{height:19rem}.hero-visual{padding-left:1rem;padding-bottom:2rem}.community-photo{width:52%}.community-photo figcaption{font-size:.7rem}.section-heading h2{max-width:none}.collaboration-callout{padding:1.4rem}.landscape-photo img{height:17rem}}
.gec-partner{display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem 2rem;margin:1.5rem 0;padding:1.5rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.gec-partner>a{flex:0 0 12rem;padding:.6rem;background:white}.gec-partner img{width:100%;height:auto}.gec-partner>div{flex:1 1 18rem}.gec-partner span{font-size:.8rem;font-weight:700;color:var(--forest-650)}.gec-partner h3{margin:.4rem 0;font-size:1.2rem}.gec-partner p{margin:0;color:var(--muted);font-size:.95rem}

.hero{padding:clamp(2.5rem,5vw,5rem) 0}.hero-grid{gap:3rem}.hero-visual{padding:0 0 2rem 2rem}.hero-figure{height:31rem;border-radius:1.5rem}.community-photo{width:46%;transform:none;border-radius:.9rem}.hero-proof{gap:1.5rem}.hero-text{max-width:32rem;line-height:1.75}.hero-actions .button{padding:.8rem 1.2rem}
.metric-context{max-width:39rem;color:var(--muted);font-size:.95rem;margin-bottom:0}.impact-grid{margin-top:1.8rem}.impact-grid>a{background:var(--paper);border-radius:.8rem;padding:1.5rem}.impact-grid b{right:.8rem;top:.6rem}
.program-card{display:flex;flex-direction:column;border:1px solid var(--line)}.program-card>img{height:13rem}.program-copy{display:flex;flex:1;flex-direction:column;padding:1.4rem}.program-copy>span:not(.program-action){font-size:.75rem}.program-card h3{line-height:1.3}.program-card p{line-height:1.65;margin-bottom:1.5rem}.program-action{display:flex;justify-content:space-between;gap:1rem;margin-top:auto;font-size:.85rem;font-weight:750;color:var(--forest-800)}
.publication-grid{display:grid;gap:1.25rem;margin-top:1.5rem}.publication-grid article{grid-template-columns:7rem minmax(0,1fr);gap:1.5rem;padding:1.5rem;border:1px solid var(--line);border-radius:1rem;background:var(--paper);align-items:start}.publication-cover{height:10rem;object-fit:contain;object-position:top}.publication-copy{min-width:0}.publication-grid h3{margin-top:.7rem}.publication-grid p{font-size:.9rem}.document-language{display:block;font-size:.75rem;color:var(--muted);margin-top:1rem}.publication-copy .text-link{margin-top:.3rem}.partner-montage{max-width:46rem;max-height:19rem;padding:1rem}.gec-partner{gap:1rem 2rem}.gec-partner>a{flex-basis:10rem}
@media(min-width:980px){.hero-grid{grid-template-columns:.95fr 1.05fr}.publication-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:679px){.hero{padding:2rem 0 2.5rem}.hero-grid{gap:2rem}.hero h1{font-size:clamp(2.4rem,10vw,3.5rem)}.hero-visual{padding:0;display:grid;gap:.8rem}.hero-figure{height:21rem}.community-photo{position:static;width:100%;display:flex;align-items:center;gap:1rem;padding:.5rem;box-shadow:none;border:1px solid var(--line)}.community-photo img{width:35%;aspect-ratio:3/2}.community-photo figcaption{font-size:.8rem;padding:.4rem}.hero-proof{gap:.8rem;justify-content:space-between}.hero-proof span{font-size:.72rem}.hero-actions{display:grid;grid-template-columns:1fr}.publication-grid article{grid-template-columns:5rem minmax(0,1fr);gap:1rem;padding:1rem}.publication-cover{height:7rem}.partner-montage{padding:.5rem}.story-grid{gap:1.25rem}}
/* One full-width documentary photograph; keep faces clear of text. */
.hero{padding:0;background:#fff}
.hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,1fr);gap:0;max-width:none;width:100%;padding:0}
.hero-copy{position:relative;z-index:1;padding:2rem max(1.25rem,calc((100vw - 1200px)/2));background:#fff}
.hero h1{font-size:clamp(2.25rem,4vw,3.5rem);max-width:22ch;margin:0 0 1rem;line-height:1.08}
.hero-text{max-width:36rem;font-size:1rem;line-height:1.65;margin-bottom:0}
.hero-actions{margin-top:1.1rem}
.hero-figure{height:auto;margin:0;border-radius:0;background:#edf2ec;overflow:hidden}
.hero-figure img{display:block;width:100%;height:auto;object-fit:contain}
@media(min-width:1100px){
.hero-copy{position:relative;padding-top:2rem;padding-bottom:2rem;background:#fff;display:grid;grid-template-columns:1.1fr 1fr;column-gap:3rem;align-items:start}
.hero-copy .eyebrow{grid-column:1/-1;margin-bottom:.7rem}
.hero h1{grid-column:1;grid-row:2/4}
.hero-text{grid-column:2;grid-row:2}
