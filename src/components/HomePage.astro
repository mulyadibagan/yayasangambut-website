/* The original community photograph blends into the hero without cropping. */
.hero{background:#edf3ed;overflow:hidden}
.hero-grid{grid-template-columns:1fr 1.12fr;gap:1.8rem}
.hero-figure{height:auto;overflow:visible;border-radius:0;background:transparent;isolation:isolate}
.hero-figure img{display:block;height:auto;width:100%;max-height:none;object-fit:contain;border-radius:0;mask-image:linear-gradient(to right,transparent 0%,#000 5%,#000 95%,transparent 100%);-webkit-mask-image:linear-gradient(to right,transparent 0%,#000 5%,#000 95%,transparent 100%)}
.hero-figure::after{content:"";position:absolute;inset:0 0 1.8rem;pointer-events:none;background:linear-gradient(to bottom,#edf3ed 0%,transparent 10%,transparent 94%,#edf3ed 100%)}
.hero-figure figcaption{position:static;width:auto;height:auto;clip-path:none;padding:.5rem 1rem 0;background:transparent;color:var(--muted);font-size:.72rem;text-align:center}
@media(max-width:850px){.hero-grid{grid-template-columns:1fr;gap:1.25rem}.hero-figure{height:auto;width:min(100%,560px);margin-inline:auto}.hero-figure img{height:auto;object-fit:contain}.hero-figure::after{background:linear-gradient(to bottom,#edf3ed 0%,transparent 8%,transparent 95%,#edf3ed 100%)}}

/* Approved editorial mockup: compact copy, original community photo, five columns. */
.hero{position:relative;background:#0c2b22;color:#fff;padding:0;overflow:hidden}
.hero-grid{position:relative;width:100%;max-width:none;min-height:510px;display:block;padding:0;margin:0}
.hero-copy{position:relative;z-index:2;width:43%;padding:3.2rem 1.4rem 3.2rem max(1.5rem,calc((100vw - 1280px)/2));background:transparent}
.hero-copy .eyebrow{color:#e0ece2;letter-spacing:.2em;font-size:.73rem;margin-bottom:1.4rem}
.hero h1{font-size:clamp(2.4rem,3.6vw,3.65rem);line-height:1.07;letter-spacing:-.04em;max-width:13ch;margin:0 0 1.4rem;color:#fff}
.hero h1 span{color:#d3f88b}.hero-text{color:#f1f5f1;font-size:1rem;line-height:1.65;max-width:30rem}
.hero-actions{display:flex;flex-wrap:wrap;gap:.7rem 1.2rem;margin-top:1.5rem}.hero-actions .primary{background:#d3f88b;color:#102d21;border-color:#d3f88b;border-radius:.45rem}.hero-actions .secondary{background:transparent;color:white;border:0;border-radius:0;padding-inline:0;text-decoration:underline;text-underline-offset:.35rem}
.hero-figure{position:absolute;inset:0 0 0 auto;width:60%;height:100%;margin:0;background:#0c2b22;border-radius:0;overflow:hidden}
.hero-figure img{width:100%;height:100%;object-fit:contain;object-position:right center;border-radius:0;mask-image:none;-webkit-mask-image:none}
.hero-figure::after{position:absolute;inset:0;content:"";background:linear-gradient(90deg,#0c2b22 0%,rgba(12,43,34,.8) 4%,transparent 18%);pointer-events:none}
.hero-figure figcaption{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%)}
.programs{background:white;padding:2.8rem 0}.programs .section-heading{margin-bottom:1.6rem}.programs h2{font-size:clamp(1.7rem,2.5vw,2.3rem);max-width:none}.program-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:0}.program-card{display:block;background:transparent;border:0;border-right:1px solid var(--line);border-radius:0;box-shadow:none;padding:0 1.3rem}.program-card:first-child{padding-left:0}.program-card:last-child{border:0;padding-right:0}.program-card:hover{transform:none;box-shadow:none;background:#f7faf4}.program-copy{padding:0}.program-card h3{font-size:1.08rem;margin:0 0 .7rem}.program-card p{font-size:.87rem;line-height:1.6;margin-bottom:.8rem}.program-action{font-size:.78rem}.location{background:#f2f4ee}
@media(min-width:1600px){.hero-grid{min-height:560px}}
@media(max-width:1000px){.hero-copy{width:46%;padding-left:1.5rem}.hero h1{font-size:2.5rem}.hero-figure{width:56%}.program-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.program-card{padding:0;border:0}}
@media(max-width:700px){.hero-grid{min-height:0;display:flex;flex-direction:column}.hero-copy{width:100%;padding:2rem 1.25rem 1.5rem}.hero h1{font-size:2.65rem;max-width:16ch}.hero-text{font-size:.95rem}.hero-figure{position:relative;inset:auto;width:100%;height:auto;max-width:none}.hero-figure img{height:auto;width:100%;object-fit:contain}.hero-figure::after{background:linear-gradient(180deg,#0c2b22 0%,transparent 12%)}.program-grid{grid-template-columns:1fr;gap:0}.program-card,.program-card:first-child,.program-card:last-child{padding:1rem 0;border:0;border-bottom:1px solid var(--line)}.programs{padding:2rem 0}}

/* A continuous landscape hero with a soft diagonal blend and curved lower edge. */
.hero{isolation:isolate;padding-bottom:2rem}
.hero::after{content:"";position:absolute;z-index:3;pointer-events:none;left:-5%;bottom:-3rem;width:110%;height:5rem;background:#fff;border-radius:50% 50% 0 0;transform:rotate(-1.5deg)}
.hero-grid{min-height:560px}
.hero-copy{width:46%;padding-top:3.6rem;padding-bottom:4rem}
.hero-figure{inset:0;width:100%;height:100%;background:#0c2b22}
.hero-figure img{width:78%;margin-left:auto;height:100%;object-fit:cover;object-position:62% 48%;mask-image:linear-gradient(108deg,transparent 0%,rgba(0,0,0,.12) 12%,rgba(0,0,0,.7) 31%,#000 48%);-webkit-mask-image:linear-gradient(108deg,transparent 0%,rgba(0,0,0,.12) 12%,rgba(0,0,0,.7) 31%,#000 48%)}
.hero-figure::after{background:linear-gradient(90deg,#0c2b22 0%,rgba(12,43,34,.88) 24%,rgba(12,43,34,.3) 47%,transparent 68%),linear-gradient(0deg,rgba(12,43,34,.45),transparent 35%)}
@media(min-width:1600px){.hero-grid{min-height:600px}}
@media(max-width:1000px) and (min-width:701px){.hero-copy{width:50%}.hero-figure img{width:85%;object-position:60% center}}
@media(max-width:700px){
.hero{padding-bottom:1rem}
.hero-grid{min-height:0;display:block}
.hero-copy{width:100%;padding:2rem 1.25rem 0}
.hero-figure{position:relative;inset:auto;width:100%;height:auto;margin-top:-.5rem}
.hero-figure img{width:100%;height:auto;object-fit:contain;mask-image:linear-gradient(180deg,transparent,#000 30%);-webkit-mask-image:linear-gradient(180deg,transparent,#000 30%)}
.hero-figure::after{background:linear-gradient(180deg,#0c2b22 0%,rgba(12,43,34,.35) 15%,transparent 40%)}
.hero::after{height:3rem;bottom:-2rem}
}


/* Quiet brand palette: ivory surfaces, water-blue mapping, peat accents. */
.hero::after,.programs,.stories,.publication-section{background:var(--paper)}
.location,.data-band{background:var(--water-pale)}
.data-band{color:var(--ink)}
.data-band p{color:var(--muted)}
.data-band .eyebrow,.location .eyebrow{color:var(--coast-700)}
.data-band .button.light{background:var(--forest-950);border-color:var(--forest-950);color:#fff}
.data-band :focus-visible{outline-color:var(--coast-700)}
.programs .eyebrow,.stories .eyebrow,.publication-section .eyebrow,.recognition .eyebrow{color:var(--peat-700)}
.recognition{background:#f1f3eb}

