---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, impactSnapshot, routeMap, type Lang } from '../data/site';
import { categoryLabel, excerpt } from '../utils/text';
const { lang } = Astro.props as { lang: Lang }; const c=copy[lang]; const r=routeMap[lang];
const [allPrograms,allArticles,allPublications,allGalleries,allLocations]=await Promise.all([
  getCollection('programs'), getCollection('articles'), getCollection('publications'), getCollection('gallery'), getCollection('locations'),
]);
const programs=allPrograms.filter(({data})=>data.language===lang&&data.status==='published'&&data.featured).sort((a,b)=>a.data.order-b.data.order);
const publishedArticles=allArticles.filter(({data})=>data.status==='published');
const nativeStories=publishedArticles.filter(({data})=>data.language===lang);
const stories=nativeStories.sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
const publishedPublications=allPublications.filter(({data})=>data.status==='published');
const nativePublications=publishedPublications.filter(({data})=>data.language===lang).sort((a,b)=>b.data.year-a.data.year);
const publications=(nativePublications.length?nativePublications:publishedPublications.filter(({data})=>data.language==='id').sort((a,b)=>b.data.year-a.data.year)).slice(0,2);
const publicationFallback=!nativePublications.length;
const publishedGalleries=allGalleries.filter(({data})=>data.status==='published'&&data.language==='id');
const archiveMetrics=impactSnapshot[lang];
const heroImage='https://yayasangambut.org/wp-content/uploads/2026/07/photo_7-1536x1143-1.jpeg';
---
<BaseLayout title={lang==='id'?'Yayasan Gambut — Aksi bentang alam berbasis masyarakat':'Yayasan Gambut — Community-led landscape action'} description={c.heroText} schemaType="organization">
  <section class="hero">
    <div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">{c.heroKicker}</p><h1>{c.heroTitle}</h1><p class="hero-text">{c.heroText}</p><div class="hero-actions"><a class="button primary" href={r.programs}>{c.seePrograms}</a><a class="button secondary" href="https://webgisyg.id/" target="_blank" rel="noreferrer">{c.exploreWebgis} ↗</a></div><div class="hero-proof"><span><b>2019</b>{lang==='id'?'Berdiri di Indonesia':'Established in Indonesia'}</span><span><b>Riau</b>{lang==='id'?'Fokus bentang alam':'Landscape focus'}</span><span><b>5</b>{lang==='id'?'Program terhubung':'Connected programs'}</span></div></div>
    <figure class="hero-figure"><img src={heroImage} width="1600" height="900" alt={lang==='id'?'Warga dan mitra dalam kegiatan pemulihan mangrove di Riau':'Community members and partners during mangrove restoration in Riau'} fetchpriority="high" decoding="async"/><figcaption>{lang==='id'?'Dokumentasi program pemulihan mangrove di Riau. Sumber: arsip website Yayasan Gambut.':'Mangrove restoration program in Riau. Source: Yayasan Gambut website archive.'}</figcaption></figure></div>
  </section>

  <section class="section impact-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.impactEyebrow}</p><h2>{c.impactTitle}</h2></div><div class="archive-heading-actions"><span class="notice archive">{c.temporary}</span><a class="text-link" href={r.impact}>{lang==='id'?'Metode pelaporan dampak':'Impact reporting method'}</a></div></div><div class="impact-grid">{archiveMetrics.map(item=><a href={item.href} target="_blank" rel="noreferrer"><strong>{item.value}</strong><div><p>{item.label}</p><small>{item.note}</small></div><b aria-hidden="true">↗</b><span class="sr-only"> — {lang==='id'?'buka sumber data':'open data source'}</span></a>)}</div></div></section>

  <section class="section programs"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.programEyebrow}</p><h2>{c.programTitle}</h2></div><a class="text-link" href={r.programs}>{c.latest}</a></div><div class="program-grid">{programs.map((program,index)=><a class="program-card" href={`/${lang}/{lang==='id'?'program':'programs'}/${program.data.slug}/`}><span>0{index+1}</span><h3>{program.data.title}</h3><p>{program.data.summary}</p><b aria-hidden="true">→</b></a>)}</div></div></section>

  <section class="section location"><div class="container location-grid"><div><p class="eyebrow">{c.locationEyebrow}</p><h2>{c.locationTitle}</h2><p class="lede">{c.locationText}</p><a class="text-link" href={r.locations}>{c.latest}</a></div><a class="location-link" href="https://webgisyg.id/" target="_blank" rel="noreferrer"><span class="location-link-kicker">YG GeoPortal</span><strong>{lang==='id'?'Jelajahi lokasi kerja dan data lapangan':'Explore work locations and field data'}</strong><span>{lang==='id'?'Buka peta interaktif Yayasan Gambut':'Open Yayasan Gambut’s interactive map'} ↗</span></a></div></div></section>

  <section class="section stories"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.storyEyebrow}</p><h2>{c.storyTitle}</h2></div><a class="text-link" href={r.stories}>{c.latest}</a></div><div class="story-grid">{stories.map(story=><article>{story.data.featuredImage&&<img src={story.data.featuredImage} width="900" height="600" loading="lazy" alt={story.data.imageAlt||story.data.title}/>}<div><p class="meta">{categoryLabel(story.data.category,lang)} · <time datetime={story.data.date.toISOString()}>{story.data.date.toLocaleDateString(lang==='id'?'id-ID':'en-GB',{year:'numeric',month:'long',day:'numeric'})}</time></p><h3>{story.data.title}</h3><p>{excerpt(story.data.summary,170)}</p><a class="text-link" href={`/${lang}/{lang==='id'?'cerita':'field-stories'}/${story.data.slug}/`}>{c.read}</a></div></article>)}</div></div></section>

  <section class="section publication-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.publicationEyebrow}</p><h2>{c.publicationTitle}</h2>{publicationFallback&&<p class="archive-language">{lang==='en'?'Documents are available in their original Indonesian editions.':''}</p>}</div><a class="text-link" href={r.publications}>{c.latest}</a></div><div class="publication-grid">{publications.map(pub=><article lang={publicationFallback&&lang==='en'?'id':undefined}><span>{pub.data.year}</span><div><p class="meta">{pub.data.category}</p><h3>{pub.data.title}</h3><p>{excerpt(pub.data.summary,180)}</p></div><a class:list={['text-link',{external:publicationFallback}]} href={publicationFallback?pub.data.fileUrl:`/${lang}/{lang==='id'?'publikasi':'publications'}/${pub.data.slug}/`} target={publicationFallback?'_blank':undefined} rel={publicationFallback?'noreferrer':undefined}>{c.view}</a></article>)}</div></div></section>

  <section class="data-band"><div class="container"><div><p class="eyebrow">Data &amp; WebGIS</p><h2>{c.dataTitle}</h2></div><div><p>{c.dataText}</p><a class="button light" href="https://webgisyg.id/" target="_blank" rel="noreferrer">{c.exploreWebgis} ↗</a></div></div></section>
  <section class="section partners"><div class="container"><p class="eyebrow">{lang==='id'?'Mitra':'Partners'}</p><h2>{c.partners}</h2><p class="lede">{c.partnersText}</p><div class="partner-row"><span>{lang==='id'?'Komunitas lokal':'Local communities'}</span><span>{lang==='id'?'Pemerintah':'Government'}</span><span>{lang==='id'?'Akademisi':'Academia'}</span><span>{lang==='id'?'Mitra pembangunan':'Development partners'}</span></div><img class="partner-montage" src="https://yayasangambut.org/wp-content/uploads/2026/03/Mitra-2026.jpg" width="1800" height="1100" loading="lazy" decoding="async" alt={lang==='id'?'Montase logo mitra Yayasan Gambut tahun 2026':'Montage of Yayasan Gambut partner logos in 2026'}/><aside class="award"><div><p class="eyebrow">RestorLife Awards 2025</p><h3>{lang==='id'?'Finalis NGO dari Indonesia':'NGO finalist from Indonesia'}</h3><p>{lang==='id'?'Yayasan Gambut tercantum sebagai satu dari 16 finalis kategori NGO, yang dipilih dalam ajang dengan 1.127 pendaftaran pada seluruh kategori.':'Yayasan Gambut was listed among 16 NGO finalists in an awards cycle that received 1,127 applications across all categories.'}</p><a class="text-link external" href="https://about.restor.eco/blog/meet-restorlife-awards-2025-finalists" target="_blank" rel="noreferrer">{lang==='id'?'Periksa pengumuman resmi':'Check the official announcement'}</a></div></aside><div class="collaboration-callout"><div><p class="eyebrow">{lang==='id'?'Mari bekerja bersama':'Work with us'}</p><h3>{lang==='id'?'Bangun kolaborasi yang berakar pada kebutuhan tapak.':'Build collaboration rooted in local needs.'}</h3><p>{lang==='id'?'Hubungi tim Yayasan Gambut untuk membahas program, riset, data, publikasi, atau peluang kemitraan.':'Contact Yayasan Gambut to discuss programs, research, data, publications, or partnership opportunities.'}</p></div><a class="button primary" href={r.contact}>{lang==='id'?'Hubungi Kami':'Contact Us'}</a></div></div></section>
</BaseLayout>

<style>
  .hero{padding:clamp(1.5rem,3vw,2.8rem) 0;overflow:hidden;background:radial-gradient(circle at 86% 15%,rgba(145,203,212,.28),transparent 31%),var(--paper)}.hero-grid{display:grid;gap:1.5rem;align-items:center}.hero-copy{position:relative;z-index:2}.hero h1{max-width:14ch;margin-bottom:.85rem;font-size:clamp(2.6rem,4.6vw,4.5rem)}.hero-text{max-width:39rem;margin-bottom:0;font-size:clamp(.98rem,1.3vw,1.1rem);color:var(--muted)}.hero-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.2rem 0 0}.hero-proof{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem;margin-top:1.4rem;padding-top:1rem;border-top:1px solid var(--line)}.hero-proof span{display:grid;color:var(--muted);font-size:.69rem;line-height:1.3}.hero-proof b{margin-bottom:.15rem;color:var(--ink);font-size:1rem}.hero-figure{position:relative;margin:0;width:100%;height:clamp(18rem,42vw,29rem);overflow:hidden;border-radius:var(--radius-lg);background:var(--forest-800);box-shadow:var(--shadow)}.hero-figure::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 65%,rgba(7,54,45,.45))}.hero-figure img{height:100%;object-fit:cover}.hero-figure figcaption{position:absolute;z-index:1;right:.75rem;bottom:.7rem;max-width:23rem;color:white;font-size:.62rem;text-shadow:0 1px 3px #000}.impact-section{background:var(--paper-bright)}.archive-heading-actions{display:grid;justify-items:start;gap:.45rem}.impact-grid{display:grid;gap:.65rem}.impact-grid>a{position:relative;display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:center;padding:1rem;border:1px solid var(--line);border-radius:var(--radius-md);color:inherit;text-decoration:none;transition:transform .2s,border-color .2s}.impact-grid>a:hover{transform:translateY(-2px);border-color:var(--coast-300)}.impact-grid>a>b{position:absolute;right:.8rem;top:.65rem;color:var(--coast-700)}.impact-grid strong{font:780 2.25rem/1 var(--sans);letter-spacing:-.05em;color:var(--forest-950)}.impact-grid p{margin:0 1rem .2rem 0;font-weight:760}.impact-grid small{display:block;color:var(--muted);font-size:.69rem;line-height:1.4}.program-grid{display:grid;gap:.65rem}.program-card{position:relative;min-height:11rem;padding:1rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright);text-decoration:none;transition:transform .2s,background .2s,box-shadow .2s}.program-card:hover{transform:translateY(-3px);background:#fff;box-shadow:var(--shadow)}.program-card span{font-size:.68rem;font-weight:850;color:var(--coast-700)}.program-card h3{margin:1.8rem 0 .45rem;font:740 1.12rem/1.12 var(--sans)}.program-card p{margin-bottom:0;color:var(--muted);font-size:.78rem;line-height:1.45}.program-card b{position:absolute;right:1rem;top:.8rem}.location{background:#dfecea}.location-grid{display:grid;gap:1.5rem}.map-visual{position:relative;min-height:18rem;overflow:hidden;border-radius:var(--radius-lg);background-color:var(--forest-950);background-image:linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px);background-size:3rem 3rem;color:white}.coordinate{position:absolute;top:1rem;left:1rem;font-size:.65rem;letter-spacing:.1em}.pin{position:absolute;left:47%;top:42%;display:grid;place-items:center;width:4rem;height:4rem;border:1px solid var(--coast-300);border-radius:50%;background:var(--coast-700);font-weight:800;box-shadow:0 0 0 .65rem rgba(145,196,205,.13)}.map-label{position:absolute;padding:.35rem .6rem;border:1px solid rgba(255,255,255,.28);border-radius:999px;font-size:.66rem}.coast{right:12%;top:20%}.peat{left:15%;bottom:22%}.forest{right:16%;bottom:12%}.map-visual>a{position:absolute;right:1rem;bottom:1rem;font-weight:800}.field-band{display:grid;background:var(--peat-700);color:white}.field-band img{height:100%;max-height:24rem;object-fit:cover}.field-band>div{display:grid;align-content:center;padding:clamp(1.7rem,3.5vw,3.25rem)}blockquote{margin:0 0 .85rem;font:740 clamp(1.65rem,2.6vw,2.55rem)/1.1 var(--sans);letter-spacing:-.035em}.field-band .eyebrow{color:#efd8b7}.field-band small{color:rgba(255,255,255,.68)}.story-grid{display:grid;gap:.8rem}.story-grid article{display:grid;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright)}.story-grid img{aspect-ratio:16/9;object-fit:cover}.story-grid article>div{padding:1rem}.story-grid h3{display:-webkit-box;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical;font:740 1.25rem/1.15 var(--sans)}.story-grid article>div>p:not(.meta){display:-webkit-box;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical}.meta{font-size:.66rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--coast-700)}.publication-section{background:var(--paper-bright)}.archive-language{color:var(--muted)}.publication-grid{display:grid;border-top:1px solid var(--line)}.publication-grid article{display:grid;gap:.7rem;padding:.9rem 0;border-bottom:1px solid var(--line)}.publication-grid>article>span{font:760 1.45rem/1 var(--sans);color:var(--peat-700)}.publication-grid h3{font:740 1.15rem/1.15 var(--sans)}.publication-grid article>div>p:not(.meta){display:-webkit-box;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical}.data-band{padding:clamp(2.5rem,4vw,3.75rem) 0;background:var(--coast-700);color:white}.data-band>.container{display:grid;gap:1.2rem}.data-band .eyebrow{color:#bde0e6}.data-band h2{max-width:14ch;margin-bottom:0}.data-band p{max-width:36rem;font-size:.95rem}.partner-row{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1.1rem}.partner-row span{padding:.42rem .65rem;border:1px solid var(--line);border-radius:.35rem;background:var(--paper-bright);font-size:.76rem;font-weight:750}.partner-montage{margin-top:1rem;max-height:18rem;object-fit:contain;border:1px solid var(--line);border-radius:var(--radius-md);background:white}.award{display:grid;gap:.8rem;align-items:center;margin-top:.8rem;padding:1.1rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright)}.award h3{font:740 1.3rem/1.15 var(--sans)}.award p:not(.eyebrow){max-width:52rem;color:var(--muted)}.collaboration-callout{display:grid;gap:1rem;align-items:center;margin-top:.65rem;padding:clamp(1.1rem,2.5vw,1.6rem);border-radius:var(--radius-md);background:#dce8e6}.collaboration-callout h3{font:740 clamp(1.45rem,2.2vw,2rem)/1.1 var(--sans)}.collaboration-callout p:not(.eyebrow){max-width:48rem;color:var(--muted)}.collaboration-callout .button{width:fit-content}
  .location-link{display:flex;flex-direction:column;justify-content:flex-end;gap:.85rem;min-height:15rem;padding:clamp(1.4rem,3vw,2.2rem);border-radius:var(--radius-md);background:linear-gradient(135deg,#0a392e,#126479);color:#fff;text-decoration:none;transition:transform .2s}.location-link:hover{transform:translateY(-3px)}.location-link-kicker{font-size:.8rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#b8dce0}.location-link strong{max-width:22ch;font-size:clamp(1.5rem,2.5vw,2.3rem);line-height:1.12;letter-spacing:-.035em}.location-link>span:last-child{font-size:.9rem;font-weight:700}.hero{padding:1.1rem 0 1.5rem}.hero h1{font-size:clamp(2.3rem,4vw,3.9rem);max-width:15ch}.hero-figure{height:clamp(15rem,32vw,24rem)}.hero-proof{margin-top:1rem}.program-card{min-height:9rem}.program-card h3{margin:1rem 0 .4rem}.impact-grid strong{font-size:1.8rem}.partner-montage{max-height:13rem}.award{padding:.9rem}.collaboration-callout{margin-top:.6rem}
  @media(min-width:680px){.impact-grid{grid-template-columns:repeat(3,1fr)}.program-grid{grid-template-columns:repeat(2,1fr)}.story-grid{grid-template-columns:repeat(2,1fr)}.publication-grid article{grid-template-columns:7rem 1fr auto;align-items:start}.collaboration-callout{grid-template-columns:1fr auto}}
  @media(min-width:980px){.hero-grid{grid-template-columns:minmax(0,1.02fr) minmax(25rem,.98fr);gap:clamp(2rem,3.5vw,3.5rem)}.hero-figure{height:clamp(18rem,34vw,24rem)}.program-grid{grid-template-columns:repeat(5,1fr)}.field-band{grid-template-columns:1.05fr .95fr}.location-grid,.data-band>.container{grid-template-columns:1fr 1fr;align-items:center}}
</style>
