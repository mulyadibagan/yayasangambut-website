---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, routeMap, type Lang } from '../data/site';
import { categoryLabel, excerpt } from '../utils/text';
const { lang } = Astro.props as { lang: Lang }; const c=copy[lang]; const r=routeMap[lang];
const [allPrograms,allArticles,allPublications,allGalleries,allLocations]=await Promise.all([
  getCollection('programs'), getCollection('articles'), getCollection('publications'), getCollection('gallery'), getCollection('locations'),
]);
const programs=allPrograms.filter(({data})=>data.language===lang&&data.status==='published'&&data.featured).sort((a,b)=>a.data.order-b.data.order);
const publishedArticles=allArticles.filter(({data})=>data.status==='published');
const nativeStories=publishedArticles.filter(({data})=>data.language===lang);
const stories=nativeStories.sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
const publishedPublications=allPublications.filter(({data})=>data.status==='published');
const nativePublications=publishedPublications.filter(({data})=>data.language===lang).sort((a,b)=>b.data.year-a.data.year);
const publications=(nativePublications.length?nativePublications:publishedPublications.filter(({data})=>data.language==='id').sort((a,b)=>b.data.year-a.data.year)).slice(0,2);
const publicationFallback=!nativePublications.length;
const publishedGalleries=allGalleries.filter(({data})=>data.status==='published'&&data.language==='id');
const archiveMetrics=[
  {value:nativeStories.length,id:'Cerita dan pembelajaran lapangan',en:'Field stories and lessons in English',href:r.stories},
  {value:publishedPublications.length,id:'Publikasi yang dapat dibaca',en:'Publications available to read',href:r.publications},
  {value:publishedGalleries.reduce((total,album)=>total+album.data.images.length,0),id:'Foto dokumentasi',en:'Documentary photographs',href:r.gallery},
  {value:allLocations.filter(({data})=>data.status==='published'&&data.language==='id'&&data.legacyCategorySlug).length,id:'Lokasi dalam arsip cerita',en:'Locations in the Indonesian story archive',href:r.locations},
];
const heroImage='https://yayasangambut.org/wp-content/uploads/2026/07/photo_7-1536x1143-1.jpeg';
const fieldImage='https://yayasangambut.org/wp-content/uploads/2023/04/WhatsApp-Image-2023-04-29-at-15.13.43.jpeg';
---
<BaseLayout title={lang==='id'?'Yayasan Gambut — Aksi bentang alam berbasis masyarakat':'Yayasan Gambut — Community-led landscape action'} description={c.heroText} schemaType="organization">
  <section class="hero">
    <div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">{c.heroKicker}</p><h1>{c.heroTitle}</h1><p class="hero-text">{c.heroText}</p><div class="hero-actions"><a class="button primary" href={r.programs}>{c.seePrograms}</a><a class="button secondary" href="https://webgisyg.id/" target="_blank" rel="noreferrer">{c.exploreWebgis} ↗</a></div></div>
    <figure class="hero-figure"><img src={heroImage} width="1600" height="900" alt={lang==='id'?'Warga dan mitra dalam kegiatan pemulihan mangrove di Riau':'Community members and partners during mangrove restoration in Riau'} fetchpriority="high" decoding="async"/><figcaption>{lang==='id'?'Dokumentasi program pemulihan mangrove di Riau. Sumber: arsip website Yayasan Gambut.':'Mangrove restoration program in Riau. Source: Yayasan Gambut website archive.'}</figcaption></figure></div>
  </section>

  <section class="section impact-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.impactEyebrow}</p><h2>{c.impactTitle}</h2></div><div class="archive-heading-actions"><span class="notice archive">{c.temporary}</span><a class="text-link" href={r.impact}>{lang==='id'?'Cara kami melaporkan dampak':'How we report impact'}</a></div></div><div class="impact-grid">{archiveMetrics.map(item=><a href={item.href}><strong>{item.value}</strong><p>{item[lang]}</p><small>{lang==='id'?'Dihitung dari konten yang tersedia di situs ini.':'Counted from content available on this website.'}</small><span class="sr-only"> — {lang==='id'?'buka halaman terkait':'open related page'}</span></a>)}</div></div></section>

  <section class="section programs"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.programEyebrow}</p><h2>{c.programTitle}</h2></div><a class="text-link" href={r.programs}>{c.latest}</a></div><div class="program-grid">{programs.map((program,index)=><a class="program-card" href={`/${lang}/${lang==='id'?'program':'programs'}/${program.data.slug}/`}><span>0{index+1}</span><h3>{program.data.title}</h3><p>{program.data.summary}</p><b aria-hidden="true">→</b></a>)}</div></div></section>

  <section class="section location"><div class="container location-grid"><div><p class="eyebrow">{c.locationEyebrow}</p><h2>{c.locationTitle}</h2><p class="lede">{c.locationText}</p><a class="text-link" href={r.locations}>{c.latest}</a></div><div class="map-visual" role="group" aria-label={lang==='id'?'Visual lokasi kerja awal di Provinsi Riau':'Visual of initial work locations in Riau Province'}><span class="coordinate">0.5071° N · 101.4478° E</span><span class="pin">Riau</span><div class="map-label coast">{lang==='id'?'Pesisir':'Coast'}</div><div class="map-label peat">{lang==='id'?'Gambut':'Peatland'}</div><div class="map-label forest">{lang==='id'?'Hutan':'Forest'}</div><a href="https://webgisyg.id/" target="_blank" rel="noreferrer">YG GeoPortal ↗</a></div></div></section>

  <section class="field-band"><img src={fieldImage} width="1600" height="1200" loading="lazy" alt={lang==='id'?'Kelompok masyarakat di area pembibitan dan kebun':'Community group in a nursery and garden area'}/><div><p class="eyebrow">{lang==='id'?'Transformasi pengetahuan':'Knowledge transformation'}</p><blockquote>{lang==='id'?'“Masyarakat tetap sejahtera dan lingkungan terus lestari.”':'“Communities prosper while the environment continues to thrive.”'}</blockquote><small>{lang==='id'?'Dokumentasi lapangan dari arsip website Yayasan Gambut.':'Field documentation from the Yayasan Gambut website archive.'}</small></div></section>

  <section class="section stories"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.storyEyebrow}</p><h2>{c.storyTitle}</h2></div><a class="text-link" href={r.stories}>{c.latest}</a></div><div class="story-grid">{stories.map(story=><article>{story.data.featuredImage&&<img src={story.data.featuredImage} width="900" height="600" loading="lazy" alt={story.data.imageAlt||story.data.title}/>}<div><p class="meta">{categoryLabel(story.data.category,lang)} · <time datetime={story.data.date.toISOString()}>{story.data.date.toLocaleDateString(lang==='id'?'id-ID':'en-GB',{year:'numeric',month:'long',day:'numeric'})}</time></p><h3>{story.data.title}</h3><p>{excerpt(story.data.summary,170)}</p><a class="text-link" href={`/${lang}/${lang==='id'?'cerita':'field-stories'}/${story.data.slug}/`}>{c.read}</a></div></article>)}</div></div></section>

  <section class="section publication-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{c.publicationEyebrow}</p><h2>{c.publicationTitle}</h2>{publicationFallback&&<p class="archive-language">{lang==='en'?'Documents are available in their original Indonesian editions.':''}</p>}</div><a class="text-link" href={r.publications}>{c.latest}</a></div><div class="publication-grid">{publications.map(pub=><article lang={publicationFallback&&lang==='en'?'id':undefined}><span>{pub.data.year}</span><div><p class="meta">{pub.data.category}</p><h3>{pub.data.title}</h3><p>{excerpt(pub.data.summary,180)}</p></div><a class:list={['text-link',{external:publicationFallback}]} href={publicationFallback?pub.data.fileUrl:`/${lang}/${lang==='id'?'publikasi':'publications'}/${pub.data.slug}/`} target={publicationFallback?'_blank':undefined} rel={publicationFallback?'noreferrer':undefined}>{c.view}</a></article>)}</div></div></section>

  <section class="data-band"><div class="container"><div><p class="eyebrow">Data &amp; WebGIS</p><h2>{c.dataTitle}</h2></div><div><p>{c.dataText}</p><a class="button light" href="https://webgisyg.id/" target="_blank" rel="noreferrer">{c.exploreWebgis} ↗</a></div></div></section>
  <section class="section partners"><div class="container"><p class="eyebrow">{lang==='id'?'Mitra':'Partners'}</p><h2>{c.partners}</h2><p class="lede">{c.partnersText}</p><div class="partner-row"><span>{lang==='id'?'Komunitas lokal':'Local communities'}</span><span>{lang==='id'?'Pemerintah':'Government'}</span><span>{lang==='id'?'Akademisi':'Academia'}</span><span>{lang==='id'?'Mitra pembangunan':'Development partners'}</span></div><img class="partner-montage" src="https://yayasangambut.org/wp-content/uploads/2026/03/Mitra-2026.jpg" width="1800" height="1100" loading="lazy" decoding="async" alt={lang==='id'?'Montase logo mitra Yayasan Gambut tahun 2026':'Montage of Yayasan Gambut partner logos in 2026'}/><aside class="award"><div><p class="eyebrow">RestorLife Awards 2025</p><h3>{lang==='id'?'Finalis NGO dari Indonesia':'NGO finalist from Indonesia'}</h3><p>{lang==='id'?'Yayasan Gambut tercantum sebagai satu dari 16 finalis kategori NGO, yang dipilih dalam ajang dengan 1.127 pendaftaran pada seluruh kategori.':'Yayasan Gambut was listed among 16 NGO finalists in an awards cycle that received 1,127 applications across all categories.'}</p><a class="text-link external" href="https://about.restor.eco/blog/meet-restorlife-awards-2025-finalists" target="_blank" rel="noreferrer">{lang==='id'?'Periksa pengumuman resmi':'Check the official announcement'}</a></div></aside><div class="collaboration-callout"><div><p class="eyebrow">{lang==='id'?'Mari bekerja bersama':'Work with us'}</p><h3>{lang==='id'?'Bangun kolaborasi yang berakar pada kebutuhan tapak.':'Build collaboration rooted in local needs.'}</h3><p>{lang==='id'?'Hubungi tim Yayasan Gambut untuk membahas program, riset, data, publikasi, atau peluang kemitraan.':'Contact Yayasan Gambut to discuss programs, research, data, publications, or partnership opportunities.'}</p></div><a class="button primary" href={r.contact}>{lang==='id'?'Hubungi Kami':'Contact Us'}</a></div></div></section>
</BaseLayout>

<style>
  .hero{padding:clamp(2.5rem,5vw,5rem) 0;overflow:hidden;background:linear-gradient(125deg,var(--paper) 68%,rgba(145,196,205,.28))}.hero-grid{display:grid;gap:2.5rem;align-items:center}.hero-copy{position:relative;z-index:2}.hero h1{max-width:15ch;margin-bottom:1.4rem;font-size:clamp(3rem,6.2vw,6.2rem)}.hero-text{max-width:43rem;font-size:clamp(1.08rem,2vw,1.35rem);color:var(--muted)}.hero-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin:2rem 0 0}.hero-figure{position:relative;margin:0;width:100%;height:clamp(20rem,60vw,34rem);overflow:hidden;border-radius:var(--radius-lg);background:var(--forest-800)}.hero-figure img{height:100%;object-fit:cover}.hero-figure figcaption{position:absolute;right:1rem;bottom:1rem;max-width:25rem;padding:.55rem .75rem;background:rgba(10,44,39,.82);color:white;font-size:.7rem;border-radius:.3rem}.impact-section{background:var(--paper-bright)}.archive-heading-actions{display:grid;justify-items:start;gap:.7rem}.impact-grid{display:grid;border-top:1px solid var(--line)}.impact-grid>a{display:block;padding:1.6rem 0;border-bottom:1px solid var(--line);color:inherit;text-decoration:none}.impact-grid>a:hover p{text-decoration:underline;text-underline-offset:.25em}.impact-grid strong{font:500 4rem/1 var(--serif)}.impact-grid p{margin:.5rem 0;font-weight:700}.impact-grid small{color:var(--muted)}.program-grid{display:grid;gap:.75rem}.program-card{position:relative;min-height:18rem;padding:1.4rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright);text-decoration:none;transition:transform .2s,background .2s}.program-card:hover{transform:translateY(-4px);background:#fff}.program-card span{font-weight:800;color:var(--coast-700)}.program-card h3{margin:4rem 0 .7rem;font:500 1.65rem/1.05 var(--serif)}.program-card p{color:var(--muted)}.program-card b{position:absolute;right:1.2rem;top:1.2rem}.location{background:#dce8e6}.location-grid{display:grid;gap:3rem}.map-visual{position:relative;min-height:28rem;overflow:hidden;border-radius:var(--radius-lg);background-color:var(--forest-950);background-image:linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px);background-size:3rem 3rem;color:white}.coordinate{position:absolute;top:1rem;left:1rem;font-size:.72rem;letter-spacing:.1em}.pin{position:absolute;left:47%;top:45%;display:grid;place-items:center;width:5.5rem;height:5.5rem;border:1px solid var(--coast-300);border-radius:50%;background:var(--coast-700);font-weight:800;box-shadow:0 0 0 1rem rgba(145,196,205,.13)}.map-label{position:absolute;padding:.45rem .7rem;border:1px solid rgba(255,255,255,.28);border-radius:999px;font-size:.75rem}.coast{right:12%;top:20%}.peat{left:15%;bottom:22%}.forest{right:16%;bottom:12%}.map-visual>a{position:absolute;right:1rem;bottom:1rem;font-weight:800}.field-band{display:grid;background:var(--peat-700);color:white}.field-band img{height:100%;max-height:43rem;object-fit:cover}.field-band>div{display:grid;align-content:center;padding:clamp(2rem,6vw,6rem)}blockquote{margin:0 0 1.5rem;font:500 clamp(2rem,4vw,4rem)/1.1 var(--serif);letter-spacing:-.03em}.field-band .eyebrow{color:#efd8b7}.field-band small{color:rgba(255,255,255,.68)}.story-grid{display:grid;gap:1rem}.story-grid article{overflow:hidden;border-radius:var(--radius-md);background:var(--paper-bright);box-shadow:0 1px 0 var(--line)}.story-grid img{aspect-ratio:3/2;object-fit:cover}.story-grid article>div{padding:1.4rem}.story-grid h3{display:-webkit-box;overflow:hidden;-webkit-line-clamp:3;-webkit-box-orient:vertical;font:500 1.8rem/1.1 var(--serif)}.story-grid article>div>p:not(.meta){display:-webkit-box;overflow:hidden;-webkit-line-clamp:3;-webkit-box-orient:vertical}.meta{font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--coast-700)}.publication-section{background:var(--paper-bright)}.archive-language{color:var(--muted)}.publication-grid{display:grid;border-top:1px solid var(--line)}.publication-grid article{display:grid;gap:1rem;padding:1.4rem 0;border-bottom:1px solid var(--line)}.publication-grid>article>span{font:500 2.5rem/1 var(--serif);color:var(--peat-700)}.publication-grid h3{font:500 1.55rem/1.1 var(--serif)}.publication-grid article>div>p:not(.meta){display:-webkit-box;overflow:hidden;-webkit-line-clamp:3;-webkit-box-orient:vertical}.data-band{padding:clamp(4rem,8vw,8rem) 0;background:var(--coast-700);color:white}.data-band>.container{display:grid;gap:2rem}.data-band .eyebrow{color:#bde0e6}.data-band h2{max-width:12ch}.data-band p{max-width:36rem;font-size:1.1rem}.partner-row{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:2.5rem}.partner-row span{padding:.7rem 1rem;border:1px solid var(--line);border-radius:999px;background:var(--paper-bright);font-weight:750}.partner-montage{margin-top:2rem;max-height:38rem;object-fit:contain;border:1px solid var(--line);border-radius:var(--radius-md);background:white}.award{display:grid;gap:1.5rem;align-items:center;margin-top:2rem;padding:clamp(1.4rem,4vw,2.4rem);border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright)}.award h3{font:500 2rem/1.1 var(--serif)}.award p:not(.eyebrow){max-width:52rem;color:var(--muted)}.collaboration-callout{display:grid;gap:1.5rem;align-items:center;margin-top:1rem;padding:clamp(1.5rem,4vw,3rem);border-radius:var(--radius-md);background:#dce8e6}.collaboration-callout h3{font:500 clamp(1.8rem,3vw,3rem)/1.05 var(--serif)}.collaboration-callout p:not(.eyebrow){max-width:48rem;color:var(--muted)}.collaboration-callout .button{width:fit-content}
  @media(min-width:680px){.impact-grid{grid-template-columns:repeat(2,1fr)}.impact-grid>a:nth-child(odd){padding-right:2rem;border-right:1px solid var(--line)}.impact-grid>a:nth-child(even){padding-left:2rem}.program-grid{grid-template-columns:repeat(2,1fr)}.story-grid{grid-template-columns:repeat(2,1fr)}.publication-grid article{grid-template-columns:8rem 1fr auto;align-items:start}.collaboration-callout{grid-template-columns:1fr auto}}
  @media(min-width:980px){.hero-grid{grid-template-columns:minmax(0,1.08fr) minmax(25rem,.92fr);gap:clamp(2.5rem,5vw,5rem)}.hero h1{font-size:clamp(4rem,5.4vw,5.4rem)}.hero-figure{height:clamp(32rem,calc(100vh - 9rem),40rem)}.impact-grid{grid-template-columns:repeat(4,1fr)}.impact-grid>a{padding:2rem!important;border-right:1px solid var(--line)}.impact-grid>a:last-child{border-right:0}.program-grid{grid-template-columns:repeat(5,1fr)}.field-band{grid-template-columns:1.05fr .95fr}.location-grid,.data-band>.container{grid-template-columns:1fr 1fr;align-items:center}}
</style>
