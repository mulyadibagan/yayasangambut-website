---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import { organisation, pageContent, type Lang } from '../data/site';
const {lang,page}=Astro.props as {lang:Lang,page:string};
const data=(pageContent as any)[lang][page];
const isAbout=page==='tentang-kami'||page==='about';
const isLocations=page==='lokasi-kerja'||page==='where-we-work';
const isContact=page==='hubungi-kami'||page==='contact';
const ownTeam=await getCollection('team',({data})=>data.language===lang&&data.status==='published');
const team=(ownTeam.length?ownTeam:await getCollection('team',({data})=>data.language==='id'&&data.status==='published')).sort((a,b)=>a.data.order-b.data.order);
const locations=(await getCollection('locations',({data})=>data.language==='id'&&data.status==='published')).sort((a,b)=>a.data.order-b.data.order);
const groups=['Governance','Management & Program Team','Technical Advisors'] as const;
const groupLabels={
  Governance:{id:'Pendiri dan Pengawas',en:'Founders and Supervisory Board'},
  'Management & Program Team':{id:'Tim Inti',en:'Core Team'},
  'Technical Advisors':{id:'Penasihat Teknis',en:'Technical Advisors'},
} as const;
---
<ContentLayout title={data.title} intro={data.intro} eyebrow={isAbout?(lang==='id'?'Memetakan aksi. Merekam perubahan.':'Mapping action. Recording change.'):undefined}>
  <section class="section"><div class="container info-grid">{data.sections.map((section:string[],index:number)=><article id={section[0].toLowerCase().replaceAll(' ','-').replace(/[^a-z0-9-]/g,'')}><span>{String(index+1).padStart(2,'0')}</span><div><h2>{section[0]}</h2>{section[0]==='Email'?<p><a href={`mailto:${section[1]}`}>{section[1]}</a></p>:<p>{section[1]}</p>}</div></article>)}</div></section>

  {isAbout&&<section class="team section" id="tim"><div class="container"><p class="eyebrow">{lang==='id'?'Tim Kami':'Our Team'}</p><h2>{lang==='id'?'Orang-orang di balik kerja Yayasan Gambut':'The people behind Yayasan Gambut'}</h2>{groups.map(group=><div class="team-group"><h3>{groupLabels[group][lang]}</h3><div class="team-grid">{team.filter(member=>member.data.group===group).map(member=><article>{member.data.photo&&<img src={member.data.photo} width="500" height="500" loading="lazy" decoding="async" alt=""/>}<div><h4>{member.data.name}</h4><p>{lang==='en'?(member.data.positionEn??member.data.position):member.data.position}</p>{member.data.bio&&<small>{member.data.bio}</small>}</div></article>)}</div></div>)}</div></section>}

  {isLocations&&<section class="locations section"><div class="container"><p class="eyebrow">{lang==='id'?'Arsip lokasi':'Location archive'}</p><h2>{lang==='id'?'Lokasi yang muncul dalam cerita lapangan':'Places represented in field stories'}</h2><div class="location-list">{locations.map(location=><article><h3>{location.data.name}</h3><p>{location.data.summary}</p>{location.data.legacyCategorySlug&&<a class="text-link" href={`/${lang}/${lang==='id'?'cerita':'field-stories'}/?category=${location.data.legacyCategorySlug}`}>{lang==='id'?'Lihat cerita terkait':'View related stories'}</a>}</article>)}</div></div></section>}

  {isContact&&<section class="contact-band"><div class="container"><p class="eyebrow">{lang==='id'?'Kanal resmi':'Official channels'}</p><div class="contact-links"><a href={`mailto:${organisation.email}`}>{organisation.email}</a><a href={organisation.facebook} target="_blank" rel="noreferrer">Facebook ↗</a><a href={organisation.instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href={organisation.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a href={organisation.youtube} target="_blank" rel="noreferrer">YouTube ↗</a></div><p>{lang==='id'?'Nomor telepon tidak dipublikasikan pada website sumber.':'No telephone number is published on the source website.'}</p></div></section>}
</ContentLayout>
<style>
  .info-grid{border-top:1px solid var(--line)}.info-grid>article{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:2rem 0;border-bottom:1px solid var(--line)}.info-grid>article>span{color:var(--coast-700);font-weight:800}.info-grid h2{font-size:clamp(1.7rem,3vw,3rem)}.info-grid p{max-width:55rem;color:var(--muted)}
  .team{background:#dce8e6}.team h2,.locations h2{max-width:15ch}.archive-note{max-width:44rem;color:var(--muted)}.team-group{margin-top:3rem}.team-group>h3{padding-bottom:.8rem;border-bottom:1px solid var(--line);font-size:.8rem;letter-spacing:.12em;text-transform:uppercase}.team-grid{display:grid;gap:1rem}.team-grid article{overflow:hidden;border-radius:var(--radius-md);background:var(--paper-bright)}.team-grid img{aspect-ratio:1;object-fit:cover;object-position:top}.team-grid article>div{padding:1rem}.team-grid h4{margin:0;font:500 1.35rem/1.1 var(--serif)}.team-grid p{margin:.45rem 0 0;color:var(--coast-700);font-size:.82rem;font-weight:750}.team-grid small{display:block;margin-top:.6rem;color:var(--muted)}
  .location-list{display:grid;gap:1rem;margin-top:2.5rem}.location-list article{padding:1.4rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright)}.location-list h3{font:500 1.5rem/1.1 var(--serif)}.location-list p{color:var(--muted)}.contact-band{padding:4rem 0;background:var(--coast-700);color:white}.contact-band .eyebrow{color:#cde8ed}.contact-links{display:flex;flex-wrap:wrap;gap:.75rem;margin-bottom:1rem}.contact-links a{padding:.65rem 1rem;border:1px solid rgba(255,255,255,.4);border-radius:999px;text-decoration:none;font-weight:750}.contact-band p:last-child{color:rgba(255,255,255,.72)}
  @media(min-width:640px){.team-grid{grid-template-columns:repeat(2,1fr)}.location-list{grid-template-columns:repeat(2,1fr)}}
  @media(min-width:760px){.info-grid>article{grid-template-columns:6rem 1fr;padding:3rem 0}}
  @media(min-width:1040px){.team-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.location-list{grid-template-columns:repeat(3,1fr)}}
</style>
