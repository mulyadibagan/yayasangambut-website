---
import ContactPage from './ContactPage.astro';
import LocationsPage from './LocationsPage.astro';
import ImpactPage from './ImpactPage.astro';
import WorkAreaMap from './WorkAreaMap.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { organisation, pageContent, type Lang } from '../data/site';
const {lang,page}=Astro.props as {lang:Lang,page:string};
const data=(pageContent as any)[lang][page];
const isAbout=page==='tentang-kami'||page==='about';
const isLocations=page==='lokasi-kerja'||page==='where-we-work';
const isImpact=page==='dampak'||page==='impact';
const isContact=page==='hubungi-kami'||page==='contact';
const Layout = isAbout || isImpact || isLocations || isContact ? BaseLayout : ContentLayout;
const ownTeam=await getCollection('team',({data})=>data.language===lang&&data.status==='published');
const team=(ownTeam.length?ownTeam:await getCollection('team',({data})=>data.language==='id'&&data.status==='published')).sort((a,b)=>a.data.order-b.data.order);
const ownLocations=await getCollection('locations',({data})=>data.language===lang&&data.status==='published'&&Boolean(data.legacyCategorySlug));
const fallbackLocations=lang==='en'&&!ownLocations.length?await getCollection('locations',({data})=>data.language==='id'&&data.status==='published'&&Boolean(data.legacyCategorySlug)):[];
const locations=(ownLocations.length?ownLocations:fallbackLocations).sort((a,b)=>a.data.order-b.data.order);
const locationFallback=lang==='en'&&!ownLocations.length;
const groups=['Governance','Management & Program Team','Technical Advisors'] as const;
const groupLabels={
  Governance:{id:'Pembina dan Pengawas',en:'Board of Trustees and Supervisors'},
  'Management & Program Team':{id:'Tim Inti',en:'Core Team'},
  'Technical Advisors':{id:'Tenaga Ahli',en:'Technical Experts'},
} as const;
---
<Layout title={data.title} description={data.intro} intro={data.intro} eyebrow={isAbout?(lang==='id'?'Memetakan aksi. Merekam perubahan.':'Mapping action. Recording change.'):undefined}>
  {isLocations&&<LocationsPage lang={lang}/>}
  {!isContact&&!isAbout&&!isImpact&&!isLocations&&<section class="section"><div class="container info-grid">{data.sections.map((section:string[],index:number)=><article id={section[0].toLowerCase().replaceAll(' ','-').replace(/[^a-z0-9-]/g,'')}><span>{String(index+1).padStart(2,'0')}</span><div><h2>{section[0]}</h2>{section[0]==='Email'?<p><a href={`mailto:${section[1]}`}>{section[1]}</a></p>:<p>{section[1]}</p>}</div></article>)}</div></section>}

  {isAbout&&<>
    <section class="about-hero"><div class="container about-opening"><div><p class="eyebrow">{lang==='id'?'Tentang Yayasan Gambut':'About Yayasan Gambut'}</p><h1>{lang==='id'?'Tentang Yayasan Gambut':'About Yayasan Gambut'}</h1><p class="lede">{data.intro}</p><nav class="about-jumps" aria-label={lang==='id'?'Jelajahi profil':'Explore our profile'}><a href="#visi">{lang==='id'?'Visi & misi':'Vision & mission'}</a><a href="#tim">{lang==='id'?'Kenali tim':'Meet the team'}</a><a href={lang==='id'?'#legalitas':'#legal-status'}>{lang==='id'?'Legalitas':'Legal status'}</a></nav></div><figure><img src="https://yayasangambut.org/wp-content/uploads/2023/10/AAS-CSR-Indonesia-Group-1024x683.jpg" width="1024" height="683" alt={lang==='id'?'Masyarakat dan mitra kegiatan mangrove di Buruk Bakul, 2023':'Community members and mangrove program partners in Buruk Bakul, 2023'} fetchpriority="high"/><figcaption>{lang==='id'?'Kegiatan mangrove di Buruk Bakul, 2023':'Mangrove activities in Buruk Bakul, 2023'}</figcaption></figure></div></section>
    <section class="section about-profile" id="profil"><div class="container profile-grid"><div><p class="eyebrow">{lang==='id'?'Siapa kami':'Who we are'}</p><h2>{lang==='id'?'Profil Organisasi':'Organisation Profile'}</h2></div><div><p>{data.sections[0][1]}</p><div class="about-facts"><div><strong>2019</strong><span>{lang==='id'?'Tahun berdiri':'Established'}</span></div><div><strong>Riau</strong><span>{lang==='id'?'Fokus utama kerja':'Our primary focus'}</span></div><div><strong>5</strong><span>{lang==='id'?'Bidang program':'Program areas'}</span></div></div></div></div></section>
    <section class="section purpose" id="visi"><div class="container"><div class="vision"><p class="eyebrow">{data.sections[1][0]}</p><h2>{data.sections[1][1]}</h2></div><div class="mission-heading"><h3>{lang==='id'?'Misi':'Mission'}</h3></div><div class="missions">{data.sections.slice(2,5).map((item:string[],i:number)=><article id={lang==='id'?`misi-0${i+1}`:`mission-0${i+1}`}><span>0{i+1}</span><h3>{(lang==='id'?['Keanekaragaman hayati & sumber daya air','Perlindungan & pemanfaatan berkelanjutan','Kapasitas & kemitraan']:['Biodiversity & water resources','Protection & sustainable use','Capacity & partnerships'])[i]}</h3><p>{item[1]}</p></article>)}</div></div></section>
    <section class="section about-approach" id="pendekatan"><div class="container approach-grid"><figure><img src="https://yayasangambut.org/wp-content/uploads/2024/11/WhatsApp-Image-2024-11-10-at-13.35.50-1024x576.jpeg" width="1024" height="576" loading="lazy" alt={lang==='id'?'Dokumentasi pembangunan sekat kanal bersama masyarakat':'Community canal-blocking documentation'}/><figcaption>{lang==='id'?'Pembangunan sekat kanal bersama masyarakat':'Canal-block construction with communities'}</figcaption></figure><div><p class="eyebrow">{lang==='id'?'Cara kami bekerja':'How we work'}</p><h2>{lang==='id'?'Pendampingan, Pelaksanaan, dan Pemantauan':'Community Support, Implementation, and Monitoring'}</h2><p>{data.sections[5][1]}</p><a class="text-link" href={lang==='id'?'/id/program/':'/en/programs/'}>{lang==='id'?'Jelajahi program kami':'Explore our programs'}</a></div></div></section>
  </>}

  {isAbout&&<section class="team section" id="tim"><div class="container"><p class="eyebrow">{lang==='id'?'Tim Kami':'Our Team'}</p><h2>{lang==='id'?'Pengurus dan Tim Yayasan Gambut':'Our Board and Team'}</h2>{groups.map(group=><div class="team-group"><h3>{groupLabels[group][lang]}</h3><div class="team-grid">{team.filter(member=>member.data.group===group).map(member=><article>{member.data.photo&&<img src={member.data.photo} width="500" height="500" loading="lazy" decoding="async" alt=""/>}<div><h4>{member.data.name}</h4><p>{lang==='en'?(member.data.positionEn??member.data.position):member.data.position}</p>{member.data.bio&&<details class="member-bio"><summary>{lang==='id'?'Profil singkat':'Short biography (Indonesian)'}</summary><small lang={lang==='en'?'id':undefined}>{member.data.bio}</small></details>}</div></article>)}</div></div>)}</div></section>}

  {isAbout&&<section class="section about-closing"><div class="container closing-grid"><div id={lang==='id'?'kemitraan':'partnerships'}><p class="eyebrow">{data.sections[7][0]}</p><h2>{lang==='id'?'Kemitraan Program':'Program Partnerships'}</h2><p>{data.sections[7][1]}</p><a class="button primary" href={lang==='id'?'/id/hubungi-kami/':'/en/contact/'}>{lang==='id'?'Hubungi kami':'Contact us'}</a></div><aside id={lang==='id'?'legalitas':'legal-status'}><p class="eyebrow">{data.sections[6][0]}</p><h3>{lang==='id'?'Yayasan berbadan hukum Indonesia':'An Indonesian legal foundation'}</h3><p>{data.sections[6][1]}</p></aside></div></section>}

  

  {isImpact&&<ImpactPage lang={lang}/>}

  {isContact&&<ContactPage lang={lang}/>}

</Layout>
<style>
  .info-grid{border-top:1px solid var(--line)}.info-grid>article{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:2rem 0;border-bottom:1px solid var(--line)}.info-grid>article>span{color:var(--coast-700);font-weight:800}.info-grid h2{font-size:clamp(1.4rem,2vw,2rem)}.info-grid p{max-width:55rem;color:var(--muted)}
  .team{background:#dce8e6}.team h2,.locations h2{max-width:25ch}.archive-note{max-width:48rem;color:var(--muted)}.team-group{margin-top:3rem}.team-group>h3{padding-bottom:.8rem;border-bottom:1px solid var(--line);font-size:.8rem;letter-spacing:.12em;text-transform:uppercase}.team-grid{display:grid;gap:1rem}.team-grid article{overflow:hidden;border-radius:var(--radius-md);background:var(--paper-bright)}.team-grid img{aspect-ratio:1;object-fit:cover;object-position:top}.team-grid article>div{padding:1rem}.team-grid h4{margin:0;font:700 1.35rem/1.1 var(--serif)}.team-grid p{margin:.45rem 0 0;color:var(--coast-700);font-size:.82rem;font-weight:750}.team-grid small{display:block;margin-top:.6rem;color:var(--muted)}
  .locations{background:#dce8e6}.portal-card{display:grid;gap:2rem;align-items:end;padding:clamp(1.5rem,4vw,3rem);border-radius:var(--radius-lg);background:var(--paper-bright)}.portal-card h2{margin-bottom:1rem}.portal-card p:not(.eyebrow){max-width:50rem;color:var(--muted)}.portal-card .button{width:fit-content}.archive-heading{margin-top:clamp(4rem,8vw,7rem)}.location-list{display:grid;gap:1rem;margin-top:2.5rem}.location-list article{display:flex;flex-direction:column;padding:1.4rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright)}.location-list h3{font:700 1.5rem/1.1 var(--serif)}.location-list p{color:var(--muted)}.location-list .text-link{margin-top:auto;padding-top:.75rem}.contact-band{padding:4rem 0;background:var(--coast-700);color:white}.contact-band .eyebrow{color:#cde8ed}.contact-links{display:flex;flex-wrap:wrap;gap:.75rem;margin-bottom:1rem}.contact-links a{padding:.65rem 1rem;border:1px solid rgba(255,255,255,.4);border-radius:999px;text-decoration:none;font-weight:750}.contact-band p:last-child{color:rgba(255,255,255,.72)}
  .impact-snapshot{background:#dce8e6}.snapshot-heading{display:grid;gap:1.5rem;align-items:end}.snapshot-heading h2{max-width:25ch}.snapshot-heading>p{max-width:34rem;color:var(--muted)}.metric-grid{display:grid;gap:1rem;margin:2.5rem 0 0}.metric-grid>div{display:flex;flex-direction:column;padding:1.5rem;border-radius:var(--radius-md);background:var(--paper-bright)}.metric-grid dt{order:2;margin-top:.45rem;color:var(--coast-700);font-size:.82rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.metric-grid dd{order:1;margin:0;font:700 clamp(3rem,8vw,5.5rem)/.9 var(--serif)}.metric-grid p{order:3;color:var(--muted)}.metric-grid a{order:4;margin-top:auto;padding-top:.75rem}.evidence-note{display:grid;gap:1.5rem;align-items:center;margin-top:1rem;padding:1.5rem;border:1px solid var(--line);border-radius:var(--radius-md)}.evidence-note p{margin:0;max-width:55rem;color:var(--muted)}.evidence-note .button{width:fit-content}
  .contact-main{background:var(--paper-bright)}.contact-intro{display:grid;gap:1.5rem;align-items:end}.contact-intro h2{font-size:clamp(1.7rem,4vw,3.8rem);overflow-wrap:anywhere}.contact-intro .button{width:fit-content}.contact-guidance{max-width:54rem;margin:1.5rem 0 2.5rem;color:var(--muted)}.contact-topic-grid,.office-grid{display:grid;gap:1rem}.contact-topic-grid article,.office-grid article{display:flex;flex-direction:column;padding:1.5rem;border:1px solid var(--line);border-radius:var(--radius-md)}.contact-topic-grid h3,.office-grid h3{font:700 1.55rem/1.1 var(--serif)}.contact-topic-grid p,.office-grid p,.office-grid address{color:var(--muted)}.contact-topic-grid a,.office-grid a{margin-top:auto;padding-top:1rem}.office-section{background:#dce8e6}.office-section>div>h2{max-width:14ch}.office-grid{margin-top:2.5rem}.office-grid article{background:var(--paper-bright)}.office-role{font-weight:750}.office-grid address{font-style:normal}
  @media(min-width:640px){.team-grid{grid-template-columns:repeat(2,1fr)}.location-list{grid-template-columns:repeat(2,1fr)}.metric-grid,.contact-topic-grid{grid-template-columns:repeat(3,1fr)}.office-grid{grid-template-columns:minmax(0,48rem)}}
  @media(min-width:760px){.info-grid>article{grid-template-columns:4rem 1fr;padding:1.75rem 0}.portal-card,.snapshot-heading,.evidence-note,.contact-intro{grid-template-columns:1fr auto}}
  @media(min-width:1040px){.team-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.location-list{grid-template-columns:repeat(3,1fr)}}
.team-grid img{max-height:19rem;object-fit:contain;background:#eef2e9}.team-grid h4{font-size:1.2rem}.team-group{margin-top:2rem}.archive-heading{margin-top:3rem}.info-grid>article{padding:1.5rem 0}.team-grid small{font-size:.9rem;line-height:1.5}@media(max-width:759px){.metric-grid,.contact-topic-grid{grid-template-columns:1fr}.snapshot-heading{grid-template-columns:1fr}}

/* Dedicated editorial layout for the organisation profile. */
.about-hero{padding:3rem 0;background:#edf1e7}.about-opening,.profile-grid,.approach-grid,.closing-grid{display:grid;gap:2rem;align-items:center}.about-opening h1{font-size:clamp(2.3rem,4vw,3.8rem);max-width:18ch;line-height:1.06}.about-opening figure,.approach-grid figure{margin:0}.about-opening img{aspect-ratio:4/3;object-fit:cover;border-radius:2rem 5rem 2rem 2rem}.about-opening figcaption,.approach-grid figcaption{font-size:.8rem;color:var(--muted);padding:.7rem .2rem}.about-jumps{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.5rem}.about-jumps a{display:inline-flex;align-items:center;min-height:44px;padding:.55rem .9rem;border:1px solid #becdbb;border-radius:999px;font-size:.85rem;font-weight:700;text-decoration:none;background:#ffffff90}.about-jumps a:hover{background:white}.about-profile{background:white}.profile-grid h2{max-width:22ch}.profile-grid p,.approach-grid p,.closing-grid p{color:var(--muted)}.about-facts{display:flex;gap:2.5rem;margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--line)}.about-facts>div{display:grid;gap:.25rem}.about-facts strong{font-size:1.8rem;letter-spacing:-.04em}.about-facts span{font-size:.8rem;color:var(--muted)}.purpose{background:var(--forest-950);color:white}.purpose .eyebrow{color:#b8d6a3}.vision{max-width:64rem}.vision h2{font-size:clamp(1.6rem,2.6vw,2.5rem);font-weight:600;line-height:1.3;letter-spacing:-.025em}.mission-heading{margin-top:2rem;padding-top:1.5rem;border-top:1px solid #ffffff30}.mission-heading h3{font-size:.9rem;color:#bed6bc}.missions{display:grid;gap:1.5rem}.missions article{padding:1rem 0}.missions span{font-size:.85rem;color:#bdd79d}.missions h3{font-size:1.2rem;margin:.75rem 0}.missions p{font-size:.95rem;color:#dfebdf;margin:0}.approach-grid img{aspect-ratio:4/3;object-fit:cover;border-radius:3rem 1rem 3rem 1rem}.approach-grid h2{max-width:22ch}.team{background:white}.team h2{max-width:28ch}.team-group{margin-top:2rem}.team-group>h3{font-size:.85rem;letter-spacing:.05em}.team-grid{gap:1rem}.team-grid article{display:flex;align-items:flex-start;gap:1rem;padding:1.2rem;background:#f4f6ef;border:1px solid #e7ecdf;border-radius:1.2rem}.team-grid img{flex:0 0 5.5rem;width:5.5rem;height:5.5rem;aspect-ratio:1;object-fit:cover;object-position:top;border-radius:50%;background:#e4ebdd}.team-grid article>div{padding:.35rem 0;min-width:0}.team-grid h4{font-size:1.08rem;line-height:1.3}.team-grid p{font-size:.85rem;line-height:1.4}.member-bio{margin-top:.7rem}.member-bio summary{font-size:.8rem;cursor:pointer;color:var(--forest-800);padding:.3rem 0}.member-bio small{line-height:1.55}.closing-grid{align-items:start}.closing-grid h2{max-width:23ch}.closing-grid aside{padding:1.5rem;border-radius:1.2rem;background:#e7ede1}.closing-grid aside h3{font-size:1.1rem}.closing-grid aside p:last-child{font-size:.9rem;line-height:1.65}
@media(min-width:760px){.about-opening{grid-template-columns:1fr 1fr;gap:3rem}.profile-grid{grid-template-columns:.9fr 1.1fr;gap:4rem}.missions{grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}.approach-grid{grid-template-columns:1fr 1fr;gap:4rem}.closing-grid{grid-template-columns:1.2fr 1fr;gap:4rem}.team-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:759px){.about-hero{padding:2rem 0}.about-opening img{aspect-ratio:3/2;border-radius:1rem 3rem 1rem 1rem}.about-facts{gap:1.5rem}.team-grid{grid-template-columns:1fr}.team-grid img{width:4.5rem;height:4.5rem;flex-basis:4.5rem}.team-grid article{padding:1rem}.missions{gap:.5rem}.approach-grid img{aspect-ratio:3/2}}
</style>

