---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import { organisation, pageContent, type Lang } from '../data/site';
const {lang,page}=Astro.props as {lang:Lang,page:string};
const data=(pageContent as any)[lang][page];
const isAbout=page==='tentang-kami'||page==='about';
const isLocations=page==='lokasi-kerja'||page==='where-we-work';
const isContact=page==='hubungi-kami'||page==='contact';
const ownTeam=await getCollection('team',({data})=>data.language===lang&&data.status==='published');
const team=(ownTeam.length?ownTeam:await getCollection('team',({data})=>data.language==='id'&&data.status==='published')).sort((a,b)=>a.data.order-b.data.order);
const ownLocations=await getCollection('locations',({data})=>data.language===lang&&data.status==='published'&&Boolean(data.legacyCategorySlug));
const fallbackLocations=lang==='en'&&!ownLocations.length?await getCollection('locations',({data})=>data.language==='id'&&data.status==='published'&&Boolean(data.legacyCategorySlug)):[];
const locations=(ownLocations.length?ownLocations:fallbackLocations).sort((a,b)=>a.data.order-b.data.order);
const locationFallback=lang==='en'&&!ownLocations.length;
const groups=['Governance','Management & Program Team','Technical Advisors'] as const;
const groupLabels={
  Governance:{id:'Pendiri dan Pengawas',en:'Founders and Supervisory Board'},
  'Management & Program Team':{id:'Tim Inti',en:'Core Team'},
  'Technical Advisors':{id:'Penasihat Teknis',en:'Technical Advisors'},
} as const;
---
<ContentLayout title={data.title} intro={data.intro} eyebrow={isAbout?(lang==='id'?'Memetakan aksi. Merekam perubahan.':'Mapping action. Recording change.'):undefined}>
  <section class="section"><div class="container info-grid">{data.sections.map((section:string[],index:number)=><article id={section[0].toLowerCase().replaceAll(' ','-').replace(/[^a-z0-9-]/g,'')}><span>{String(index+1).padStart(2,'0')}</span><div><h2>{section[0]}</h2>{section[0]==='Email'?<p><a href={`mailto:${section[1]}`}>{section[1]}</a></p>:<p>{section[1]}</p>}</div></article>)}</div></section>

  {isAbout&&<section class="team section" id="tim"><div class="container"><p class="eyebrow">{lang==='id'?'Tim Kami':'Our Team'}</p><h2>{lang==='id'?'Orang-orang di balik kerja Yayasan Gambut':'The people behind Yayasan Gambut'}</h2>{groups.map(group=><div class="team-group"><h3>{groupLabels[group][lang]}</h3><div class="team-grid">{team.filter(member=>member.data.group===group).map(member=><article>{member.data.photo&&<img src={member.data.photo} width="500" height="500" loading="lazy" decoding="async" alt=""/>}<div><h4>{member.data.name}</h4><p>{lang==='en'?(member.data.positionEn??member.data.position):member.data.position}</p>{member.data.bio&&<small lang={lang==='en'?'id':undefined}>{member.data.bio}</small>}</div></article>)}</div></div>)}</div></section>}

  {isLocations&&<section class="locations section" id="arsip-lokasi"><div class="container"><div class="portal-card"><div><p class="eyebrow">{lang==='id'?'Peta dan data program':'Program maps and data'}</p><h2>{lang==='id'?'Jelajahi YG GeoPortal':'Explore the YG GeoPortal'}</h2><p>{lang==='id'?'Lihat lokasi intervensi, objek program, pemantauan terverifikasi, serta lapisan tematik yang diperbarui melalui proses peninjauan data.':'View intervention locations, program objects, verified monitoring, and thematic layers updated through a data-review process.'}</p></div><a class="button primary" href="https://webgisyg.id/webgis.html" target="_blank" rel="noreferrer">{lang==='id'?'Buka peta interaktif ↗':'Open the interactive map ↗'}</a></div><div class="archive-heading"><p class="eyebrow">{lang==='id'?'Arsip cerita berdasarkan lokasi':'Field-story archive by location'}</p><h2>{lang==='id'?'Telusuri lokasi dalam arsip publik':'Explore locations in the public archive'}</h2><p class="archive-note">{lang==='id'?'Arsip terpilih ini menghubungkan kategori lokasi dari situs sebelumnya dengan cerita lapangan. Jumlah artikel dapat berubah ketika arsip diperbarui.':'This curated archive connects earlier location categories with Indonesian-language field stories. Article totals may change as the archive is updated.'}</p></div>{locationFallback&&<p class="archive-note" lang="id">Locations are shown in their original Indonesian-language form.</p>}<div class="location-list">{locations.map(location=><article lang={locationFallback?'id':undefined}><h3>{location.data.name}</h3><p>{location.data.summary}</p><a class="text-link" href={`/id/cerita/?category=${location.data.legacyCategorySlug}`} hreflang="id" aria-label={lang==='id'?`Lihat cerita terkait ${location.data.name}`:`View Indonesian-language stories related to ${location.data.name}`}>{lang==='id'?'Lihat cerita terkait':'View related stories in Indonesian'}</a></article>)}</div></div></section>}

  {isContact&&<section class="contact-band"><div class="container"><p class="eyebrow">{lang==='id'?'Kanal resmi':'Official channels'}</p><div class="contact-links"><a href={`mailto:${organisation.email}`}>{organisation.email}</a><a href={organisation.facebook} target="_blank" rel="noreferrer">Facebook ↗</a><a href={organisation.instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href={organisation.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a href={organisation.youtube} target="_blank" rel="noreferrer">YouTube ↗</a></div><p>{lang==='id'?'Silakan gunakan email resmi di atas untuk seluruh pertanyaan dan kebutuhan kolaborasi.':'Please use the official email above for enquiries and collaboration requests.'}</p></div></section>}
</ContentLayout>
<style>
  .info-grid{border-top:1px solid var(--line)}.info-grid>article{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:2rem 0;border-bottom:1px solid var(--line)}.info-grid>article>span{color:var(--coast-700);font-weight:800}.info-grid h2{font-size:clamp(1.7rem,3vw,3rem)}.info-grid p{max-width:55rem;color:var(--muted)}
  .team{background:#dce8e6}.team h2,.locations h2{max-width:15ch}.archive-note{max-width:48rem;color:var(--muted)}.team-group{margin-top:3rem}.team-group>h3{padding-bottom:.8rem;border-bottom:1px solid var(--line);font-size:.8rem;letter-spacing:.12em;text-transform:uppercase}.team-grid{display:grid;gap:1rem}.team-grid article{overflow:hidden;border-radius:var(--radius-md);background:var(--paper-bright)}.team-grid img{aspect-ratio:1;object-fit:cover;object-position:top}.team-grid article>div{padding:1rem}.team-grid h4{margin:0;font:500 1.35rem/1.1 var(--serif)}.team-grid p{margin:.45rem 0 0;color:var(--coast-700);font-size:.82rem;font-weight:750}.team-grid small{display:block;margin-top:.6rem;color:var(--muted)}
  .locations{background:#dce8e6}.portal-card{display:grid;gap:2rem;align-items:end;padding:clamp(1.5rem,4vw,3rem);border-radius:var(--radius-lg);background:var(--paper-bright)}.portal-card h2{margin-bottom:1rem}.portal-card p:not(.eyebrow){max-width:50rem;color:var(--muted)}.portal-card .button{width:fit-content}.archive-heading{margin-top:clamp(4rem,8vw,7rem)}.location-list{display:grid;gap:1rem;margin-top:2.5rem}.location-list article{display:flex;flex-direction:column;padding:1.4rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright)}.location-list h3{font:500 1.5rem/1.1 var(--serif)}.location-list p{color:var(--muted)}.location-list .text-link{margin-top:auto;padding-top:.75rem}.contact-band{padding:4rem 0;background:var(--coast-700);color:white}.contact-band .eyebrow{color:#cde8ed}.contact-links{display:flex;flex-wrap:wrap;gap:.75rem;margin-bottom:1rem}.contact-links a{padding:.65rem 1rem;border:1px solid rgba(255,255,255,.4);border-radius:999px;text-decoration:none;font-weight:750}.contact-band p:last-child{color:rgba(255,255,255,.72)}
  @media(min-width:640px){.team-grid{grid-template-columns:repeat(2,1fr)}.location-list{grid-template-columns:repeat(2,1fr)}}
  @media(min-width:760px){.info-grid>article{grid-template-columns:6rem 1fr;padding:3rem 0}.portal-card{grid-template-columns:1fr auto}}
  @media(min-width:1040px){.team-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.location-list{grid-template-columns:repeat(3,1fr)}}
</style>
