---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import { impactSnapshot, organisation, pageContent, type Lang } from '../data/site';
const {lang,page}=Astro.props as {lang:Lang,page:string};
const data=(pageContent as any)[lang][page];
const isAbout=page==='tentang-kami'||page==='about';
const isLocations=page==='lokasi-kerja'||page==='where-we-work';
const isImpact=page==='dampak'||page==='impact';
const isContact=page==='hubungi-kami'||page==='contact';
const contactTopics={
  id:[
    {title:'Kemitraan dan program',body:'Untuk peluang kolaborasi, dukungan program, kegiatan bersama, dan pengembangan lokasi kerja.',subject:'Kemitraan dan program — Yayasan Gambut'},
    {title:'Riset, data, dan publikasi',body:'Untuk pertanyaan mengenai riset, data publik, YG GeoPortal, laporan, atau bahan pembelajaran.',subject:'Riset, data, dan publikasi — Yayasan Gambut'},
    {title:'Media dan informasi umum',body:'Untuk permintaan informasi organisasi, wawancara, dokumentasi, atau komunikasi publik.',subject:'Media dan informasi umum — Yayasan Gambut'},
  ],
  en:[
    {title:'Partnerships and programs',body:'For collaboration opportunities, program support, joint activities, and work-site development.',subject:'Partnerships and programs — Yayasan Gambut'},
    {title:'Research, data, and publications',body:'For enquiries about research, public data, the YG GeoPortal, reports, or learning resources.',subject:'Research, data, and publications — Yayasan Gambut'},
    {title:'Media and general information',body:'For organisational information, interviews, documentation, or public communications.',subject:'Media and general information — Yayasan Gambut'},
  ],
} as const;
const offices={
  id:[{title:'Kantor Operasional Pekanbaru',role:'Koordinasi program dan kegiatan lapangan di Riau',address:organisation.pekanbaruOffice},{title:'Kantor Pusat Tangerang Selatan',role:'Administrasi organisasi dan koordinasi kelembagaan',address:organisation.headOffice}],
  en:[{title:'Pekanbaru Operational Office',role:'Program coordination and field activities in Riau',address:organisation.pekanbaruOffice},{title:'South Tangerang Head Office',role:'Organisational administration and institutional coordination',address:organisation.headOffice}],
} as const;
const ownTeam=await getCollection('team',({data})=>data.language===lang&&data.status==='published');
const team=(ownTeam.length?ownTeam:await getCollection('team',({data})=>data.language==='id'&&data.status==='published')).sort((a,b)=>a.data.order-b.data.order);
const ownLocations=await getCollection('locations',({data})=>data.language===lang&&data.status==='published'&&Boolean(data.legacyCategorySlug));
const fallbackLocations=lang==='en'&&!ownLocations.length?await getCollection('locations',({data})=>data.language==='id'&&data.status==='published'&&Boolean(data.legacyCategorySlug)):[];
const locations=(ownLocations.length?ownLocations:fallbackLocations).sort((a,b)=>a.data.order-b.data.order);
const locationFallback=lang==='en'&&!ownLocations.length;
const groups=['Governance','Management & Program Team','Technical Advisors'] as const;
const groupLabels={
  Governance:{id:'Pendiri dan Pengawas',en:'Founders and Supervisory Board'},
  'Management & Program Team':{id:'Tim Inti',en:'Core Team'},
  'Technical Advisors':{id:'Penasihat Teknis',en:'Technical Advisors'},
} as const;
---
<ContentLayout title={data.title} intro={data.intro} eyebrow={isAbout?(lang==='id'?'Memetakan aksi. Merekam perubahan.':'Mapping action. Recording change.'):undefined}>
  {!isContact&&<section class="section"><div class="container info-grid">{data.sections.map((section:string[],index:number)=><article id={section[0].toLowerCase().replaceAll(' ','-').replace(/[^a-z0-9-]/g,'')}><span>{String(index+1).padStart(2,'0')}</span><div><h2>{section[0]}</h2>{section[0]==='Email'?<p><a href={`mailto:${section[1]}`}>{section[1]}</a></p>:<p>{section[1]}</p>}</div></article>)}</div></section>}

  {isAbout&&<section class="team section" id="tim"><div class="container"><p class="eyebrow">{lang==='id'?'Tim Kami':'Our Team'}</p><h2>{lang==='id'?'Orang-orang di balik kerja Yayasan Gambut':'The people behind Yayasan Gambut'}</h2>{groups.map(group=><div class="team-group"><h3>{groupLabels[group][lang]}</h3><div class="team-grid">{team.filter(member=>member.data.group===group).map(member=><article>{member.data.photo&&<img src={member.data.photo} width="500" height="500" loading="lazy" decoding="async" alt=""/>}<div><h4>{member.data.name}</h4><p>{lang==='en'?(member.data.positionEn??member.data.position):member.data.position}</p>{member.data.bio&&<small lang={lang==='en'?'id':undefined}>{member.data.bio}</small>}</div></article>)}</div></div>)}</div></section>}

  {isLocations&&<section class="locations section" id="arsip-lokasi"><div class="container"><div class="portal-card"><div><p class="eyebrow">{lang==='id'?'Peta dan data program':'Program maps and data'}</p><h2>{lang==='id'?'Jelajahi YG GeoPortal':'Explore the YG GeoPortal'}</h2><p>{lang==='id'?'Lihat lokasi intervensi, objek program, pemantauan terverifikasi, serta lapisan tematik yang diperbarui melalui proses peninjauan data.':'View intervention locations, program objects, verified monitoring, and thematic layers updated through a data-review process.'}</p></div><a class="button primary" href="https://webgisyg.id/webgis.html" target="_blank" rel="noreferrer">{lang==='id'?'Buka peta interaktif ↗':'Open the interactive map ↗'}</a></div><div class="archive-heading"><p class="eyebrow">{lang==='id'?'Arsip cerita berdasarkan lokasi':'Field-story archive by location'}</p><h2>{lang==='id'?'Telusuri lokasi dalam arsip publik':'Explore locations in the public archive'}</h2><p class="archive-note">{lang==='id'?'Arsip terpilih ini menghubungkan kategori lokasi dari situs sebelumnya dengan cerita lapangan. Jumlah artikel dapat berubah ketika arsip diperbarui.':'This curated archive connects earlier location categories with Indonesian-language field stories. Article totals may change as the archive is updated.'}</p></div>{locationFallback&&<p class="archive-note" lang="id">Locations are shown in their original Indonesian-language form.</p>}<div class="location-list">{locations.map(location=><article lang={locationFallback?'id':undefined}><h3>{location.data.name}</h3><p>{location.data.summary}</p><a class="text-link" href={`/id/cerita/?category=${location.data.legacyCategorySlug}`} hreflang="id" aria-label={lang==='id'?`Lihat cerita terkait ${location.data.name}`:`View Indonesian-language stories related to ${location.data.name}`}>{lang==='id'?'Lihat cerita terkait':'View related stories in Indonesian'}</a></article>)}</div></div></section>}

  {isImpact&&<section class="impact-snapshot section" id="snapshot-bukti"><div class="container"><div class="snapshot-heading"><div><p class="eyebrow">{lang==='id'?'Snapshot bukti publik':'Public evidence snapshot'}</p><h2>{lang==='id'?'Angka yang dapat ditelusuri ke sumbernya':'Figures traceable to their sources'}</h2></div><p>{lang==='id'?`Ditinjau ${impactSnapshot.reviewedAt}. Snapshot sumber dibuat ${impactSnapshot.sourceGeneratedAt}.`:`Reviewed ${impactSnapshot.reviewedAt}. Source snapshot generated ${impactSnapshot.sourceGeneratedAt}.`}</p></div><dl class="metric-grid">{impactSnapshot[lang].map(metric=><div><dt>{metric.label}</dt><dd>{metric.value}</dd><p>{metric.note}</p><a class="text-link" href={metric.href} target="_blank" rel="noreferrer">{lang==='id'?'Periksa sumber ↗':'Check source ↗'}<span class="sr-only"> — {metric.label}</span></a></div>)}</dl><div class="evidence-note"><p>{lang==='id'?'Angka ini menunjukkan cakupan bukti yang telah dipublikasikan, bukan klaim dampak akhir. Nilai dapat berubah ketika data baru selesai diverifikasi.':'These figures describe the coverage of published evidence, not a claim of final impact. Values may change as new data completes verification.'}</p><a class="button primary" href="https://webgisyg.id/" target="_blank" rel="noreferrer">{lang==='id'?'Jelajahi YG GeoPortal ↗':'Explore the YG GeoPortal ↗'}</a></div></div></section>}

  {isContact&&<><section class="contact-main section"><div class="container"><div class="contact-intro"><div><p class="eyebrow">{lang==='id'?'Satu alamat email resmi':'One official email address'}</p><h2>{organisation.email}</h2></div><a class="button primary" href={`mailto:${organisation.email}`}>{lang==='id'?'Kirim email':'Send an email'}</a></div><p class="contact-guidance">{lang==='id'?'Agar pesan dapat diteruskan kepada tim yang tepat, pilih tujuan berikut dan sertakan nama organisasi, lokasi, tujuan, serta kebutuhan Anda.':'Choose the relevant purpose below and include your organisation, location, objective, and request so the message can be directed to the appropriate team.'}</p><div class="contact-topic-grid">{contactTopics[lang].map(topic=><article><h3>{topic.title}</h3><p>{topic.body}</p><a class="text-link" href={`mailto:${organisation.email}?subject=${encodeURIComponent(topic.subject)}`}>{lang==='id'?'Tulis email':'Compose email'}</a></article>)}</div></div></section><section class="office-section section"><div class="container"><p class="eyebrow">{lang==='id'?'Alamat kantor':'Office addresses'}</p><h2>{lang==='id'?'Temui kami di kantor resmi':'Find our official offices'}</h2><div class="office-grid">{offices[lang].map(office=><article><h3>{office.title}</h3><p class="office-role">{office.role}</p><address>{office.address}</address><a class="text-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(office.address)}`} target="_blank" rel="noreferrer">{lang==='id'?'Cari di Google Maps ↗':'Find on Google Maps ↗'}</a></article>)}</div></div></section></>}

  {isContact&&<section class="contact-band"><div class="container"><p class="eyebrow">{lang==='id'?'Kanal resmi':'Official channels'}</p><div class="contact-links"><a href={`mailto:${organisation.email}`}>{organisation.email}</a><a href={organisation.facebook} target="_blank" rel="noreferrer">Facebook ↗</a><a href={organisation.instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href={organisation.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a href={organisation.youtube} target="_blank" rel="noreferrer">YouTube ↗</a></div><p>{lang==='id'?'Jangan kirim kata sandi, data keuangan, atau dokumen identitas melalui pesan media sosial. Gunakan email resmi untuk korespondensi organisasi.':'Do not send passwords, financial information, or identity documents through social-media messages. Use the official email address for organisational correspondence.'}</p></div></section>}
</ContentLayout>
<style>
  .info-grid{border-top:1px solid var(--line)}.info-grid>article{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:2rem 0;border-bottom:1px solid var(--line)}.info-grid>article>span{color:var(--coast-700);font-weight:800}.info-grid h2{font-size:clamp(1.7rem,3vw,3rem)}.info-grid p{max-width:55rem;color:var(--muted)}
  .team{background:#dce8e6}.team h2,.locations h2{max-width:15ch}.archive-note{max-width:48rem;color:var(--muted)}.team-group{margin-top:3rem}.team-group>h3{padding-bottom:.8rem;border-bottom:1px solid var(--line);font-size:.8rem;letter-spacing:.12em;text-transform:uppercase}.team-grid{display:grid;gap:1rem}.team-grid article{overflow:hidden;border-radius:var(--radius-md);background:var(--paper-bright)}.team-grid img{aspect-ratio:1;object-fit:cover;object-position:top}.team-grid article>div{padding:1rem}.team-grid h4{margin:0;font:500 1.35rem/1.1 var(--serif)}.team-grid p{margin:.45rem 0 0;color:var(--coast-700);font-size:.82rem;font-weight:750}.team-grid small{display:block;margin-top:.6rem;color:var(--muted)}
  .locations{background:#dce8e6}.portal-card{display:grid;gap:2rem;align-items:end;padding:clamp(1.5rem,4vw,3rem);border-radius:var(--radius-lg);background:var(--paper-bright)}.portal-card h2{margin-bottom:1rem}.portal-card p:not(.eyebrow){max-width:50rem;color:var(--muted)}.portal-card .button{width:fit-content}.archive-heading{margin-top:clamp(4rem,8vw,7rem)}.location-list{display:grid;gap:1rem;margin-top:2.5rem}.location-list article{display:flex;flex-direction:column;padding:1.4rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright)}.location-list h3{font:500 1.5rem/1.1 var(--serif)}.location-list p{color:var(--muted)}.location-list .text-link{margin-top:auto;padding-top:.75rem}.contact-band{padding:4rem 0;background:var(--coast-700);color:white}.contact-band .eyebrow{color:#cde8ed}.contact-links{display:flex;flex-wrap:wrap;gap:.75rem;margin-bottom:1rem}.contact-links a{padding:.65rem 1rem;border:1px solid rgba(255,255,255,.4);border-radius:999px;text-decoration:none;font-weight:750}.contact-band p:last-child{color:rgba(255,255,255,.72)}
  .impact-snapshot{background:#dce8e6}.snapshot-heading{display:grid;gap:1.5rem;align-items:end}.snapshot-heading h2{max-width:15ch}.snapshot-heading>p{max-width:34rem;color:var(--muted)}.metric-grid{display:grid;gap:1rem;margin:2.5rem 0 0}.metric-grid>div{display:flex;flex-direction:column;padding:1.5rem;border-radius:var(--radius-md);background:var(--paper-bright)}.metric-grid dt{order:2;margin-top:.45rem;color:var(--coast-700);font-size:.82rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.metric-grid dd{order:1;margin:0;font:500 clamp(3rem,8vw,5.5rem)/.9 var(--serif)}.metric-grid p{order:3;color:var(--muted)}.metric-grid a{order:4;margin-top:auto;padding-top:.75rem}.evidence-note{display:grid;gap:1.5rem;align-items:center;margin-top:1rem;padding:1.5rem;border:1px solid var(--line);border-radius:var(--radius-md)}.evidence-note p{margin:0;max-width:55rem;color:var(--muted)}.evidence-note .button{width:fit-content}
  .contact-main{background:var(--paper-bright)}.contact-intro{display:grid;gap:1.5rem;align-items:end}.contact-intro h2{font-size:clamp(1.7rem,4vw,3.8rem);overflow-wrap:anywhere}.contact-intro .button{width:fit-content}.contact-guidance{max-width:54rem;margin:1.5rem 0 2.5rem;color:var(--muted)}.contact-topic-grid,.office-grid{display:grid;gap:1rem}.contact-topic-grid article,.office-grid article{display:flex;flex-direction:column;padding:1.5rem;border:1px solid var(--line);border-radius:var(--radius-md)}.contact-topic-grid h3,.office-grid h3{font:500 1.55rem/1.1 var(--serif)}.contact-topic-grid p,.office-grid p,.office-grid address{color:var(--muted)}.contact-topic-grid a,.office-grid a{margin-top:auto;padding-top:1rem}.office-section{background:#dce8e6}.office-section>div>h2{max-width:14ch}.office-grid{margin-top:2.5rem}.office-grid article{background:var(--paper-bright)}.office-role{font-weight:750}.office-grid address{font-style:normal}
  @media(min-width:640px){.team-grid{grid-template-columns:repeat(2,1fr)}.location-list{grid-template-columns:repeat(2,1fr)}.metric-grid,.contact-topic-grid{grid-template-columns:repeat(3,1fr)}.office-grid{grid-template-columns:repeat(2,1fr)}}
  @media(min-width:760px){.info-grid>article{grid-template-columns:6rem 1fr;padding:3rem 0}.portal-card,.snapshot-heading,.evidence-note,.contact-intro{grid-template-columns:1fr auto}}
  @media(min-width:1040px){.team-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.location-list{grid-template-columns:repeat(3,1fr)}}
</style>
