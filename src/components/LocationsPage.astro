---
import { getCollection } from 'astro:content';
import { pageContent, type Lang } from '../data/site';
const {lang}=Astro.props as {lang:Lang};
const id=lang==='id'; const t=(a:string,b:string)=>id?a:b;
const sections=pageContent[lang][id?'lokasi-kerja':'where-we-work'].sections.slice(0,4);
const regions=[
 {key:'bengkalis',name:'Bengkalis',lat:1.48,lng:102.12,photo:'/wp-content/uploads/2024/01/DJI_0056.jpg',caption:t('Bentang mangrove di Buruk Bakul','Mangrove landscape in Buruk Bakul'),villages:'Buruk Bakul · Kelapa Pati · Sepahat · Temiang · Penampi',focus:t('Mangrove · Gambut · Agroforestri','Mangroves · Peatlands · Agroforestry')},
 {key:'siak',name:'Siak',lat:.82,lng:102.03,photo:'/wp-content/uploads/2024/01/IMG-20240105-WA0023.jpg',caption:t('Dokumentasi program agroforestri kopi di Bengkalis dan Siak','Coffee agroforestry program documentation in Bengkalis and Siak'),villages:'Tanjung Kuras · Dayun',focus:t('Perhutanan sosial · Agroforestri · Pesisir','Social forestry · Agroforestry · Coasts')},
 {key:'rokan-hilir',name:'Rokan Hilir',lat:2.10,lng:100.82,photo:'/wp-content/uploads/2020/12/Nipah-Rohil.jpeg',caption:t('Hutan nipah di Rokan Hilir','Nipa palm forest in Rokan Hilir'),villages:'Siarang Arang · Teluk Piyai Pesisir · Panipahan Laut · Labuhan Tangga',focus:t('Mangrove · Gambut · Penghidupan','Mangroves · Peatlands · Livelihoods')},
 {key:'kampar',name:'Kampar',lat:.34,lng:101.02,photo:'',caption:'',villages:'Hutan Adat Ghimbo Pomuan',focus:t('Hutan adat · Agroforestri kopi','Customary forest · Coffee agroforestry')}
];
const articles=(await getCollection('articles',({data})=>data.language===lang&&data.status==='published')).filter(a=>/bengkalis|siak|rokan|kampar|buruk bakul|temiang|sepahat|tanjung kuras/i.test(a.data.title+' '+a.data.summary)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<section class="location-intro container"><p class="eyebrow">{t('Bentang alam · Masyarakat · Kolaborasi','Landscapes · Communities · Collaboration')}</p><h1>{t('Wilayah Kerja','Where We Work')}</h1><p>{t('Dari pesisir mangrove hingga lahan gambut di Riau, kami bekerja bersama masyarakat untuk menjaga ekosistem dan memperkuat penghidupan.','From mangrove coasts to the peatlands of Riau, we work with communities to protect ecosystems and strengthen livelihoods.')}</p></section>
<section class="map-section"><div class="container"><div class="map-tools"><nav aria-label={t('Pilih wilayah','Choose a region')}><a href="#region-map" data-region="all" aria-current="true">{t('Semua wilayah','All regions')}</a>{regions.map(r=><a href={'#'+r.key} data-region={r.key}>{r.name}</a>)}</nav><a class="text-link external" href="https://webgisyg.id/webgis.html" target="_blank" rel="noreferrer">{t('Buka peta lengkap','Open full map')}</a></div><div id="region-map" role="region" aria-label={t('Peta ringkasan wilayah kerja Riau','Riau work-area overview map')} data-regions={JSON.stringify(regions.map(({key,name,lat,lng})=>({key,name,lat,lng})))}><p class="map-fallback">{t('Peta wilayah kerja. Profil setiap wilayah tersedia di bawah.','Work-area map. Explore each region below.')}</p></div><p class="map-caption">{t('Penanda menunjukkan wilayah kabupaten. Lokasi kegiatan dapat ditelusuri pada peta lengkap.','Markers represent regencies. Explore activity locations on the full map.')}</p></div></section>
<section class="profiles container"><div class="section-heading"><div><p class="eyebrow">{t('Kerja bersama di tingkat tapak','Working together on the ground')}</p><h2>{t('Kenali wilayah dan fokus kerja kami.','Explore our regions and areas of work.')}</h2></div></div>{regions.map((r,i)=><article class:list={['region-profile',{'text-profile':!r.photo}]} id={r.key}>{r.photo&&<figure><img src={r.photo} width="900" height="600" loading="lazy" alt={r.caption}/><figcaption>{r.caption}</figcaption></figure>}<div class="region-copy"><p class="eyebrow">{r.focus}</p><h2>{r.name}</h2><p>{sections[i][1]}</p><p class="villages">{r.villages}</p><a class="text-link" href={id?'/id/program/':'/en/programs/'}>{t('Kenali program kami','Explore our programs')}</a></div></article>)}</section>
{articles.length>0&&<section class="field-stories"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t('Cerita lapangan','Field stories')}</p><h2>{t('Kabar dari wilayah kerja.','Stories from our landscapes.')}</h2></div><a class="text-link" href={id?'/id/cerita/':'/en/field-stories/'}>{t('Semua cerita','All stories')}</a></div><div class="story-grid">{articles.map(a=><a href={`/${lang}/${id?'cerita':'field-stories'}/${a.data.slug}/`}>{a.data.featuredImage&&<img src={a.data.featuredImage} width="600" height="400" loading="lazy" alt={a.data.imageAlt||a.data.title}/>}<h3>{a.data.title}</h3><span>{t('Baca cerita →','Read story →')}</span></a>)}</div></div></section>}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
(()=>{const el=document.getElementById('region-map');if(!el||!window.L)return;el.replaceChildren();const rows=JSON.parse(el.dataset.regions);const map=L.map(el,{scrollWheelZoom:false}).fitBounds([[.05,100.35],[2.55,102.65]]);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:15,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'}).addTo(map);const markers={};rows.forEach(r=>{markers[r.key]=L.circleMarker([r.lat,r.lng],{radius:9,color:'#fff',weight:3,fillColor:'#145448',fillOpacity:1}).addTo(map).bindTooltip(r.name,{permanent:true,direction:'top'}).on('click',()=>document.getElementById(r.key)?.scrollIntoView({behavior:'smooth',block:'start'}));});document.querySelectorAll('[data-region]').forEach(a=>a.addEventListener('click',()=>{document.querySelectorAll('[data-region]').forEach(b=>b.removeAttribute('aria-current'));a.setAttribute('aria-current','true');if(a.dataset.region==='all')map.fitBounds([[.05,100.35],[2.55,102.65]]);else{const r=rows.find(r=>r.key===a.dataset.region);map.setView([r.lat,r.lng],9);}}));})();
</script>
<style>
.location-intro{padding-block:2.5rem 2rem}.location-intro h1{font-size:clamp(2.4rem,4vw,3.5rem);margin-bottom:.8rem}.location-intro>p:last-child{max-width:48rem;color:var(--muted);margin-bottom:0}.eyebrow{color:var(--peat-700)}.map-section{background:var(--water-pale,#edf6f8);padding:1.5rem 0}.map-tools{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem}.map-tools nav{display:flex;flex-wrap:wrap;gap:.5rem}.map-tools nav a{padding:.6rem .85rem;border:1px solid #cbdcda;border-radius:2rem;text-decoration:none;font-size:.85rem;background:#ffffff90}.map-tools nav a[aria-current]{background:var(--forest-950);color:#fff;border-color:var(--forest-950)}.map-tools>.text-link{flex-shrink:0}#region-map{height:420px;border:1px solid #cfddda;border-radius:1rem;isolation:isolate;background:#e1edeb;z-index:0}.map-fallback{padding:2rem}.map-caption{font-size:.78rem;color:var(--muted);margin:.7rem 0 0}.profiles{padding-block:3rem}.profiles .section-heading{margin-bottom:2rem}.region-profile{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;padding:2rem 0;border-top:1px solid var(--line);scroll-margin-top:6rem}.region-profile figure{margin:0}.region-profile img{aspect-ratio:16/10;object-fit:cover;border-radius:.8rem}.region-profile figcaption{font-size:.72rem;color:var(--muted);margin-top:.5rem}.region-copy h2{font-size:2rem;margin-bottom:1rem}.region-copy>p:not(.eyebrow){color:var(--muted)}.villages{border-left:3px solid var(--coast-300);padding-left:1rem;font-size:.85rem}.text-profile{grid-template-columns:1fr;background:#eef2e9;border:0;border-radius:1rem;padding:2rem;margin-top:1rem}.text-profile .region-copy{max-width:55rem}.field-stories{padding:3rem 0;background:#f0f3eb}.story-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}.story-grid>a{text-decoration:none}.story-grid img{aspect-ratio:3/2;object-fit:cover;border-radius:.7rem}.story-grid h3{font-size:1.1rem;line-height:1.4;margin:1rem 0}.story-grid span{font-size:.85rem;font-weight:700;color:var(--forest-650)}
@media(max-width:800px){.map-tools{align-items:start;flex-direction:column}.region-profile{gap:1.5rem}.story-grid{gap:1rem}}
@media(max-width:600px){.location-intro{padding-block:1.75rem}.region-profile,.story-grid{grid-template-columns:1fr}.region-profile{padding-block:1.5rem}.text-profile{padding:1.5rem}#region-map{height:330px}.map-tools nav a{font-size:.78rem;padding:.5rem .7rem}.story-grid{gap:2rem}}
</style>
