---
import { organisation, type Lang } from '../data/site';
const {lang}=Astro.props as {lang:Lang};
const t=(a:string,b:string)=>lang==='id'?a:b;
const officeMap='https://maps.app.goo.gl/9XfdFBjc3ZXpnsSY8';
const topics=[
 {n:'01',title:t('Kemitraan & program','Partnerships & programs'),body:t('Bicarakan peluang kerja sama, dukungan program, dan kegiatan bersama.','Discuss collaboration opportunities, program support, and joint activities.')},
 {n:'02',title:t('Riset & pengetahuan','Research & knowledge'),body:t('Hubungi kami untuk riset, data publik, publikasi, dan pertukaran pembelajaran.','Get in touch about research, public data, publications, and shared learning.')},
 {n:'03',title:t('Media & informasi','Media & information'),body:t('Sampaikan permintaan wawancara, dokumentasi, atau informasi organisasi.','Ask about interviews, documentation, or organisational information.')},
];
const channels=[['Instagram',organisation.instagram],['LinkedIn',organisation.linkedin],['Facebook',organisation.facebook],['YouTube',organisation.youtube]];
---
<section class="contact-opening"><div class="container opening-grid"><div><p class="eyebrow">{t('Terhubung dengan Yayasan Gambut','Connect with Yayasan Gambut')}</p><h1>{t('Hubungi Kami','Contact Us')}</h1><p class="opening-copy">{t('Mari bekerja bersama untuk menjaga ekosistem dan memperkuat penghidupan masyarakat.','Let’s work together to protect ecosystems and strengthen community livelihoods.')}</p></div><aside class="email-card"><p class="eyebrow">{t('Email resmi','Official email')}</p><a class="email-address" href={`mailto:${organisation.email}`}>{organisation.email}</a><p>{t('Untuk pertanyaan, gagasan, dan peluang kolaborasi.','For questions, ideas, and collaboration opportunities.')}</p><a class="button primary" href={`mailto:${organisation.email}`}>{t('Tulis email','Write an email')} <span aria-hidden="true">↗</span></a></aside></div></section>
<section class="office-section" aria-labelledby="office-title"><div class="container office-panel"><div class="office-details"><p class="eyebrow">{t('Alamat kantor','Office address')}</p><h2 id="office-title">{t('Temui kami di Pekanbaru','Visit us in Pekanbaru')}</h2><p class="office-name">Yayasan Gambut</p><address>{organisation.headOffice}</address><div class="office-actions"><a class="button primary" href={officeMap} target="_blank" rel="noreferrer">{t('Petunjuk arah','Get directions')} <span aria-hidden="true">↗</span></a><a class="map-link" href={officeMap} target="_blank" rel="noreferrer">{t('Buka di Google Maps','Open in Google Maps')}</a></div><p class="visit-note">{t('Hubungi kami melalui email untuk merencanakan kunjungan atau pertemuan.','Email us to arrange a visit or meeting.')}</p></div><div class="office-map"><iframe src="https://maps.google.com/maps?q=0.4980925,101.4263694&amp;z=17&amp;output=embed" title={t('Peta lokasi kantor Yayasan Gambut di Pekanbaru','Map of the Yayasan Gambut office in Pekanbaru')} width="640" height="420" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-caption" href={officeMap} target="_blank" rel="noreferrer">Yayasan Gambut · Pekanbaru <span aria-hidden="true">↗</span></a></div></div></section>
<section class="contact-purposes" aria-labelledby="purpose-title"><div class="container"><div class="purpose-heading"><h2 id="purpose-title">{t('Apa yang ingin Anda diskusikan?','What would you like to discuss?')}</h2><p>{t('Pilih topik untuk membuka email dengan subjek yang sesuai.','Choose a topic to open an email with a relevant subject.')}</p></div><div class="purpose-grid">{topics.map(topic=><a class="purpose-card" href={`mailto:${organisation.email}?subject=${encodeURIComponent(topic.title+' — Yayasan Gambut')}`}><span class="purpose-number">{topic.n}</span><h3>{topic.title}</h3><p>{topic.body}</p><span class="purpose-cta">{t('Tulis email','Write an email')} <span aria-hidden="true">↗</span></span></a>)}</div><p class="message-tip">{t('Sertakan nama, organisasi, dan gambaran singkat kebutuhan Anda agar kami dapat menindaklanjuti dengan tepat.','Include your name, organisation, and a brief description of your enquiry so we can follow up appropriately.')}</p></div></section>
<section class="social-section"><div class="container social-row"><div><p class="eyebrow">{t('Ikuti cerita kami','Follow our stories')}</p><h2>{t('Terhubung dari mana saja.','Stay connected, wherever you are.')}</h2></div><nav aria-label={t('Media sosial Yayasan Gambut','Yayasan Gambut social media')}>{channels.map(([name,url])=><a href={url} target="_blank" rel="noreferrer">{name} <span aria-hidden="true">↗</span></a>)}</nav></div></section>
<style>
.contact-opening{padding:3.5rem 0;background:#edf2e9}.opening-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:3rem;align-items:center}.contact-opening h1{font-size:clamp(2.4rem,5vw,4rem);line-height:1.08;margin:0 0 1.15rem;letter-spacing:-.04em}.opening-copy{font-size:1.1rem;line-height:1.7;max-width:38ch;margin:0;color:#4d6258}.email-card{padding:1.7rem 2rem;border:1px solid #d7e2d1;border-radius:1.2rem;background:#fff}.email-address{font-size:clamp(1.05rem,2vw,1.6rem);font-weight:750;text-decoration:none;overflow-wrap:anywhere;color:#153f32}.email-card p:not(.eyebrow){font-size:.9rem;color:#53645c;margin:.8rem 0 1.2rem}.email-card .button{gap:1.3rem}.office-section{padding:3rem 0;background:white}.office-panel{display:grid;grid-template-columns:.9fr 1.15fr;gap:2.5rem;align-items:center}.office-details h2{font-size:clamp(1.7rem,3vw,2.25rem);line-height:1.2;max-width:20ch;margin:0 0 1.4rem}.office-name{font-weight:750;margin:0 0 .55rem}.office-details address{font-style:normal;line-height:1.8;color:#53645c;max-width:43ch}.office-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1rem;margin:1.5rem 0 1rem}.office-actions .button{gap:1rem}.map-link{font-size:.85rem;text-underline-offset:4px}.visit-note{font-size:.83rem;line-height:1.6;color:#637568;max-width:44ch}.office-map{overflow:hidden;border:1px solid #d9e3d5;border-radius:1.2rem;background:#edf2e9}.office-map iframe{display:block;width:100%;height:350px;border:0}.map-caption{display:flex;align-items:center;justify-content:space-between;padding:.8rem 1rem;font-size:.8rem;font-weight:700;text-decoration:none;background:#f3f6ef}.contact-purposes{padding:1rem 0 3rem;background:white}.purpose-heading{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:1.2rem}.purpose-heading h2{font-size:1.6rem;margin:0;max-width:25ch}.purpose-heading p{font-size:.9rem;color:#53645c;max-width:35ch;margin:0}.purpose-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.purpose-card{display:flex;flex-direction:column;padding:1.4rem;border:1px solid #dce4d7;border-radius:1rem;text-decoration:none;background:#fafbf7;transition:background .15s,border-color .15s}.purpose-card:hover{background:#edf2e9;border-color:#8caa89}.purpose-number{font-size:.75rem;font-weight:700;color:#638264}.purpose-card h3{font-size:1.1rem;margin:.7rem 0 .6rem}.purpose-card p{font-size:.9rem;line-height:1.6;color:#53645c;margin:0 0 1rem}.purpose-cta{display:flex;justify-content:space-between;font-size:.83rem;font-weight:750;margin-top:auto}.message-tip{font-size:.8rem;line-height:1.6;color:#637568;margin:1rem 0 0;max-width:95ch}.social-section{padding:2rem 0;background:#edf2e9}.social-row{display:flex;align-items:center;justify-content:space-between;gap:2rem}.social-row h2{font-size:1.3rem;margin:0}.social-row .eyebrow{margin-bottom:.5rem}.social-row nav{display:flex;gap:.65rem;flex-wrap:wrap}.social-row nav a{display:flex;align-items:center;gap:1rem;padding:.65rem .85rem;min-height:44px;border:1px solid #c5d5c1;border-radius:2rem;font-size:.82rem;font-weight:700;text-decoration:none;background:#fff}.purpose-card:focus-visible,.email-address:focus-visible,.social-row a:focus-visible,.map-caption:focus-visible{outline:3px solid #ad771d;outline-offset:4px}
@media(max-width:850px){.opening-grid{grid-template-columns:1fr 1fr;gap:1.5rem}.email-card{padding:1.4rem}.office-panel{gap:1.5rem}.social-row{align-items:start;flex-direction:column;gap:1.2rem}}
@media(max-width:650px){.contact-opening{padding:2rem 0}.opening-grid,.office-panel,.purpose-grid{grid-template-columns:1fr}.opening-grid{gap:1.5rem}.opening-copy{max-width:none}.email-address{font-size:1.15rem}.office-section{padding:2rem 0}.office-panel{gap:1.25rem}.office-map iframe{height:280px}.purpose-heading{flex-direction:column;align-items:start;gap:.6rem}.purpose-heading p{max-width:none}.purpose-card{padding:1.1rem}.contact-purposes{padding-bottom:2rem}.office-actions{gap:.9rem}.social-row nav{gap:.5rem}}
</style>
