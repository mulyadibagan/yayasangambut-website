---
import { organisation, type Lang } from '../data/site';
const {lang}=Astro.props as {lang:Lang};
const t=(a:string,b:string)=>lang==='id'?a:b;
const officeMap='https://maps.app.goo.gl/9XfdFBjc3ZXpnsSY8';
const channels=[['Instagram',organisation.instagram],['LinkedIn',organisation.linkedin],['Facebook',organisation.facebook],['YouTube',organisation.youtube]];
---
<section class="contact-opening"><div class="container"><p class="eyebrow">Yayasan Gambut</p><h1>{t('Hubungi Kami','Contact Us')}</h1><p class="opening-copy">{t('Hubungi tim Yayasan Gambut untuk informasi program, kerja sama, penelitian, atau kebutuhan media.','Contact Yayasan Gambut for program information, partnerships, research, or media enquiries.')}</p></div></section>
<section class="office-section" aria-labelledby="office-title"><div class="container office-panel"><div class="office-details"><p class="eyebrow">{t('Kantor kami','Our office')}</p><h2 id="office-title">Pekanbaru, Riau</h2><address>{organisation.headOffice}</address><a class="directions" href={officeMap} target="_blank" rel="noreferrer">{t('Petunjuk arah di Google Maps','Get directions on Google Maps')} <span aria-hidden="true">↗</span></a><div class="email-details"><p class="eyebrow">{t('Email resmi','Official email')}</p><a class="email-address" href={`mailto:${organisation.email}`}>{organisation.email}</a><p class="visit-note">{t('Untuk pertanyaan, kerja sama, atau merencanakan kunjungan ke kantor kami.','For enquiries, collaboration, or to arrange a visit to our office.')}</p></div></div><div class="office-map"><iframe src="https://maps.google.com/maps?q=0.4980925,101.4263694&amp;z=17&amp;output=embed" title={t('Peta lokasi kantor Yayasan Gambut di Pekanbaru','Map of the Yayasan Gambut office in Pekanbaru')} width="720" height="360" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-caption" href={officeMap} target="_blank" rel="noreferrer">Yayasan Gambut · Pekanbaru <span>{t('Buka peta','Open map')} ↗</span></a></div></div></section>
<section class="collaboration-section" aria-labelledby="collaboration-title"><div class="container collaboration-row"><div><h2 id="collaboration-title">{t('Kemitraan dan informasi','Partnerships and enquiries')}</h2><p>{t('Kami terbuka untuk kerja sama program, penelitian, pertukaran pengetahuan, dan media. Sertakan nama, organisasi, dan tujuan Anda agar kami dapat menindaklanjuti.','We welcome collaboration on programs, research, knowledge sharing, and media. Please include your name, organisation, and the purpose of your enquiry.')}</p></div><a class="button primary" href={`mailto:${organisation.email}`}>{t('Hubungi melalui email','Get in touch by email')} <span aria-hidden="true">↗</span></a></div></section>
<section class="social-section"><div class="container social-row"><p>{t('Ikuti Yayasan Gambut','Follow Yayasan Gambut')}</p><nav aria-label={t('Media sosial Yayasan Gambut','Yayasan Gambut social media')}>{channels.map(([name,url])=><a href={url} target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">{name==='Instagram'?<><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></>:name==='YouTube'?<><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3Z"/></>:name==='LinkedIn'?<><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 10v7m0-10v.2M11 17v-7m0 3a3 3 0 0 1 6 0v4"/></>:<path d="M14 21v-8h3l.5-4H14V7c0-1 .5-2 2-2h2V2h-3c-3 0-5 2-5 5v2H7v4h3v8"/>}</svg>{name}<span aria-hidden="true">↗</span></a>)}</nav></div></section>
<style>
.contact-opening{background:#f2f5ef;padding:2.4rem 0 2rem;border-bottom:1px solid #e0e6dc}.contact-opening .eyebrow{margin-bottom:.65rem}.contact-opening h1{font-size:clamp(2.2rem,4vw,3rem);line-height:1.12;letter-spacing:-.035em;margin:0 0 .7rem}.opening-copy{font-size:1.05rem;line-height:1.6;margin:0;color:#53645c}.office-section{padding:2.4rem 0;background:#fff}.office-panel{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.3fr);gap:3.5rem;align-items:center}.office-details h2{font-size:1.65rem;line-height:1.2;margin:0 0 1rem;letter-spacing:-.02em}.office-details address{font-style:normal;font-size:.95rem;line-height:1.8;color:#53645c;max-width:43ch}.directions{display:inline-flex;align-items:center;gap:.8rem;font-size:.86rem;font-weight:700;min-height:44px;margin:.55rem 0;text-underline-offset:5px}.email-details{border-top:1px solid #dfe6dc;margin-top:.65rem;padding-top:1.1rem}.email-details .eyebrow{margin-bottom:.45rem}.email-address{font-size:clamp(1rem,1.7vw,1.25rem);font-weight:700;text-decoration:none;overflow-wrap:anywhere}.visit-note{font-size:.83rem;line-height:1.65;color:#617066;max-width:43ch;margin:.6rem 0 0}.office-map{overflow:hidden;border:1px solid #dce3d8;border-radius:6px;background:#f2f5ef}.office-map iframe{display:block;width:100%;height:360px;border:0}.map-caption{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.8rem 1rem;font-size:.78rem;font-weight:650;text-decoration:none}.map-caption span{font-weight:500}.collaboration-section{background:#fff}.collaboration-row{display:flex;justify-content:space-between;align-items:center;gap:2.5rem;border-top:1px solid #dfe6dc;padding-top:1.7rem;padding-bottom:1.7rem}.collaboration-row h2{font-size:1.25rem;margin:0 0 .6rem;letter-spacing:-.015em}.collaboration-row p{font-size:.9rem;line-height:1.7;color:#53645c;max-width:73ch;margin:0}.collaboration-row .button{flex-shrink:0;gap:1rem;border-radius:6px;font-size:.85rem}.social-section{background:#f2f5ef;padding:.8rem 0}.social-row{display:flex;justify-content:space-between;align-items:center;gap:1.2rem}.social-row>p{font-size:.83rem;font-weight:650;margin:0}.social-row nav{display:flex;gap:1.5rem;flex-wrap:wrap}.social-row nav a{display:inline-flex;align-items:center;gap:.45rem;font-size:.8rem;min-height:44px;text-decoration:none}.social-row nav a>span{font-size:.75rem;color:#62766a}.social-row nav a:hover,.email-address:hover{color:#387447;text-decoration:underline;text-underline-offset:4px}a:focus-visible{outline:3px solid #ad771d;outline-offset:4px}
@media(max-width:850px){.office-panel{gap:2rem;grid-template-columns:1fr 1.2fr}.collaboration-row{gap:1.5rem}.social-row{align-items:flex-start;flex-direction:column;gap:.35rem}}
@media(max-width:650px){.contact-opening{padding:1.7rem 0 1.5rem}.opening-copy{font-size:.95rem}.office-section{padding:1.6rem 0}.office-panel{grid-template-columns:1fr;gap:1.5rem}.office-details address,.visit-note{max-width:none}.office-details h2{font-size:1.5rem}.office-map iframe{height:280px}.collaboration-row{flex-direction:column;align-items:flex-start;gap:1rem;padding-top:1.4rem;padding-bottom:1.4rem}.social-row nav{column-gap:1.2rem;row-gap:0}.map-caption{font-size:.73rem}}
</style>

