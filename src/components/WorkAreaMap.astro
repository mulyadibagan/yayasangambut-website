---
import type { Lang } from '../data/site';
const { lang = 'id' } = Astro.props as { lang?: Lang };
const id = lang === 'id';
const mapUrl = 'https://webgisyg.id/webgis.html';
---
<div class="work-area-map">
  <div class="map-heading">
    <div><p class="eyebrow">{id ? 'Wilayah kerja · Riau' : 'Where we work · Riau'}</p><h2>{id ? 'Wilayah kerja Yayasan Gambut' : 'Yayasan Gambut Work Areas'}</h2><p>{id ? 'Lokasi program dan kegiatan Yayasan Gambut di Riau.' : 'Yayasan Gambut program and activity locations in Riau.'}</p></div>
    <a class="button primary" href={mapUrl} target="_blank" rel="noreferrer">{id ? 'Buka peta program' : 'Open program map'}</a>
  </div>
  <iframe src={mapUrl} title={id ? 'Peta interaktif wilayah kerja Yayasan Gambut dari YG GeoPortal' : 'Interactive Yayasan Gambut work-area map from YG GeoPortal'} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>

</div>
<style>
.work-area-map{min-width:0;width:100%}.map-heading{display:flex;justify-content:space-between;align-items:center;gap:1.5rem;margin-bottom:1.5rem}.map-heading h2{margin:.4rem 0 .8rem}.map-heading p:not(.eyebrow){max-width:44rem;color:var(--muted);margin:0}.map-heading .button{flex-shrink:0}.work-area-map iframe{display:block;width:100%;height:620px;border:1px solid var(--line);border-radius:1rem;background:#e7eee4}.map-note{font-size:.8rem;color:var(--muted);margin:.8rem 0 0}@media(max-width:679px){.map-heading{display:block}.map-heading .button{margin-top:1rem}.work-area-map iframe{height:520px}.map-heading h2{font-size:1.8rem}}
</style>

