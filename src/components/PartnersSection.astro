---
import type { Lang } from '../data/site';
const {lang,full=false}=Astro.props as {lang:Lang;full?:boolean};
const id=lang==='id';
const t=(a:string,b:string)=>id?a:b;
const report='/wp-content/uploads/2023/04/Compilation-Capaian_Yayasan-Gambut_2022.pdf#page=7';
const partners=[
 {name:'Global Environment Centre',short:'GEC',period:t('Januari–Desember 2022','January–December 2022'),body:t('Dukungan pendanaan untuk restorasi lahan gambut dan mangrove di Kabupaten Bengkalis.','Funding for peatland and mangrove restoration in Bengkalis Regency.')},
 {name:'BenihBaik.com',short:'BenihBaik.com',period:t('November–Desember 2022','November–December 2022'),body:t('Dukungan penanaman 800 pohon di Tualang, Siak, dan 800 cemara di Taman Wisata Alam Pantai Panjang, Bengkulu.','Support for planting 800 trees in Tualang, Siak, and 800 coastal casuarina trees at Pantai Panjang Nature Tourism Park, Bengkulu.')},
 {name:'Jaringan Pemantau Independen Kehutanan',short:'JPIK',period:t('April–Mei 2022','April–May 2022'),body:t('Dukungan pendanaan pemantauan SVLK PT Arara Abadi dan PT Ekawana Lestari Dharma.','Funding for SVLK monitoring of PT Arara Abadi and PT Ekawana Lestari Dharma.')},
 {name:'Independent Forest Monitoring Fund',short:'IFM Fund',period:t('September–November 2022','September–November 2022'),body:t('Dukungan pendanaan pemantauan SVLK PT Balai Kayang Mandiri.','Funding for SVLK monitoring of PT Balai Kayang Mandiri.')}
];
---
<section class="partner-section" id="mitra"><div class="container">
<header class="partner-heading"><div><p class="eyebrow">{t('Bekerja bersama','Working together')}</p>{full?<h1>{t('Mitra dan Kolaborasi','Partners and Collaboration')}</h1>:<h2>{t('Mitra dan Kolaborasi','Partners and Collaboration')}</h2>}<p>{t('Bersama masyarakat dan mitra, kami memperkuat pengelolaan ekosistem dan penghidupan yang berkelanjutan.','With communities and partners, we strengthen ecosystem management and sustainable livelihoods.')}</p></div><span class="period">{t('Riwayat program · 2022','Program history · 2022')}</span></header>
<div class="sister"><a href="https://gec.org.my/" target="_blank" rel="noreferrer"><img src="https://gec.org.my/wp-content/uploads/2026/10/gec-logo-header.webp" width="388" height="160" loading="lazy" alt="Global Environment Centre"/></a><div><p class="eyebrow">{t('Organisasi saudara','Sister organisation')}</p><h3>Global Environment Centre</h3><p>{t('Yayasan Gambut merupakan organisasi saudara Global Environment Centre (GEC) di Indonesia.','Yayasan Gambut is a sister organisation of Global Environment Centre (GEC) in Indonesia.')}</p></div></div>
<div class="subheading"><h3>{t('Pendukung program 2022','Program supporters in 2022')}</h3><a href={report} target="_blank" rel="noreferrer">{t('Laporan tahunan 2022 · hlm. 7','2022 annual report · p. 7')} ↗</a></div>
<div class="partner-grid">{partners.map(p=><article><div class="partner-name">{p.short}</div>{p.name!==p.short&&<h4>{p.name}</h4>}<p>{p.body}</p><span class="partner-period">{p.period}</span></article>)}</div>
{full&&<div class="community"><div><p class="eyebrow">{t('Mitra di tingkat tapak','Partners on the ground')}</p><h2>{t('Masyarakat sebagai pelaku utama.','Communities at the heart of the work.')}</h2></div><div><p>{t('Laporan 2022 mendokumentasikan kerja bersama kelompok masyarakat di Penampi, Temiang, dan Sepahat: budidaya madu kelulut, pertanian tanpa bakar, agroforestri, serta pengelolaan air gambut.','The 2022 report documents work with community groups in Penampi, Temiang, and Sepahat: stingless-bee farming, zero-burning agriculture, agroforestry, and peatland water management.')}</p><p>{t('Tim SMPEI Project–IFAD dan DLHK Riau juga disebut dalam kegiatan pembelajaran dan kunjungan lapangan. Keterlibatan tersebut dicatat sesuai kegiatan yang dilaporkan.','The SMPEI Project–IFAD team and the Riau Environment and Forestry Agency are also mentioned in learning activities and field visits. Their involvement is recorded in the context of those activities.')}</p><a href={report.replace('#page=7','#page=5')} target="_blank" rel="noreferrer">{t('Lihat dokumentasi · hlm. 5–6','View documentation · pp. 5–6')} ↗</a></div></div>}
<div class="partner-bottom"><p>{t('Daftar ini merujuk pada dukungan yang tercatat dalam laporan 2022. Periode menunjukkan pelaksanaan program, bukan status kerja sama saat ini.','This list refers to support recorded in the 2022 report. Dates indicate program implementation, not current partnership status.')}</p><a class="button primary" href={full?t('/id/hubungi-kami/','/en/contact/'):t('/id/mitra/','/en/partners/')}>{full?t('Bangun kolaborasi','Collaborate with us'):t('Kenali Mitra Kami','Meet our partners')}</a></div>
</div></section>
<style>
.partner-section{padding:3.5rem 0;background:#fff}.partner-heading{display:flex;justify-content:space-between;align-items:start;gap:2rem}.partner-heading h1,.partner-heading h2{font-size:clamp(2rem,3.5vw,3rem);line-height:1.15;margin-bottom:1rem}.partner-heading p:not(.eyebrow){color:#53645c;max-width:43rem}.period{flex-shrink:0;font-size:.8rem;border:1px solid #dbe4d9;border-radius:2rem;padding:.6rem .9rem;color:#426044}.sister{display:grid;grid-template-columns:12rem 1fr;gap:2rem;align-items:center;margin:1.8rem 0 2.5rem;padding:1.5rem 2rem;background:#eef3e8;border-radius:1rem}.sister img{width:100%;height:auto;max-height:6rem;object-fit:contain}.sister h3{font-size:1.35rem;margin:.25rem 0 .5rem}.sister p:not(.eyebrow){color:#53645c;margin:0}.sister .eyebrow{margin-bottom:.4rem}.subheading{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:1rem}.subheading h3{font-size:1.15rem;margin:0}.subheading a,.community a{font-size:.85rem;color:#205845}.partner-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.partner-grid article{display:flex;flex-direction:column;padding:1.4rem;border:1px solid #dbe4d9;border-radius:.8rem;background:#fafbf7}.partner-name{font-size:1.6rem;font-weight:800;color:#175640;line-height:1.2;min-height:2.2rem;overflow-wrap:anywhere}.partner-grid h4{font-size:.85rem;line-height:1.45;margin:.5rem 0 0}.partner-grid p{font-size:.9rem;line-height:1.65;color:#53645c;margin:1rem 0 1.2rem}.partner-period{margin-top:auto;padding-top:.7rem;border-top:1px solid #dbe4d9;font-size:.77rem;color:#53645c}.partner-bottom{display:flex;gap:2rem;align-items:center;justify-content:space-between;margin-top:1.5rem}.partner-bottom p{font-size:.8rem;max-width:44rem;color:#53645c}.partner-bottom .button{flex-shrink:0}.community{display:grid;grid-template-columns:1fr 1.3fr;gap:3rem;margin-top:3rem;padding-top:2rem;border-top:1px solid #dbe4d9}.community h2{font-size:2rem;max-width:22ch}.community p:not(.eyebrow){color:#53645c}.community a{display:inline-block;padding:.5rem 0}
@media(max-width:1000px){.partner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.partner-heading{flex-direction:column;gap:.5rem}}
@media(max-width:600px){.partner-section{padding:2.5rem 0}.sister{grid-template-columns:1fr;padding:1.3rem;gap:1rem}.sister>a{max-width:11rem}.partner-grid{grid-template-columns:1fr}.subheading,.partner-bottom{align-items:start;flex-direction:column;gap:1rem}.community{grid-template-columns:1fr;gap:1rem}.partner-bottom .button{width:100%}}
</style>
