---
import type { Lang } from '../data/site';
const {lang,full=false}=Astro.props as {lang:Lang;full?:boolean};
const id=lang==='id';
const t=(a:string,b:string)=>id?a:b;
const partners=[
 // Public WebGIS YG dashboard: funding partners and programme summaries, checked 2026-10-05.
 {name:'APRIL Group',short:'APRIL Group',logo:'/images/partners/april-group.png',url:'https://www.aprilasia.com/',body:t('Dukungan penguatan perhutanan sosial dan pengembangan usaha masyarakat di Dayun.','Support for social forestry and community enterprise development in Dayun.')},
 {name:'Pertamina Foundation',short:'Pertamina Foundation',logo:'/images/partners/pertamina-foundation.svg',url:'https://www.pertaminafoundation.org/',body:t('Dukungan pengelolaan hutan dan pengembangan penghidupan bersama KTH Siarang-arang Lestari di Rokan Hilir.','Support for forest management and livelihoods with KTH Siarang-arang Lestari in Rokan Hilir.')},
 {name:'Yayasan Penabulu',short:'Yayasan Penabulu',logo:'/images/partners/penabulu.png',url:'https://penabulufoundation.org/',body:t('Dukungan usaha kopi Liberika yang dipimpin perempuan dan penguatan ketahanan ekosistem gambut di Temiang.','Support for women-led Liberica coffee enterprises and peatland ecosystem resilience in Temiang.')},
 {name:'MA Earth',short:'MA Earth',logo:'/images/partners/ma-earth.svg',url:'https://maearth.com/',body:t('Dukungan penanaman mangrove dan agroforestri kopi bersama masyarakat.','Support for community-based mangrove planting and coffee agroforestry.')},

 {name:'Global Environment Centre',short:'GEC',logo:'/images/partners/gec.webp',url:'https://gec.org.my/',body:t('Kolaborasi restorasi lahan gambut dan mangrove bersama masyarakat.','Collaboration on community-based peatland and mangrove restoration.')},
 {name:'BenihBaik.com',short:'BenihBaik.com',logo:'/images/partners/benihbaik.png',url:'https://benihbaik.com/',body:t('Dukungan penanaman pohon dan pemulihan lingkungan.','Support for tree planting and environmental restoration.')},
 {name:'Jaringan Pemantau Independen Kehutanan',short:'JPIK',logo:'/images/partners/jpik.png',url:'https://jpik.or.id/',body:t('Kolaborasi pemantauan independen kehutanan dan verifikasi legalitas kayu.','Collaboration on independent forest monitoring and timber legality verification.')},
 {name:'Independent Forest Monitoring Fund',short:'IFM Fund',logo:'/images/partners/ifm.svg',url:'https://forestfund.or.id/',body:t('Dukungan pemantauan independen untuk memperkuat tata kelola hutan.','Support for independent monitoring to strengthen forest governance.')},
 // Annual Report 2023: pp. 6, 25, 29–30. Descriptions reflect documented activities.
 {name:'Aramco Asia Singapore',short:'Aramco Asia Singapore',logo:'/images/partners/aramco.webp',url:'https://www.aramco.com/',body:t('Dukungan pelestarian mangrove berbasis masyarakat di Buruk Bakul.','Support for community-based mangrove conservation in Buruk Bakul.')},
 {name:'Fakultas Pertanian, Universitas Riau',short:'Fakultas Pertanian UNRI',logo:'/images/partners/faperta-unri.png',url:'https://fp.unri.ac.id/',body:t('Kolaborasi melalui Fakultas Pertanian dalam pelatihan agroforestri dan pengembangan kopi Liberika.','Collaboration through the Faculty of Agriculture on agroforestry training and Liberica coffee development.')},
 // Annual Report 2024, PDF pp. 4, 16–17 and 40: research collaboration and funding.
 {name:'Wilmar International',short:'Wilmar',logo:'/images/partners/wilmar-international.png',url:'https://www.wilmar-international.com/',body:t('Kolaborasi kajian cadangan karbon dan rekomendasi restorasi ekosistem gambut.','Collaboration on carbon stock assessment and peatland ecosystem restoration recommendations.')},
 // Annual Report 2025, PDF pp. 36–49, 51–54 and 66. Logos extracted from the funding page.
 {name:'Pan Pacific Conservation Foundation',short:'PPCF',logo:'/images/partners/ppcf.png',url:'https://www.ppcf.org.sg/',body:t('Dukungan restorasi gambut, agroforestri, pencegahan kebakaran, dan penguatan penghidupan masyarakat.','Support for peatland restoration, agroforestry, fire prevention, and community livelihoods.')},
 {name:'Badan Pengelola Dana Perkebunan',short:'BPDP',logo:'/images/partners/bpdp.png',url:'https://www.bpdp.or.id/',body:t('Kolaborasi pelatihan tumpang sari kopi dalam kebun kelapa sawit bersama petani.','Collaboration on farmer training in coffee intercropping within oil palm plantations.')},
 {name:'Aliansi Kolibri',short:'Aliansi Kolibri',logo:'/images/partners/aliansi-kolibri.png',url:'https://kolibri.or.id/',body:t('Dukungan Kaleka melalui Aliansi Kolibri untuk restorasi Hutan Adat Imbo Putui bersama masyarakat adat.','Support from Kaleka through the Kolibri Alliance for community-led restoration of Imbo Putui customary forest.')}



] ;
const partnerOrder=['GEC','Aliansi Kolibri','Aramco Asia Singapore','PPCF','MA Earth','Yayasan Penabulu','JPIK','IFM Fund','BenihBaik.com','Pertamina Foundation','Fakultas Pertanian UNRI','BPDP','APRIL Group','Wilmar'];
partners.sort((a,b)=>partnerOrder.indexOf(a.short)-partnerOrder.indexOf(b.short));
const featuredPartners=partners.slice(0,12);
---
<section class:list={["partner-section",{compact:!full}]} id="mitra"><div class="container">
<header class="partner-heading"><div><p class="eyebrow">{t('Bekerja bersama','Working together')}</p>{full?<h1>{t('Mitra Kami','Our Partners')}</h1>:<h2>{t('Mitra Kami','Our Partners')}</h2>}<p>{t('Bersama masyarakat dan mitra, kami memperkuat pengelolaan ekosistem dan penghidupan yang berkelanjutan.','With communities and partners, we strengthen ecosystem management and sustainable livelihoods.')}</p></div></header>
<div class="sister"><a href="https://gec.org.my/" target="_blank" rel="noreferrer"><img src="/images/partners/gec.webp" width="388" height="160" loading="lazy" alt="Global Environment Centre"/></a><div><p class="eyebrow">{t('Organisasi saudara','Sister organisation')}</p><h3>Global Environment Centre</h3><p>{t('Yayasan Gambut merupakan organisasi saudara Global Environment Centre (GEC) di Indonesia.','Yayasan Gambut is a sister organisation of Global Environment Centre (GEC) in Indonesia.')}</p></div></div>
<div class="partner-grid">{(full?partners:featuredPartners).map(p=><article><a class:list={["partner-logo",{faculty:p.logo.includes("faperta-unri")}]} href={p.url} target="_blank" rel="noreferrer" aria-label={p.name}>{p.logo?<img src={p.logo} width="240" height="100" loading="lazy" decoding="async" alt={p.name}/>:<span class="partner-wordmark">{p.short}</span>}</a><h3>{p.short}</h3>{full&&<>{p.name!==p.short&&<p class="partner-fullname">{p.name}</p>}<p>{p.body}</p></>}</article>)}</div>
{full&&<>
<div class="community grassroots"><div><p class="eyebrow">{t('Mitra di tingkat tapak','Partners on the ground')}</p><h2>{t('Masyarakat sebagai pelaku utama.','Communities at the heart of the work.')}</h2></div><div><p>{t('Kerja bersama masyarakat mencakup pengelolaan gambut, agroforestri, pemulihan mangrove, dan pengembangan penghidupan.','Work with communities spans peatland management, agroforestry, mangrove restoration, and livelihoods development.')}</p><!-- Logos: original LPHA asset and Yayasan Gambut Mitra-2026 artwork; SVG viewports preserve the source artwork. Kelismasy has no verified logo yet. -->
<div class="community-cards">
<article class:list={["community-card",{"text-only":false}]}><div class="community-logo"><img src="/images/partners/lpha-imbo-putui.png" width="500" height="500" loading="lazy" decoding="async" alt="Logo LPHA Imbo Putui" /></div><div><h3>LPHA Imbo Putui · Petapahan</h3><p>{t('Restorasi hutan adat melalui perencanaan bersama, pembibitan, penanaman, dan pemantauan.','Customary forest restoration through joint planning, nurseries, planting, and monitoring.')}</p></div></article>
<article class:list={["community-card",{"text-only":false}]}><div class="community-logo"><svg viewBox="1695 945 132 145" role="img" aria-label="Logo Kelompok Sekat Bakau" width="96" height="88"><image href="/images/partners/mitra-2026.jpg" width="2048" height="1242" /></svg></div><div><h3>Kelompok Sekat Bakau</h3><p>{t('Pembibitan dan penanaman mangrove serta pertukaran pembelajaran di Buruk Bakul.','Mangrove nurseries, planting, and learning exchanges in Buruk Bakul.')}</p></div></article>
<article class:list={["community-card",{"text-only":false}]}><div class="community-logo"><svg viewBox="1520 945 156 153" role="img" aria-label="Logo KTWMJ" width="96" height="88"><image href="/images/partners/mitra-2026.jpg" width="2048" height="1242" /></svg></div><div><h3>KTWMJ · Temiang</h3><p>{t('Pembibitan kopi Liberika, agroforestri, dan pembelajaran pengelolaan ekosistem.','Liberica coffee nurseries, agroforestry, and ecosystem management learning.')}</p></div></article>
<article class:list={["community-card",{"text-only":false}]}><div class="community-logo"><svg viewBox="1850 945 130 156" role="img" aria-label="Logo BELATRAM" width="96" height="88"><image href="/images/partners/mitra-2026.jpg" width="2048" height="1242" /></svg></div><div><h3>{t('Kelompok Masyarakat BELATRAM · Tanjung Kuras','BELATRAM Community Group · Tanjung Kuras')}</h3><p>{t('Pengembangan kopi Liberika dan sistem peringatan dini kebakaran di lahan gambut.','Liberica coffee development and fire early warning systems on peatlands.')}</p></div></article>
<article class:list={["community-card",{"text-only":false}]}><div class="community-logo"><svg viewBox="1005 950 133 125" role="img" aria-label="Logo Kelompok Paghet Segagah" width="96" height="88"><image href="/images/partners/mitra-2026.jpg" width="2048" height="1242" /></svg></div><div><h3>Kelompok Paghet Segagah · Kelapa Pati</h3><p>{t('Pembibitan, penanaman, dan konservasi mangrove bersama masyarakat.','Community-based mangrove nurseries, planting, and conservation.')}</p></div></article>
<article class:list={["community-card",{"text-only":false}]}><div class="community-logo"><svg viewBox="88 945 136 141" role="img" aria-label="Logo Bahtera Melayu" width="96" height="88"><image href="/images/partners/mitra-2026.jpg" width="2048" height="1242" /></svg></div><div><h3>Bahtera Melayu</h3><p>{t('Kegiatan mangrove dan pertukaran pembelajaran bersama masyarakat.','Mangrove activities and community learning exchanges.')}</p></div></article>
<article class:list={["community-card",{"text-only":false}]}><div class="community-logo"><svg viewBox="698 742 170 134" role="img" aria-label="Logo Pondok Belantara" width="96" height="88"><image href="/images/partners/mitra-2026.jpg" width="2048" height="1242" /></svg></div><div><h3>Komunitas Pondok Belantara</h3><p>{t('Dukungan kegiatan Desember Camp.','Support for Desember Camp activities.')}</p></div></article>
<article class:list={["community-card",{"text-only":true}]}><div><h3>Lembaga Kelismasy Bengkalis</h3><p>{t('Dukungan bibit dan penanaman mangrove.','Support for mangrove seedlings and planting.')}</p></div></article>
<article class:list={["community-card",{"text-only":false}]}><div class="community-logo"><svg viewBox="580 564 143 113" role="img" aria-label="Logo Rumus Riau" width="96" height="88"><image href="/images/partners/mitra-2026.jpg" width="2048" height="1242" /></svg></div><div><h3>Lembaga Rumus Riau</h3><p>{t('Dukungan bibit kopi Liberika untuk agroforestri di Temeran.','Support for Liberica coffee seedlings for agroforestry in Temeran.')}</p></div></article>
<article class:list={["community-card",{"text-only":false}]}><div class="community-logo"><svg viewBox="1566 748 120 122" role="img" aria-label="Logo Suvarnabhumi" width="96" height="88"><image href="/images/partners/mitra-2026.jpg" width="2048" height="1242" /></svg></div><div><h3>Suvarnabhumi</h3><p>{t('Fasilitasi pengemasan dan pemasaran kopi Liberika masyarakat.','Facilitation of packaging and marketing for community-grown Liberica coffee.')}</p></div></article>
</div></div></div>
<div class="community"><div><p class="eyebrow">{t('Jejaring kolaborasi','Collaboration network')}</p><h2>{t('Berbagi pengetahuan dan memperluas kerja bersama.','Sharing knowledge and extending collaboration.')}</h2></div><div><dl class="collaborator-list">
<!-- Annual Report 2024, PDF pp. 20–21 and 33–36. -->
<dt>{t('Fakultas Perikanan dan Kelautan, Universitas Riau','Faculty of Fisheries and Marine Sciences, Universitas Riau')}</dt><dd>{t('Fasilitasi pelatihan pemantauan mangrove dan peningkatan kapasitas kelompok masyarakat.','Facilitation of mangrove monitoring training and community capacity building.')}</dd>
<dt>DLHK Riau</dt><dd>{t('Pelatihan praktik perkebunan berkelanjutan serta pendidikan pengelolaan ekosistem gambut.','Training in sustainable plantation practices and peatland ecosystem management education.')}</dd>
<dt>DLH Kabupaten Siak · DLH Kabupaten Bengkalis</dt><dd>{t('Sekolah lapang paludikultur dan penguatan kapasitas kelembagaan pengelolaan gambut.','Paludiculture field schools and capacity building for peatland management institutions.')}</dd>
<!-- Annual Report 2025, academic collaboration seminar, PDF p. 60. -->
<dt>Politeknik Negeri Bengkalis</dt><dd>{t('Kolaborasi pendidikan tentang konservasi gambut, kearifan lokal, dan bisnis berkelanjutan bersama Jurusan Administrasi Bisnis Internasional.','Educational collaboration on peatland conservation, local knowledge, and sustainable business with the International Business Administration department.')}</dd>
<dt>KKMD · POKJA PS Riau</dt><dd>{t('Keanggotaan dalam Kelompok Kerja Mangrove Daerah dan Kelompok Kerja Perhutanan Sosial Provinsi Riau.','Membership in Riau’s regional mangrove and social forestry working groups.')}</dd>
<dt>riaucerdas.com · nadariau.com</dt><dd>{t('Kerja sama media untuk diseminasi informasi.','Media collaboration for information dissemination.')}</dd>
</dl></div></div>
</>}
<div class="partner-bottom"><p>{t('Kemitraan lintas tahun yang tumbuh bersama upaya menjaga ekosistem dan kesejahteraan masyarakat.','Partnerships across the years, growing through shared efforts to protect ecosystems and community well-being.')}</p><a class="button primary" href={full?t('/id/hubungi-kami/','/en/contact/'):t('/id/mitra/','/en/partners/')}>{full?t('Bangun kolaborasi','Collaborate with us'):t('Lihat Semua Mitra','View all partners')}</a></div>
</div></section>
<style>
.partner-section{padding:3.5rem 0;background:#fff}.partner-heading{display:flex;justify-content:space-between;align-items:start;gap:2rem}.partner-heading h1,.partner-heading h2{font-size:clamp(2rem,3.5vw,3rem);line-height:1.15;margin-bottom:1rem}.partner-heading p:not(.eyebrow){color:#53645c;max-width:43rem}.period{flex-shrink:0;font-size:.8rem;border:1px solid #dbe4d9;border-radius:2rem;padding:.6rem .9rem;color:#426044}.sister{display:grid;grid-template-columns:12rem 1fr;gap:2rem;align-items:center;margin:1.8rem 0 2.5rem;padding:1.5rem 2rem;background:#eef3e8;border-radius:1rem}.sister img{width:100%;height:auto;max-height:6rem;object-fit:contain}.sister h3{font-size:1.35rem;margin:.25rem 0 .5rem}.sister p:not(.eyebrow){color:#53645c;margin:0}.sister .eyebrow{margin-bottom:.4rem}.subheading{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:1rem}.subheading h3{font-size:1.15rem;margin:0}.subheading a,.community a{font-size:.85rem;color:#205845}.partner-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.partner-grid article{display:flex;flex-direction:column;padding:1.4rem;border:1px solid #dbe4d9;border-radius:.8rem;background:#fafbf7}.partner-name{font-size:1.6rem;font-weight:800;color:#175640;line-height:1.2;min-height:2.2rem;overflow-wrap:anywhere}.partner-grid h3{font-size:1.1rem;line-height:1.45;margin:1rem 0 0}.partner-grid p{font-size:.9rem;line-height:1.65;color:#53645c;margin:1rem 0 1.2rem}.partner-period{margin-top:auto;padding-top:.7rem;border-top:1px solid #dbe4d9;font-size:.77rem;color:#53645c}.partner-bottom{display:flex;gap:2rem;align-items:center;justify-content:space-between;margin-top:1.5rem}.partner-bottom p{font-size:.8rem;max-width:44rem;color:#53645c}.partner-bottom .button{flex-shrink:0}.community{display:grid;grid-template-columns:1fr 1.3fr;gap:3rem;margin-top:3rem;padding-top:2rem;border-top:1px solid #dbe4d9}.community h2{font-size:2rem;max-width:22ch}.community p:not(.eyebrow){color:#53645c}.community a{display:inline-block;padding:.5rem 0}
@media(max-width:1000px){.partner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.partner-heading{flex-direction:column;gap:.5rem}}
@media(max-width:600px){.partner-section{padding:2.5rem 0}.sister{grid-template-columns:1fr;padding:1.3rem;gap:1rem}.sister>a{max-width:11rem}.partner-grid{grid-template-columns:1fr}.subheading,.partner-bottom{align-items:start;flex-direction:column;gap:1rem}.community{grid-template-columns:1fr;gap:1rem}.partner-bottom .button{width:100%}}
.partner-logo{display:flex;align-items:center;justify-content:center;min-height:7.5rem;padding:.75rem;background:white;border-radius:.5rem}.partner-logo img{display:block;width:100%;height:5.5rem;object-fit:contain}.partner-grid .partner-fullname{font-size:.78rem;margin:.3rem 0 0}.partner-grid p:last-child{margin-bottom:0}
.partner-wordmark{font-size:2rem;font-weight:700;color:#175640}.compact .partner-grid article{border:0;border-radius:0;background:transparent;padding:.75rem;text-align:center}.compact .partner-logo{padding:.5rem;min-height:6rem}.compact .partner-logo img{height:4.5rem}.compact .partner-grid h3{font-size:.85rem;margin:.5rem 0 0}.compact .partner-grid{gap:.5rem 1.5rem}.collaborator-list{margin:0}.collaborator-list dt{font-weight:700;margin-top:1.25rem}.collaborator-list dd{margin:.35rem 0 0;color:#53645c;line-height:1.6}.partner-sources{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-top:1.5rem}@media(max-width:600px){.compact .partner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.partner-logo.faculty img{filter:brightness(0);opacity:.8}.compact .partner-grid{grid-template-columns:repeat(6,minmax(0,1fr));gap:1rem}.compact .partner-grid article{padding:.5rem 0}.compact .partner-logo{padding:.4rem}.compact .partner-grid h3{font-size:.78rem}@media(max-width:1000px){.compact .partner-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.compact .partner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.grassroots{grid-template-columns:1fr;gap:.75rem}.grassroots h2{max-width:none;margin-bottom:.5rem}.grassroots>div>p:not(.eyebrow){max-width:65ch}.community-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:1.25rem}.community-card{display:grid;grid-template-columns:6rem minmax(0,1fr);gap:1rem;align-items:center;padding:1rem;border:1px solid #dbe4d9;border-radius:.75rem;background:#fafbf7}.community-logo{display:flex;align-items:center;justify-content:center;background:#fff;border-radius:.5rem;padding:.35rem;min-height:6rem}.community-logo img,.community-logo svg{display:block;width:100%;height:5.5rem;object-fit:contain;overflow:hidden}.community-card h3{font-size:1rem;line-height:1.4;margin:0}.community-card p{font-size:.88rem;line-height:1.6;margin:.4rem 0 0}.community-card.text-only{grid-template-columns:1fr}@media(max-width:700px){.community-cards{grid-template-columns:1fr}.community-card{grid-template-columns:5rem minmax(0,1fr);gap:.8rem;padding:.85rem}.community-logo{min-height:5rem}.community-logo img,.community-logo svg{height:4.5rem}}
</style>
