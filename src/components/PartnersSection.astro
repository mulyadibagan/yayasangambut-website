---
import type { Lang } from '../data/site';
const {lang,full=false}=Astro.props as {lang:Lang;full?:boolean};
const id=lang==='id';
const t=(a:string,b:string)=>id?a:b;
const partners=[
 {name:'Global Environment Centre',short:'GEC',logo:'/images/partners/gec.webp',url:'https://gec.org.my/',body:t('Kolaborasi restorasi lahan gambut dan mangrove bersama masyarakat.','Collaboration on community-based peatland and mangrove restoration.')},
 {name:'BenihBaik.com',short:'BenihBaik.com',logo:'/images/partners/benihbaik.png',url:'https://benihbaik.com/',body:t('Dukungan penanaman pohon dan pemulihan lingkungan.','Support for tree planting and environmental restoration.')},
 {name:'Jaringan Pemantau Independen Kehutanan',short:'JPIK',logo:'/images/partners/jpik.png',url:'https://jpik.or.id/',body:t('Kolaborasi pemantauan independen kehutanan dan verifikasi legalitas kayu.','Collaboration on independent forest monitoring and timber legality verification.')},
 {name:'Independent Forest Monitoring Fund',short:'IFM Fund',logo:'/images/partners/ifm.svg',url:'https://forestfund.or.id/',body:t('Dukungan pemantauan independen untuk memperkuat tata kelola hutan.','Support for independent monitoring to strengthen forest governance.')},
 // Annual Report 2023: pp. 6, 25, 29–30. Descriptions reflect documented activities.
 {name:'Aramco Asia Singapore',short:'Aramco Asia Singapore',logo:'/images/partners/aramco.webp',url:'https://www.aramco.com/',body:t('Dukungan pelestarian mangrove berbasis masyarakat di Buruk Bakul.','Support for community-based mangrove conservation in Buruk Bakul.')},
 {name:'Fakultas Pertanian, Universitas Riau',short:'Fakultas Pertanian UNRI',logo:'/images/partners/faperta-unri.png',url:'https://fp.unri.ac.id/',body:t('Kolaborasi melalui Fakultas Pertanian dalam pelatihan agroforestri dan pengembangan kopi Liberika.','Collaboration through the Faculty of Agriculture on agroforestry training and Liberica coffee development.')}

];
---
<section class:list={["partner-section",{compact:!full}]} id="mitra"><div class="container">
<header class="partner-heading"><div><p class="eyebrow">{t('Bekerja bersama','Working together')}</p>{full?<h1>{t('Mitra Kami','Our Partners')}</h1>:<h2>{t('Mitra Kami','Our Partners')}</h2>}<p>{t('Bersama masyarakat dan mitra, kami memperkuat pengelolaan ekosistem dan penghidupan yang berkelanjutan.','With communities and partners, we strengthen ecosystem management and sustainable livelihoods.')}</p></div></header>
<div class="sister"><a href="https://gec.org.my/" target="_blank" rel="noreferrer"><img src="/images/partners/gec.webp" width="388" height="160" loading="lazy" alt="Global Environment Centre"/></a><div><p class="eyebrow">{t('Organisasi saudara','Sister organisation')}</p><h3>Global Environment Centre</h3><p>{t('Yayasan Gambut merupakan organisasi saudara Global Environment Centre (GEC) di Indonesia.','Yayasan Gambut is a sister organisation of Global Environment Centre (GEC) in Indonesia.')}</p></div></div>
<div class="partner-grid">{(full?partners:partners.slice(0,8)).map(p=><article><a class:list={["partner-logo",{faculty:p.logo.includes("faperta-unri")}]} href={p.url} target="_blank" rel="noreferrer" aria-label={p.name}>{p.logo?<img src={p.logo} width="240" height="100" loading="lazy" decoding="async" alt={p.name}/>:<span class="partner-wordmark">{p.short}</span>}</a><h3>{p.short}</h3>{full&&<>{p.name!==p.short&&<p class="partner-fullname">{p.name}</p>}<p>{p.body}</p></>}</article>)}</div>
{full&&<>
<div class="community"><div><p class="eyebrow">{t('Mitra di tingkat tapak','Partners on the ground')}</p><h2>{t('Masyarakat sebagai pelaku utama.','Communities at the heart of the work.')}</h2></div><div><p>{t('Kerja bersama masyarakat mencakup pengelolaan gambut, agroforestri, pemulihan mangrove, dan pengembangan penghidupan.','Work with communities spans peatland management, agroforestry, mangrove restoration, and livelihoods development.')}</p><dl class="collaborator-list">
<dt>Kelompok Sekat Bakau</dt><dd>{t('Pembibitan dan penanaman mangrove serta pertukaran pembelajaran di Buruk Bakul.','Mangrove nurseries, planting, and learning exchanges in Buruk Bakul.')}</dd>
<dt>KTWMJ · Temiang</dt><dd>{t('Pembibitan kopi Liberika, agroforestri, dan pembelajaran pengelolaan ekosistem.','Liberica coffee nurseries, agroforestry, and ecosystem management learning.')}</dd>
<dt>{t('Kelompok Masyarakat Belateram · Tanjung Kuras','Belateram Community Group · Tanjung Kuras')}</dt><dd>{t('Pengembangan kopi Liberika pada lahan gambut.','Liberica coffee development on peatlands.')}</dd>
<dt>Bahtera Melayu</dt><dd>{t('Kegiatan mangrove dan pertukaran pembelajaran bersama masyarakat.','Mangrove activities and community learning exchanges.')}</dd>
<dt>Komunitas Pondok Belantara</dt><dd>{t('Dukungan kegiatan Desember Camp.','Support for Desember Camp activities.')}</dd>
<dt>Lembaga Kelismasy Bengkalis</dt><dd>{t('Dukungan bibit dan penanaman mangrove.','Support for mangrove seedlings and planting.')}</dd>
<dt>Lembaga Rumus Riau</dt><dd>{t('Dukungan bibit kopi Liberika untuk agroforestri di Temeran.','Support for Liberica coffee seedlings for agroforestry in Temeran.')}</dd>
<dt>Suvarnabhumi</dt><dd>{t('Fasilitasi pengemasan dan pemasaran kopi Liberika masyarakat Sungai Linau.','Facilitation of packaging and marketing for community-grown Liberica coffee from Sungai Linau.')}</dd>
</dl></div></div>
<div class="community"><div><p class="eyebrow">{t('Jejaring kolaborasi','Collaboration network')}</p><h2>{t('Berbagi pengetahuan dan memperluas kerja bersama.','Sharing knowledge and extending collaboration.')}</h2></div><div><dl class="collaborator-list">
<dt>KKMD · POKJA PS Riau</dt><dd>{t('Keanggotaan dalam Kelompok Kerja Mangrove Daerah dan Kelompok Kerja Perhutanan Sosial Provinsi Riau.','Membership in Riau’s regional mangrove and social forestry working groups.')}</dd>
<dt>riaucerdas.com · nadariau.com</dt><dd>{t('Kerja sama media untuk diseminasi informasi.','Media collaboration for information dissemination.')}</dd>
</dl></div></div>
</>}
<div class="partner-bottom"><p>{t('Kemitraan lintas tahun yang tumbuh bersama upaya menjaga ekosistem dan kesejahteraan masyarakat.','Partnerships across the years, growing through shared efforts to protect ecosystems and community well-being.')}</p><a class="button primary" href={full?t('/id/hubungi-kami/','/en/contact/'):t('/id/mitra/','/en/partners/')}>{full?t('Bangun kolaborasi','Collaborate with us'):t('Lihat Semua Mitra','View all partners')}</a></div>
</div></section>
<style>
.partner-section{padding:3.5rem 0;background:#fff}.partner-heading{display:flex;justify-content:space-between;align-items:start;gap:2rem}.partner-heading h1,.partner-heading h2{font-size:clamp(2rem,3.5vw,3rem);line-height:1.15;margin-bottom:1rem}.partner-heading p:not(.eyebrow){color:#53645c;max-width:43rem}.period{flex-shrink:0;font-size:.8rem;border:1px solid #dbe4d9;border-radius:2rem;padding:.6rem .9rem;color:#426044}.sister{display:grid;grid-template-columns:12rem 1fr;gap:2rem;align-items:center;margin:1.8rem 0 2.5rem;padding:1.5rem 2rem;background:#eef3e8;border-radius:1rem}.sister img{width:100%;height:auto;max-height:6rem;object-fit:contain}.sister h3{font-size:1.35rem;margin:.25rem 0 .5rem}.sister p:not(.eyebrow){color:#53645c;margin:0}.sister .eyebrow{margin-bottom:.4rem}.subheading{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:1rem}.subheading h3{font-size:1.15rem;margin:0}.subheading a,.community a{font-size:.85rem;color:#205845}.partner-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.partner-grid article{display:flex;flex-direction:column;padding:1.4rem;border:1px solid #dbe4d9;border-radius:.8rem;background:#fafbf7}.partner-name{font-size:1.6rem;font-weight:800;color:#175640;line-height:1.2;min-height:2.2rem;overflow-wrap:anywhere}.partner-grid h3{font-size:1.1rem;line-height:1.45;margin:1rem 0 0}.partner-grid p{font-size:.9rem;line-height:1.65;color:#53645c;margin:1rem 0 1.2rem}.partner-period{margin-top:auto;padding-top:.7rem;border-top:1px solid #dbe4d9;font-size:.77rem;color:#53645c}.partner-bottom{display:flex;gap:2rem;align-items:center;justify-content:space-between;margin-top:1.5rem}.partner-bottom p{font-size:.8rem;max-width:44rem;color:#53645c}.partner-bottom .button{flex-shrink:0}.community{display:grid;grid-template-columns:1fr 1.3fr;gap:3rem;margin-top:3rem;padding-top:2rem;border-top:1px solid #dbe4d9}.community h2{font-size:2rem;max-width:22ch}.community p:not(.eyebrow){color:#53645c}.community a{display:inline-block;padding:.5rem 0}
@media(max-width:1000px){.partner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.partner-heading{flex-direction:column;gap:.5rem}}
@media(max-width:600px){.partner-section{padding:2.5rem 0}.sister{grid-template-columns:1fr;padding:1.3rem;gap:1rem}.sister>a{max-width:11rem}.partner-grid{grid-template-columns:1fr}.subheading,.partner-bottom{align-items:start;flex-direction:column;gap:1rem}.community{grid-template-columns:1fr;gap:1rem}.partner-bottom .button{width:100%}}
.partner-logo{display:flex;align-items:center;justify-content:center;min-height:7.5rem;padding:.75rem;background:white;border-radius:.5rem}.partner-logo img{display:block;width:100%;height:5.5rem;object-fit:contain}.partner-grid .partner-fullname{font-size:.78rem;margin:.3rem 0 0}.partner-grid p:last-child{margin-bottom:0}
.partner-wordmark{font-size:2rem;font-weight:700;color:#175640}.compact .partner-grid article{border:0;border-radius:0;background:transparent;padding:.75rem;text-align:center}.compact .partner-logo{padding:.5rem;min-height:6rem}.compact .partner-logo img{height:4.5rem}.compact .partner-grid h3{font-size:.85rem;margin:.5rem 0 0}.compact .partner-grid{gap:.5rem 1.5rem}.collaborator-list{margin:0}.collaborator-list dt{font-weight:700;margin-top:1.25rem}.collaborator-list dd{margin:.35rem 0 0;color:#53645c;line-height:1.6}.partner-sources{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-top:1.5rem}@media(max-width:600px){.compact .partner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.partner-logo.faculty img{filter:brightness(0);opacity:.8}.compact .partner-grid{grid-template-columns:repeat(6,minmax(0,1fr));gap:1rem}.compact .partner-grid article{padding:.5rem 0}.compact .partner-logo{padding:.4rem}.compact .partner-grid h3{font-size:.78rem}@media(max-width:1000px){.compact .partner-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.compact .partner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
