---
import { getCollection } from 'astro:content'; import ContentLayout from '../layouts/ContentLayout.astro'; import type { Lang } from '../data/site';
const { lang, type }=Astro.props as {lang:Lang,type:'programs'|'articles'|'publications'}; const entries=(await getCollection(type,({data})=>data.language===lang&&data.status==='published')).sort((a,b)=>('order'in a.data&&'order'in b.data)?a.data.order-b.data.order:0);
const labels={programs:{id:['Program','Lima jalur kerja untuk menghubungkan pemulihan ekosistem, penghidupan, dan pengetahuan.'],en:['Programs','Five ways of working that connect ecosystem recovery, livelihoods, and knowledge.']},articles:{id:['Cerita Lapangan','Pembelajaran, suara, dan praktik yang tumbuh dari kerja bersama di lapangan.'],en:['Field Stories','Lessons, voices, and practices emerging from work in the field.']},publications:{id:['Publikasi','Laporan, panduan, dan catatan pembelajaran untuk dipakai bersama.'],en:['Publications','Reports, guides, and learning notes made to be shared.']}} as const; const [title,intro]=labels[type][lang];
const segment=type==='programs'?(lang==='id'?'program':'programs'):type==='articles'?(lang==='id'?'cerita':'field-stories'):(lang==='id'?'publikasi':'publications');
---
<ContentLayout title={title} intro={intro}><section class="section"><div class="container cards">{entries.map(entry=><article><p class="eyebrow">{type==='publications'?entry.data.year:('category'in entry.data?entry.data.category:entry.data.eyebrow)}</p><h2>{entry.data.title}</h2><p>{entry.data.summary}</p><a class="text-link" href={`/${lang}/${segment}/${entry.data.slug}/`}>{lang==='id'?'Selengkapnya':'Learn more'}</a></article>)}</div></section></ContentLayout>
<style>.cards{display:grid;gap:1rem}.cards article{padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright)}.cards h2{font-size:clamp(1.8rem,3vw,3rem)}.cards p:not(.eyebrow){color:var(--muted)}@media(min-width:760px){.cards{grid-template-columns:repeat(2,1fr)}.cards article:first-child{grid-column:1/-1}}</style>
