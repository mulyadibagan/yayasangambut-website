---
import { getCollection } from 'astro:content';
import { programPhotos } from '../data/program-photos';
import ContentLayout from '../layouts/ContentLayout.astro';
import { programApproaches, type Lang } from '../data/site';
import { categoryLabel, excerpt } from '../utils/text';
const { lang, type }=Astro.props as {lang:Lang,type:'programs'|'articles'|'publications'};
let entries:any[] = await getCollection(type as any,({data}:any)=>data.language===lang&&data.status==='published');
let fallback=false;
if(type==='publications'&&!entries.length){entries=await getCollection('publications',({data})=>data.language==='id'&&data.status==='published');fallback=true;}
entries.sort((a,b)=>type==='programs'?a.data.order-b.data.order:type==='articles'?b.data.date.valueOf()-a.data.date.valueOf():b.data.year-a.data.year);
const articleCounts=type==='articles'?{
  id:(await getCollection('articles',({data})=>data.language==='id'&&data.status==='published')).length,
  en:(await getCollection('articles',({data})=>data.language==='en'&&data.status==='published')).length,
}:null;
const topicFacets=type==='articles'?[...entries.reduce((counts:Map<string,number>,entry:any)=>{
  entry.data.categories.forEach((category:string)=>counts.set(category,(counts.get(category)??0)+1));
  return counts;
},new Map<string,number>()).entries()].sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0])).slice(0,8):[];
const publicationFacets=type==='publications'?[...entries.reduce((counts:Map<string,number>,entry:any)=>{
  counts.set(entry.data.category,(counts.get(entry.data.category)??0)+1);
  return counts;
},new Map<string,number>()).entries()].sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0])):[];
const facetLabel=(value:string)=>{
  const words=value.replace(/^desa-/,'').replace(/^kampung-/,'').replace(/^kepenghuluan-/,'').split('-').filter(Boolean).map(word=>word.charAt(0).toUpperCase()+word.slice(1)).join(' ');
  if(lang==='en'){
    if(value==='berita') return 'News';
    if(value.startsWith('desa-')||value.startsWith('kampung-')) return `${words} Village`;
  }
  return words;
};
const labels={programs:{id:['Program','Lima bidang program untuk pemulihan ekosistem, pengelolaan sumber daya alam, dan pengembangan penghidupan masyarakat.'],en:['Programs','Five program areas supporting ecosystem restoration, natural resource management, and community livelihoods.']},articles:{id:['Cerita Lapangan',`${entries.length} cerita, berita, dan pembelajaran dari kerja lapangan Yayasan Gambut.`],en:['Field Stories',`${entries.length} stories and lessons from Yayasan Gambut’s field work.`]},publications:{id:['Publikasi',`${entries.length} laporan, panduan, dan bahan pembelajaran untuk dibaca atau diunduh.`],en:['Publications',`${entries.length} reports, guides, and learning resources available to read or download.`]}} as const;
const [title,intro]=labels[type][lang];
const segment=type==='programs'?(lang==='id'?'program':'programs'):type==='articles'?(lang==='id'?'cerita':'field-stories'):(lang==='id'?'publikasi':'publications');
---
<ContentLayout title={title} intro={intro}>
  <section class="section"><div class="container" data-archive-root data-lang={lang} data-archive-type={type}>
    {type==='publications'&&<p><a class="text-link" href={lang==='id'?'/id/pengetahuan/':'/en/knowledge/'}>{lang==='id'?'← Pengetahuan dan Referensi':'← Knowledge and Resources'}</a></p>}
    {fallback&&<aside class="archive-note archive-scope"><div><strong>Indonesian-language collection</strong><p>English editions are not yet available. Titles and summaries are presented in their original Indonesian form.</p></div><a class="text-link" href="/id/publikasi/" hreflang="id">Open the Indonesian archive</a></aside>}
    {type==='articles'&&lang==='en'&&articleCounts&&articleCounts.id>articleCounts.en&&<aside class="archive-note archive-scope"><div><strong>English archive</strong><p>{articleCounts.en} selected stories are available in English. The Indonesian archive currently contains {articleCounts.id} stories.</p></div><a class="text-link" href="/id/cerita/" hreflang="id">Explore the Indonesian archive</a></aside>}
    {type==='articles'&&<div class="filter-status" data-filter-status role="status" hidden><span data-filter-copy></span><a href={`/${lang}/${segment}/`}>{lang==='id'?'Hapus filter':'Clear filter'}</a></div>}
    {type==='articles'&&<div class="archive-tools"><label><span>{lang==='id'?'Cari cerita':'Search stories'}</span><input type="search" data-archive-search placeholder={lang==='id'?'Judul, topik, atau lokasi…':'Title, topic, or location…'} autocomplete="off"/></label><span data-result-count aria-live="polite">{entries.length} {lang==='id'?'cerita':'stories'}</span></div>}
    {type==='articles'&&topicFacets.length>0&&<nav class="topic-filters" aria-label={lang==='id'?'Saring cerita berdasarkan topik atau lokasi':'Filter stories by topic or location'}><a href={`/${lang}/${segment}/`} data-filter-chip="all">{lang==='id'?'Semua cerita':'All stories'}</a>{topicFacets.map(([value,count])=><a href={`/${lang}/${segment}/?category=${encodeURIComponent(value)}`} data-filter-chip={value}><span>{facetLabel(value)}</span><small>{count}</small></a>)}</nav>}
    {type==='publications'&&<div class="archive-tools"><label><span>{lang==='id'?'Cari publikasi':'Search publications'}</span><input type="search" data-publication-search placeholder={lang==='id'?'Judul, kategori, atau tahun…':'Title, category, or year…'} autocomplete="off"/></label><span data-publication-count aria-live="polite">{entries.length} {lang==='id'?'dokumen':'documents'}</span></div>}
    {type==='publications'&&publicationFacets.length>0&&<nav class="topic-filters" aria-label={lang==='id'?'Saring publikasi berdasarkan jenis':'Filter publications by type'}><button type="button" data-publication-filter="all" aria-pressed="true">{lang==='id'?'Semua dokumen':'All documents'}</button>{publicationFacets.map(([value,count])=><button type="button" data-publication-filter={value} aria-pressed="false"><span>{value}</span><small>{count}</small></button>)}</nav>}
    {type==='programs'&&<h2 id="program-areas-title" class="sr-only">{lang==='id'?'Lima fokus program':'Five program areas'}</h2>}
    {type!=='programs'&&<h2 id={`${type}-archive-title`} class="sr-only">{type==='articles'?(lang==='id'?'Daftar cerita lapangan':'Field-story list'):(lang==='id'?'Daftar publikasi':'Publication list')}</h2>}
    <section class:list={['cards',type]} aria-labelledby={type==='programs'?'program-areas-title':`${type}-archive-title`}>{entries.map((entry,index)=>{
      const internal=!fallback||type!=='publications';
      const href=internal?`/${lang}/${segment}/${entry.data.slug}/`:entry.data.fileUrl;
      return <article lang={fallback&&lang==='en'?'id':undefined} data-archive-card data-categories={type==='articles'?entry.data.categories.join(' '):undefined} data-tags={type==='articles'?entry.data.tags.join(' '):undefined} data-publication-category={type==='publications'?entry.data.category.toLowerCase():undefined} data-search={type==='articles'?`${entry.data.title} ${entry.data.summary} ${entry.data.author} ${entry.data.category} ${entry.data.categories.join(' ')} ${entry.data.tags.join(' ')}`.toLowerCase():type==='publications'?`${entry.data.title} ${entry.data.summary} ${entry.data.category} ${entry.data.year}`.toLowerCase():undefined}>
        {type==='programs'&&<img src={programPhotos[index].src} alt={programPhotos[index][lang]} width="900" height="600" loading="lazy"/>}
        {type==='articles'&&entry.data.featuredImage&&<img src={entry.data.featuredImage} width="900" height="600" loading="lazy" alt={entry.data.imageAlt||entry.data.title}/>}
        {type==='publications'&&entry.data.cover&&<img class="cover" src={entry.data.cover} width="700" height="900" loading="lazy" alt={entry.data.title}/>}
        <div><p class="eyebrow">{type==='publications'?`${entry.data.category} · ${entry.data.year}`:('category'in entry.data?categoryLabel(entry.data.category,lang):entry.data.eyebrow)}</p>{type==='programs'?<h3>{entry.data.title}</h3>:<h2>{entry.data.title}</h2>}<p>{excerpt(entry.data.summary,190)}</p>{type==='articles'&&<p class="date"><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString(lang==='id'?'id-ID':'en-GB',{year:'numeric',month:'long',day:'numeric'})}</time></p>}{type==='publications'&&<p class="document-language"><span>{lang==='id'?'Bahasa dokumen':'Document language'}</span> {entry.data.documentLanguage==='en'?'English':'Bahasa Indonesia'}</p>}<div class="card-actions">{type==='publications'&&internal&&<a class="text-link" href={href}>{lang==='id'?'Lihat detail':'View details'}</a>}{type==='publications'?<a class="text-link external" href={entry.data.fileUrl} target="_blank" rel="noreferrer">{lang==='id'?'Buka PDF':'Open PDF'}</a>:<a class="text-link" href={href} aria-label={type==='programs'?(lang==='id'?`Selengkapnya tentang ${entry.data.title}`:`Learn more about ${entry.data.title}`):undefined}>{lang==='id'?'Selengkapnya':'Learn more'}</a>}</div></div>
      </article>
    })}</section>
    {type==='articles'&&<div class="archive-empty" data-empty-state hidden><h2>{lang==='id'?'Belum ada cerita yang cocok':'No matching stories yet'}</h2><p>{lang==='id'?'Coba kata kunci lain atau hapus filter untuk melihat seluruh arsip.':'Try another search term or clear the filter to view the full archive.'}</p><a class="button secondary" href={`/${lang}/${segment}/`}>{lang==='id'?'Lihat seluruh cerita':'View all stories'}</a></div>}
    {type==='publications'&&<div class="archive-empty" data-publication-empty hidden><h2>{lang==='id'?'Publikasi tidak ditemukan':'No matching publications'}</h2><p>{lang==='id'?'Coba kata kunci atau jenis dokumen lain.':'Try another keyword or document type.'}</p><button class="button secondary" type="button" data-publication-reset>{lang==='id'?'Atur ulang pencarian':'Reset search'}</button></div>}
  </div></section>
  {type==='programs'&&<section class="methods section"><div class="container"><p class="eyebrow">{lang==='id'?'Pendekatan lintas program':'Cross-program approach'}</p><h2>{lang==='id'?'Cara Kami Bekerja':'How We Work'}</h2><p class="section-intro">{lang==='id'?'Empat prinsip yang diterapkan di seluruh program Yayasan Gambut.':'Four principles applied across all Yayasan Gambut programs.'}</p><div class="service-grid">{programApproaches[lang].map(service=><article><h3>{service.title}</h3><p>{service.body}</p></article>)}</div></div></section>}
  {type==='programs'&&<section class="projects section" id="proyek"><div class="container"><p class="eyebrow">{lang==='id'?'Pelaksanaan program':'Program implementation'}</p><h2>{lang==='id'?'Inisiatif 2026':'2026 Initiatives'}</h2><ul class="timeline">
<li><time>2025–2026</time><div><h3>{lang==='id'?'Konservasi Mangrove · Aramco–GEC':'Mangrove Conservation · Aramco–GEC'}</h3><p>{lang==='id'?'Pembibitan, penanaman, perlindungan pesisir, dan pemantauan bersama kelompok di Buruk Bakul, Kelapa Pati, Sepahat, dan Tanjung Kuras. Fase ketiga berlangsung Juli 2025–Desember 2026.':'Nurseries, planting, coastal protection, and monitoring with groups in Buruk Bakul, Kelapa Pati, Sepahat, and Tanjung Kuras. The third phase runs from July 2025 to December 2026.'}</p></div></li>
<li><time>2026–2027</time><div><h3>SPM–CLS · Global Environment Centre</h3><p>{lang==='id'?'Pengelolaan gambut dan penguatan penghidupan di Bengkalis dan Siak, Mei 2026–Februari 2027. Kegiatan mencakup pelatihan pembibitan kopi, sekat kanal, dan sistem peringkat bahaya kebakaran.':'Peatland management and livelihood support in Bengkalis and Siak, May 2026–February 2027. Activities include coffee nursery training, canal blocking, and fire danger rating systems.'}</p></div></li>
<li><time>2026–2027</time><div><h3>{lang==='id'?'Pengembangan KUPS Dayun · APRIL Group':'KUPS Development in Dayun · APRIL Group'}</h3><p>{lang==='id'?'Program Oktober 2026–September 2027 mendukung KUPS Rimba Sejahtera melalui penguatan kelembagaan, perencanaan usaha, dan pengelolaan kebun nanas.':'The October 2026–September 2027 program supports the Rimba Sejahtera KUPS through institutional development, business planning, and pineapple cultivation.'}</p><a class="text-link" href="https://webgisyg.id/dayun.html" target="_blank" rel="noreferrer">{lang==='id'?'Lihat program Dayun':'View the Dayun program'}</a></div></li>
</ul></div></section>}
{type==='articles'&&<script is:inline>
  document.querySelectorAll('[data-archive-root]').forEach((root) => {
    const params = new URLSearchParams(window.location.search);
    const filterType = params.has('category') ? 'category' : params.has('tag') ? 'tag' : '';
    const value = filterType ? params.get(filterType)?.trim().toLowerCase() : '';
    const field = filterType === 'category' ? 'categories' : 'tags';
    const cards = [...root.querySelectorAll('[data-archive-card]')];
    const status = root.querySelector('[data-filter-status]');
    const copy = root.querySelector('[data-filter-copy]');
    const search = root.querySelector('[data-archive-search]');
    const resultCount = root.querySelector('[data-result-count]');
    const emptyState = root.querySelector('[data-empty-state]');
    const filterChips = [...root.querySelectorAll('[data-filter-chip]')];
    const isIndonesian = root.dataset.lang === 'id';

    const applyFilters = () => {
      const term = search?.value.trim().toLowerCase() || '';
      let visible = 0;
      cards.forEach((card) => {
        const values = filterType && value ? (card.dataset[field] || '').toLowerCase().split(/\s+/).filter(Boolean) : [];
        const matchesQuery = !filterType || !value || values.includes(value);
        const matchesSearch = !term || (card.dataset.search || '').includes(term);
        const matches = matchesQuery && matchesSearch;
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      if (resultCount) resultCount.textContent = `${visible} ${isIndonesian ? 'cerita' : visible === 1 ? 'story' : 'stories'}`;
      if (emptyState) emptyState.hidden = visible !== 0;
      if (status && copy && filterType && value) {
        const filterLabel = isIndonesian ? (filterType === 'category' ? 'kategori' : 'tag') : filterType;
        copy.textContent = visible
          ? (isIndonesian ? `${visible} cerita untuk ${filterLabel} “${value}”` : `${visible} ${visible === 1 ? 'story' : 'stories'} for ${filterLabel} “${value}”`)
          : (isIndonesian ? `Belum ada cerita untuk ${filterLabel} “${value}”.` : `No stories found for ${filterLabel} “${value}”.`);
        status.hidden = false;
      }
      filterChips.forEach((chip) => {
        const active = filterType === 'category' && value ? chip.dataset.filterChip.toLowerCase() === value : chip.dataset.filterChip === 'all';
        if (active) chip.setAttribute('aria-current','page'); else chip.removeAttribute('aria-current');
      });
    };

    search?.addEventListener('input', applyFilters);
    applyFilters();
  });
</script>}
{type==='publications'&&<script is:inline>
  document.querySelectorAll('[data-archive-type="publications"]').forEach((root) => {
    const search = root.querySelector('[data-publication-search]');
    const buttons = [...root.querySelectorAll('[data-publication-filter]')];
    const cards = [...root.querySelectorAll('[data-archive-card]')];
    const count = root.querySelector('[data-publication-count]');
    const empty = root.querySelector('[data-publication-empty]');
    const reset = root.querySelector('[data-publication-reset]');
    const isIndonesian = root.dataset.lang === 'id';
    let category = 'all';
    const apply = () => {
      const term = search?.value.trim().toLowerCase() || '';
      let visible = 0;
      cards.forEach((card) => {
        const matchesCategory = category === 'all' || card.dataset.publicationCategory === category;
        const matchesSearch = !term || (card.dataset.search || '').includes(term);
        card.hidden = !(matchesCategory && matchesSearch);
        if (!card.hidden) visible += 1;
      });
      if (count) count.textContent = `${visible} ${isIndonesian ? 'dokumen' : visible === 1 ? 'document' : 'documents'}`;
      if (empty) empty.hidden = visible !== 0;
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      category = button.dataset.publicationFilter.toLowerCase();
      buttons.forEach((item) => item.setAttribute('aria-pressed',String(item === button)));
      apply();
    }));
    search?.addEventListener('input',apply);
    reset?.addEventListener('click',() => {
      if (search) search.value = '';
      category = 'all';
      buttons.forEach((item) => item.setAttribute('aria-pressed',String(item.dataset.publicationFilter === 'all')));
      apply();
      search?.focus();
    });
  });
</script>}
<style>
  .archive-note{max-width:48rem;margin:0 0 2rem;padding:1rem;border-left:3px solid var(--coast-700);color:var(--muted)}.archive-scope{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;max-width:none;background:#dce8e6}.archive-scope p{margin:.3rem 0 0}.filter-status{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem;margin:0 0 1rem;padding:1rem 1.2rem;border-radius:var(--radius-sm);background:#dce8e6;font-weight:750}.filter-status a{font-size:.85rem}.archive-tools{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1rem}.archive-tools label{display:grid;gap:.45rem;width:min(100%,32rem);font-size:.78rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.archive-tools input{width:100%;min-height:3.2rem;padding:.75rem 1rem;border:1px solid var(--line);border-radius:999px;color:var(--ink);background:var(--paper-bright)}.archive-tools>span{color:var(--muted);font-size:.85rem;font-weight:750}.topic-filters{display:flex;gap:.55rem;overflow-x:auto;margin:0 0 2rem;padding:.3rem 0 .7rem;scrollbar-width:thin}.topic-filters a,.topic-filters button{display:inline-flex;flex:0 0 auto;align-items:center;gap:.55rem;padding:.58rem .85rem;border:1px solid var(--line);border-radius:999px;background:var(--paper-bright);color:var(--ink);font:750 .8rem/1 var(--sans);text-decoration:none;cursor:pointer}.topic-filters a[aria-current="page"],.topic-filters button[aria-pressed="true"]{border-color:var(--coast-700);background:var(--coast-700);color:white}.topic-filters small{display:grid;place-items:center;min-width:1.45rem;height:1.45rem;padding:0 .3rem;border-radius:999px;background:#dce8e6;color:var(--coast-700);font-size:.7rem}.topic-filters a[aria-current="page"] small,.topic-filters button[aria-pressed="true"] small{background:rgba(255,255,255,.18);color:white}.archive-empty{max-width:42rem;margin:3rem auto 0;padding:2.5rem;text-align:center;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright)}.archive-empty h2{font-size:clamp(1.8rem,4vw,3rem)}.archive-empty p{color:var(--muted)}.cards{display:grid;gap:1rem}.cards article{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--paper-bright)}.cards article>div{padding:clamp(1.3rem,3vw,2.2rem)}.cards h2,.cards h3{font:750 clamp(1.15rem,1.6vw,1.5rem)/1.25 var(--sans)}.cards p:not(.eyebrow){color:var(--muted)}.cards article>img{aspect-ratio:3/2;object-fit:cover}.cards article>.cover{aspect-ratio:4/3;object-fit:contain;padding:1rem;background:#e8ebe6}.date{font-size:.82rem;font-weight:750}.document-language{font-size:.8rem}.document-language span{font-weight:800}.card-actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1rem}.methods{background:var(--paper-bright)}.methods h2,.projects h2{max-width:13ch}.section-intro{max-width:48rem;color:var(--muted)}.service-grid{display:grid;gap:1rem;margin-top:2.5rem}.service-grid article{padding:1.5rem;border:1px solid var(--line);border-radius:var(--radius-md)}.service-grid h3{font:500 1.55rem/1.1 var(--serif)}.service-grid p{color:var(--muted)}.projects{background:#dce8e6}.timeline{margin:2.5rem 0 0;padding:0;border-top:1px solid var(--line);list-style:none}.timeline li{display:grid;grid-template-columns:5rem 1fr;gap:1rem;padding:1.3rem 0;border-bottom:1px solid var(--line)}.timeline time{font-weight:800;color:var(--coast-700)}.timeline p{margin:0;max-width:55rem}
  @media(min-width:760px){.cards,.service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cards.publications{grid-template-columns:1fr}.cards.publications article{display:grid;grid-template-columns:10rem 1fr}.cards.publications article>.cover{height:100%;max-height:18rem;aspect-ratio:auto}.cards.articles article>img{aspect-ratio:16/10}.cards.articles article{display:flex;flex-direction:column}.cards.articles article>div{display:flex;flex-direction:column;flex:1}.cards.articles .card-actions{margin-top:auto;padding-top:1rem}.timeline li{grid-template-columns:8rem 1fr}}
  @media(min-width:1040px){.cards.programs{grid-template-columns:repeat(3,minmax(0,1fr))}}
.cards article>div{padding:1.3rem}.cards.programs article>img{aspect-ratio:16/9}.cards article{border-color:transparent;box-shadow:0 3px 16px #102e2806}.cards .eyebrow{font-size:.75rem}.cards p{font-size:.95rem}.cards{gap:1.4rem}.service-grid h3{font-weight:750;font-size:1.25rem}@media(min-width:1100px){.cards.articles{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
</ContentLayout>
