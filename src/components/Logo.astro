---
const { inverse = false } = Astro.props;
---
<a class:list={['brand', { inverse }]} href={Astro.currentLocale === 'en' ? '/en/' : '/id/'} aria-label="Yayasan Gambut — home"><img src="/brand/yayasan-gambut-logo.png" width="64" height="64" alt="" /><span><strong>Yayasan</strong><strong>Gambut</strong></span></a>
<style>.brand{display:inline-flex;align-items:center;gap:.65rem;flex-shrink:0;color:#70452f;text-decoration:none}.brand img{width:3.9rem;height:3.9rem;object-fit:contain}.brand span{display:grid;line-height:1.06;font-size:1.2rem;letter-spacing:-.025em}.brand.inverse{color:white}.brand.inverse{gap:.8rem}.brand.inverse img{box-sizing:border-box;width:4.5rem;height:4.5rem;flex:none;padding:.35rem;border-radius:.7rem;background:#fff;filter:none}.brand.inverse span{color:#fff;font-size:1.2rem;line-height:1.12}@media(max-width:679px){.brand img{width:3.5rem;height:3.5rem}.brand span{font-size:1.1rem}}</style>
