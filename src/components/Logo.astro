---
const { inverse = false } = Astro.props;
---
<a class:list={['brand', { inverse }]} href={Astro.currentLocale === 'en' ? '/en/' : '/id/'} aria-label="Yayasan Gambut — home"><img src="/brand/yayasan-gambut-logo.png" width="56" height="56" alt="" /><span><strong>Yayasan</strong><strong>Gambut</strong></span></a>
<style>.brand{display:inline-flex;align-items:center;gap:.5rem;color:var(--forest-950);text-decoration:none}.brand img{width:2.65rem;height:2.65rem;object-fit:contain}.brand span{display:grid;line-height:.88;font-size:1rem;letter-spacing:-.025em}.brand.inverse{color:white}.brand.inverse img{filter:drop-shadow(0 0 1px rgba(255,255,255,.9))}</style>
