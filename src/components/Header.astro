---
import Logo from './Logo.astro';
import { copy, pagePairs, routeMap, type Lang } from '../data/site';

const lang = (Astro.currentLocale ?? 'id') as Lang;
const c = copy[lang];
const r = routeMap[lang];
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const alternate = pagePairs[currentPath] ?? (lang === 'id' ? '/en/' : '/id/');
const nav = [r.about, r.programs, r.locations, r.impact, r.stories, r.publications];
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href);
---
<header class="site-header"><div class="container bar"><Logo /><nav aria-label={lang === 'id' ? 'Navigasi utama' : 'Primary navigation'}><ul>{c.nav.map((label,index)=><li><a href={nav[index]} aria-current={isActive(nav[index])?'page':undefined}>{label}</a></li>)}</ul></nav><div class="actions"><a class="lang" href={alternate} hreflang={lang === 'id' ? 'en' : 'id'} title={pagePairs[currentPath] ? undefined : (lang === 'id' ? 'Buka beranda dalam bahasa Inggris' : 'Open the Indonesian homepage')}>{lang === 'id' ? 'EN' : 'ID'}</a><a class="webgis" href="https://webgisyg.id/" target="_blank" rel="noreferrer">WebGIS <span aria-hidden="true">↗</span></a></div><details class="mobile-menu"><summary><span>Menu</span><span class="menu-icon" aria-hidden="true"></span></summary><div>{c.nav.map((label,index)=><a href={nav[index]} aria-current={isActive(nav[index])?'page':undefined}>{label}</a>)}<a href={r.contact} aria-current={isActive(r.contact)?'page':undefined}>{lang === 'id' ? 'Hubungi Kami' : 'Contact'}</a><a href={alternate} hreflang={lang === 'id' ? 'en' : 'id'}>{lang === 'id' ? 'English' : 'Bahasa Indonesia'}</a><a href="https://webgisyg.id/" target="_blank" rel="noreferrer">WebGIS ↗</a></div></details></div></header>
<style>
  .site-header{position:sticky;top:0;z-index:20;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--paper) 92%,transparent);backdrop-filter:blur(14px)}.bar{min-height:5rem;display:flex;align-items:center;justify-content:space-between;gap:1rem}nav{display:none}ul{display:flex;gap:1.35rem;margin:0;padding:0;list-style:none}nav a,.lang{position:relative;font-size:.85rem;font-weight:700;text-decoration:none}nav a::after{content:'';position:absolute;right:0;bottom:-.5rem;left:0;height:2px;transform:scaleX(0);background:var(--coast-700);transition:transform .2s}nav a:hover::after,nav a[aria-current='page']::after{transform:scaleX(1)}nav a[aria-current='page']{color:var(--coast-700)}.lang:hover{text-decoration:underline}.actions{display:none;align-items:center;gap:1rem}.webgis{padding:.68rem 1rem;border-radius:999px;background:var(--forest-950);color:white;font-size:.85rem;font-weight:750;text-decoration:none}.mobile-menu{position:relative}.mobile-menu summary{display:flex;align-items:center;gap:.6rem;cursor:pointer;list-style:none;padding:.6rem .9rem;border:1px solid var(--line);border-radius:999px;font-weight:750}.mobile-menu summary::-webkit-details-marker{display:none}.menu-icon{position:relative;width:1rem;height:.75rem;border-top:2px solid currentColor;border-bottom:2px solid currentColor}.menu-icon::after{content:'';position:absolute;top:50%;left:0;width:100%;border-top:2px solid currentColor;transform:translateY(-50%)}.mobile-menu[open] .menu-icon{border:0}.mobile-menu[open] .menu-icon::before,.mobile-menu[open] .menu-icon::after{content:'';position:absolute;top:50%;left:0;width:100%;border-top:2px solid currentColor}.mobile-menu[open] .menu-icon::before{transform:rotate(45deg)}.mobile-menu[open] .menu-icon::after{transform:rotate(-45deg)}.mobile-menu div{position:absolute;right:0;top:calc(100% + .7rem);width:min(19rem,calc(100vw - 2rem));display:grid;padding:.6rem;border:1px solid var(--line);border-radius:1rem;background:var(--paper-bright);box-shadow:var(--shadow)}.mobile-menu a{padding:.72rem;border-radius:.55rem;text-decoration:none;font-weight:700}.mobile-menu a:hover,.mobile-menu a[aria-current='page']{background:#e6efec;color:var(--forest-950)}
  @media(min-width:1020px){nav,.actions{display:flex}.mobile-menu{display:none}}
</style>
