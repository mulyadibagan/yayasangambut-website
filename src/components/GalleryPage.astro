---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import type { Lang } from '../data/site';
const {lang}=Astro.props as {lang:Lang};
const galleries=(await getCollection('gallery',({data})=>data.language==='id'&&data.status==='published')).sort((a,b)=>a.data.order-b.data.order);
const imageCount=galleries.reduce((total,album)=>total+album.data.images.length,0);
const galleryCopy:Record<string,{id:{title:string,summary:string},en:{title:string,summary:string}}>= {
  'kampung-tanjung-kuras':{id:{title:'Kampung Tanjung Kuras',summary:'Bentang pesisir, kehidupan masyarakat, dan ruang hidup di Kampung Tanjung Kuras, Kabupaten Siak.'},en:{title:'Tanjung Kuras Village',summary:'Coastal landscapes, community life, and local living spaces in Tanjung Kuras Village, Siak Regency.'}},
  'kopi-liberika-dan-agroforestri':{id:{title:'Kopi Liberika dan Agroforestri',summary:'Materi visual tentang kopi Liberika dan pendekatan agroforestri pada lahan gambut.'},en:{title:'Liberica Coffee and Agroforestry',summary:'Visual material on Liberica coffee and agroforestry approaches on peatlands.'}},
  'potensi-sagu-di-kabupaten-bengkalis':{id:{title:'Potensi Sagu di Kabupaten Bengkalis',summary:'Dokumentasi potensi sagu sebagai komoditas yang sesuai dengan kondisi lahan basah di Kabupaten Bengkalis.'},en:{title:'Sago Potential in Bengkalis Regency',summary:'Documentation of sago as a commodity suited to wetland conditions in Bengkalis Regency.'}},
  'budidaya-nanas-di-lahan-gambut':{id:{title:'Budidaya Nanas di Lahan Gambut',summary:'Tahapan dan praktik budidaya nanas sebagai salah satu pilihan penghidupan pada lahan gambut.'},en:{title:'Pineapple Cultivation on Peatlands',summary:'Stages and practices of pineapple cultivation as one livelihood option on peatlands.'}},
  'flora-alami-ekosistem-rawa-gambut':{id:{title:'Flora Alami Ekosistem Rawa Gambut',summary:'Pengenalan tumbuhan alami rawa gambut dan nilai ekologis serta pemanfaatannya bagi masyarakat.'},en:{title:'Native Flora of Peat-Swamp Ecosystems',summary:'An introduction to native peat-swamp plants, their ecological value, and community uses.'}},
  'mengenal-paludikultur':{id:{title:'Mengenal Paludikultur',summary:'Pengenalan budidaya yang mempertahankan kondisi basah gambut, termasuk sagu sebagai salah satu komoditas yang relevan.'},en:{title:'Understanding Paludiculture',summary:'An introduction to cultivation that maintains wet peat conditions, including sago as one relevant commodity.'}},
  'mengenal-lanskap-giam-siak-kecil':{id:{title:'Mengenal Lanskap Giam Siak Kecil–Bukit Batu',summary:'Gambaran visual ekosistem gambut dan kekayaan hayati di lanskap Giam Siak Kecil–Bukit Batu.'},en:{title:'The Giam Siak Kecil–Bukit Batu Landscape',summary:'A visual introduction to the peatland ecosystem and biodiversity of the Giam Siak Kecil–Bukit Batu landscape.'}},
  'pltb-jahe-merah-dan-turunannya':{id:{title:'Pertanian Tanpa Bakar: Jahe Merah dan Produk Turunannya',summary:'Dokumentasi budidaya jahe merah tanpa bakar dan pengembangan produk oleh Kelompok Tani Wanita Makmur Jaya di Desa Temiang.'},en:{title:'Zero-Burning Farming: Red Ginger and Derived Products',summary:'Documentation of zero-burning red-ginger cultivation and product development by Makmur Jaya Women Farmers Group in Temiang Village.'}},
  'mengenal-fdrs-spbk':{id:{title:'Mengenal FDRS / SPBK',summary:'Pengenalan Sistem Peringkat Bahaya Kebakaran sebagai bagian dari kesiapsiagaan dan pencegahan kebakaran hutan dan lahan.'},en:{title:'Understanding FDRS / SPBK',summary:'An introduction to the Fire Danger Rating System as part of forest and land-fire preparedness and prevention.'}},
};
---
<ContentLayout title={lang==='id'?'Galeri':'Gallery'} intro={lang==='id'?`${imageCount} foto dalam ${galleries.length} album dokumentasi lapangan dari arsip website Yayasan Gambut.`:`${imageCount} ${imageCount===1?'photograph':'photographs'} across ${galleries.length} field-documentation ${galleries.length===1?'album':'albums'} from the Yayasan Gambut website archive.`}>
  <section class="section"><div class="container albums">
    <aside class="archive-note"><strong>{lang==='id'?'Tentang arsip ini':'About this archive'}</strong><p>{lang==='id'?'Foto memberikan konteks visual atas kegiatan dan lokasi. Foto bukan pengganti data pemantauan atau bukti dampak; hasil terverifikasi tersedia pada halaman Dampak dan YG GeoPortal.':'Photographs provide visual context for activities and locations. They do not replace monitoring data or impact evidence; verified results are available on the Impact page and YG GeoPortal.'}</p></aside>
    <nav class="album-nav" aria-label={lang==='id'?'Daftar album':'Album index'}>{galleries.map((album,index)=>{const copy=galleryCopy[album.data.slug]?.[lang];return <a href={`#${album.data.slug}`}><span>{String(index+1).padStart(2,'0')}</span>{copy?.title??album.data.title}</a>})}</nav>
    {galleries.map((album,albumIndex)=><article class="album" id={album.data.slug}>
      <header lang={lang}><span>{String(albumIndex+1).padStart(2,'0')}</span><div><h2>{galleryCopy[album.data.slug]?.[lang]?.title??album.data.title}</h2><p>{galleryCopy[album.data.slug]?.[lang]?.summary??album.data.summary}</p><small>{album.data.images.length} {lang==='id'?'foto':'photos'}</small></div></header>
      <div class="photos">{album.data.images.map((src,index)=><a href={src} target="_blank" rel="noreferrer" data-gallery-link data-caption={`${galleryCopy[album.data.slug]?.[lang]?.title??album.data.title} — ${lang==='id'?'foto':'photo'} ${index+1}`}><img src={src} width="900" height="700" loading="lazy" decoding="async" alt={`${galleryCopy[album.data.slug]?.[lang]?.title??album.data.title} — ${lang==='id'?'foto':'photo'} ${index+1}`}/><span class="sr-only">{lang==='id'?'Buka foto ukuran penuh':'Open full-size photograph'}</span></a>)}</div>
    </article>)}
    <dialog class="lightbox" data-lightbox aria-label={lang==='id'?'Pratinjau foto':'Photo preview'}><button type="button" data-lightbox-close aria-label={lang==='id'?'Tutup pratinjau':'Close preview'}>×</button><figure><img data-lightbox-image width="1600" height="1200" alt=""/><figcaption data-lightbox-caption></figcaption></figure></dialog>
  </div></section>
</ContentLayout>
<script is:inline>
  const dialog=document.querySelector('[data-lightbox]');
  const image=dialog?.querySelector('[data-lightbox-image]');
  const caption=dialog?.querySelector('[data-lightbox-caption]');
  document.querySelectorAll('[data-gallery-link]').forEach((link)=>link.addEventListener('click',(event)=>{
    if(!dialog?.showModal||!image||!caption)return;
    event.preventDefault();
    image.src=link.href;
    image.alt=link.dataset.caption||'';
    caption.textContent=link.dataset.caption||'';
    dialog.showModal();
  }));
  dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click',()=>dialog.close());
  dialog?.addEventListener('click',(event)=>{if(event.target===dialog)dialog.close()});
</script>
<style>
  .archive-note{max-width:58rem;margin:0 0 2rem;padding:1.2rem;border-left:3px solid var(--coast-700);background:#dce8e6;color:var(--muted)}.archive-note p{margin:.35rem 0 0}.album-nav{display:flex;gap:.55rem;overflow-x:auto;margin-bottom:2rem;padding:.3rem 0 .8rem;scrollbar-width:thin}.album-nav a{display:inline-flex;flex:0 0 auto;align-items:center;gap:.55rem;max-width:18rem;padding:.65rem .9rem;border:1px solid var(--line);border-radius:999px;color:var(--ink);background:var(--paper-bright);font-size:.78rem;font-weight:750;text-decoration:none}.album-nav span{color:var(--coast-700)}.album{padding:0 0 2.5rem;margin:0 0 2.5rem;border-bottom:1px solid var(--line);scroll-margin-top:7rem}.album header{display:grid;grid-template-columns:3rem 1fr;gap:1rem;margin-bottom:1.5rem}.album header>span{font-weight:850;color:var(--coast-700)}.album h2{margin-bottom:.7rem;font-size:clamp(1.5rem,2.5vw,2.3rem)}.album header p{max-width:50rem;color:var(--muted)}.album small{font-weight:800;color:var(--peat-700)}.photos{display:grid;grid-template-columns:repeat(2,1fr);gap:.5rem}.photos a{position:relative;overflow:hidden;border-radius:.55rem;background:var(--forest-950)}.photos img{height:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .25s}.photos a:hover img{transform:scale(1.025)}.lightbox{width:min(94vw,76rem);max-height:92vh;padding:0;border:0;border-radius:var(--radius-md);background:var(--forest-950);color:white}.lightbox::backdrop{background:rgba(4,20,17,.88)}.lightbox button{position:absolute;z-index:2;top:.7rem;right:.7rem;display:grid;place-items:center;width:2.8rem;height:2.8rem;border:1px solid rgba(255,255,255,.5);border-radius:999px;background:rgba(4,20,17,.75);color:white;font-size:1.7rem;cursor:pointer}.lightbox figure{margin:0}.lightbox img{width:100%;max-height:82vh;object-fit:contain}.lightbox figcaption{padding:.8rem 1rem;color:rgba(255,255,255,.8);font-size:.8rem}
  @media(min-width:760px){.album header{grid-template-columns:6rem 1fr}.photos{grid-template-columns:repeat(3,1fr);gap:.8rem}}
  @media(min-width:1050px){.photos{grid-template-columns:repeat(4,1fr)}}
</style>
