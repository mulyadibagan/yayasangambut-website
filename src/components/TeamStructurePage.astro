---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamPerson from './TeamPerson.astro';
import type {Lang} from '../data/site';
const {lang}=Astro.props as {lang:Lang};
const id=lang==='id';
const team=await getCollection('team',({data})=>data.language==='id'&&data.status==='published'&&data.group==='Management & Program Team');
const person=(name:string)=>{const m=team.find(m=>m.data.name.startsWith(name));if(!m)throw new Error('Missing structure member: '+name);return m;};
const title=id?'Struktur Tim Inti':'Core Team Structure';
const branches=[
 {names:['Riandra Hamdani'],children:['Ainul Azizah'],label:id?'Program dan komunikasi':'Program and communications'},
 {names:['Zamharir'],children:['Rasid Jul Siregar'],label:id?'Data dan GIS':'Data and GIS'},
 {names:['Arif Sah Putra'],children:[],label:id?'Usaha masyarakat':'Community enterprise'},
 {names:['Raja Alpian','Hendrizal'],children:[],label:id?'Tim lapangan':'Field team'},
 {names:['Khamidi Setyo Budi'],children:[],label:id?'Multimedia':'Multimedia',direct:true},
];
---
<BaseLayout title={title+' — Yayasan Gambut'} description={id?'Struktur pelaporan dan koordinasi tim inti Yayasan Gambut.':'Reporting and coordination structure of the Yayasan Gambut core team.'}>
<section class="org-page"><div class="container">
<a class="back" href={id?'/id/tentang-kami/#tim':'/en/about/#tim'}>{id?'← Kembali ke Tim YG':'← Back to the YG team'}</a>
<header class="org-heading"><p class="eyebrow">YAYASAN GAMBUT</p><h1>{title}</h1></header>
<div class="org-chart" data-team-chart aria-label={title}>
 <svg class="direct-link" aria-hidden="true"><path /></svg>
 <svg class="communication-link" aria-hidden="true"><path /></svg>
 <div class="director"><TeamPerson member={person('Mulyadi')} lang={lang} director/></div>
 <div class="leadership">
  {['Warsito','Rafi Merbamas','Ir. Riena'].map(name=><div class="leader" data-communication-source={name==='Warsito'?'warsito':undefined}><TeamPerson member={person(name)} lang={lang}/></div>)}
 </div>
 <section class="program-team" aria-label={id?'Tim program':'Program team'}>
  <div class="branches">{branches.map(b=><section class:list={['branch',{direct:b.direct}]}>
   <h3>{b.label}</h3><div class="branch-people">{b.names.map(name=><TeamPerson member={person(name)} lang={lang}/>)}</div>
   {b.children.length>0&&<details open class="reports"><summary>{id?'Staf yang dikoordinasikan':'Reporting staff'}</summary><div>{b.children.map(name=><TeamPerson member={person(name)} lang={lang}/>)}</div></details>}
  </section>)}</div>
 </section>
</div>
<p class="communication-caption"><span aria-hidden="true"></span>{id?'Garis biru putus-putus: komunikasi Khamidi Setyo Budi ↔ Warsito; bukan hubungan pelaporan.':'Blue dashed line: communication between Khamidi Setyo Budi and Warsito; not a reporting relationship.'}</p>
</div></section>
</BaseLayout>
<script>
function connectDirector() {
 document.querySelectorAll<HTMLElement>('[data-team-chart]').forEach(chart=>{
  const source=chart.querySelector<HTMLElement>('.director .person');
  const target=chart.querySelector<HTMLElement>('.branch.direct .person');
  const path=chart.querySelector<SVGPathElement>('.direct-link path');
  const communicationSource=chart.querySelector<HTMLElement>('[data-communication-source="warsito"] .person');
  const communicationPath=chart.querySelector<SVGPathElement>('.communication-link path');
  if(!source||!target||!path)return;
  const draw=()=>{
   const box=chart.getBoundingClientRect(),a=source.getBoundingClientRect(),b=target.getBoundingClientRect();
   const x=box.width-5, y1=a.top-box.top+a.height/2, y2=b.top-box.top+b.height/2;
   path.setAttribute('d',`M ${a.right-box.left} ${y1} H ${x} V ${y2} H ${b.right-box.left}`);
   if(communicationSource&&communicationPath){
    const c=communicationSource.getBoundingClientRect();
    // Use the gap between rows on desktop; the left gutter on stacked layouts.
    const route=window.matchMedia('(min-width:1100px)').matches
     ? `M ${c.left-box.left+c.width/2} ${c.bottom-box.top} V ${c.bottom-box.top+12} H ${b.right-box.left+10} V ${b.top-box.top+18} H ${b.right-box.left}`
     : `M ${c.left-box.left} ${c.top-box.top+c.height/2} H 5 V ${b.top-box.top+b.height/2} H ${b.left-box.left}`;
    communicationPath.setAttribute('d',route);
   }
  };
  new ResizeObserver(draw).observe(chart);
  draw();
 });
}
connectDirector();
document.addEventListener('astro:page-load',connectDirector);
</script>
<style>
.org-chart{padding-left:24px;padding-bottom:28px}.communication-link{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:2}.communication-link path{fill:none;stroke:#286b91;stroke-width:2;stroke-dasharray:3 5;stroke-linecap:round}.communication-caption{display:flex;align-items:center;gap:.6rem;color:#285f7d;font-size:.85rem;margin:1rem 0 0}.communication-caption span{width:2rem;flex-shrink:0;border-top:2px dashed #286b91}
.org-page{background:#f5f7f2;padding:2rem 0 4rem}.back{display:inline-flex;align-items:center;min-height:44px;color:#225f49;font-size:.9rem;font-weight:700;text-decoration:none}.back:hover{text-decoration:underline}.org-heading{margin:1.8rem 0 2.5rem}.org-heading h1{font-size:clamp(2rem,4vw,3rem);margin:.6rem 0}
.org-chart{--connector:#91af9e;position:relative;padding-right:24px}.direct-link{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:2}.direct-link path{fill:none;stroke:#477b64;stroke-width:2;stroke-dasharray:7 6;stroke-linecap:round}.director{width:min(100%,23rem);margin:auto;position:relative;padding-bottom:2rem}.director:after{content:'';position:absolute;left:50%;bottom:0;height:2rem;border-left:2px solid var(--connector)}
.leadership{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;max-width:62rem;margin:0 auto;position:relative}.leadership:before{content:'';position:absolute;top:0;left:calc(16.6667% - .33rem);right:calc(16.6667% - .33rem);border-top:2px solid var(--connector)}.leader{position:relative;padding-top:2rem}.leader:before{content:'';position:absolute;height:2rem;left:50%;top:0;border-left:2px solid var(--connector)}.leader :global(.person){height:100%}
.program-team{position:relative;padding-top:2.5rem}.program-team:before{content:'';position:absolute;left:50%;top:0;height:2.5rem;border-left:2px solid var(--connector)}
.branches{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1rem;position:relative}.branches:before{content:'';position:absolute;top:-1rem;left:10%;right:10%;border-top:2px solid var(--connector)}.branch{position:relative;min-width:0;padding-top:1rem}.branch:before{content:'';position:absolute;top:-1rem;left:50%;height:2rem;border-left:2px solid var(--connector)}.branch>h3{font:700 .73rem/1.5 sans-serif;letter-spacing:.03em;text-transform:uppercase;text-align:center;color:#446451;margin:0 0 .7rem;min-height:2.3rem}.branch :global(.person){flex-direction:column;text-align:center;padding:.9rem .7rem;gap:.5rem}.branch :global(.person h2){font-size:.92rem}.branch :global(.person p){font-size:.75rem}.branch-people{display:grid;gap:.8rem}
.reports{margin:0 .3rem;padding-top:1.2rem;position:relative}.reports:before{content:'';position:absolute;left:50%;top:0;height:1.2rem;border-left:2px solid var(--connector)}.reports summary{font-size:.72rem;color:#496353;cursor:pointer;min-height:44px;padding:.45rem .25rem;text-align:center}.reports>div{display:grid;gap:.8rem}

@media(max-width:1099px){.leadership{gap:1rem}.branches{grid-template-columns:1fr;gap:1.3rem}.branches:before,.branch:before{display:none}.branch{padding:0 0 0 1rem;border-left:2px solid var(--connector)}.branch>h3{text-align:left;min-height:0}.branch :global(.person){flex-direction:row;text-align:left;padding:1rem;gap:.8rem}.reports{margin:0 0 0 1rem;padding:1rem 0 0 1rem;border-left:2px solid var(--connector)}.reports:before{display:none}.reports summary{text-align:left}}
@media(max-width:639px){.org-page{padding-top:1rem}.org-heading{margin:1.2rem 0 2rem}.leadership{grid-template-columns:1fr;border-left:2px solid var(--connector);padding-left:1rem;gap:1rem}.leadership:before,.leader:before{display:none}.leader{padding:0}.director{padding-bottom:1rem;margin-left:0}.director:after{left:0;height:1rem}.program-team{padding-top:1.5rem}.program-team:before{display:none}.branch :global(.person h2){font-size:1rem}}
</style>
