---
import { type Lang } from '../data/site';
const {lang} = Astro.props as {lang:Lang};
const id=lang==='id';
const t=(a:string,b:string)=>id?a:b;

const cards=[
 {key:'mangrove',title:t('Restorasi Mangrove','Mangrove Restoration'),value:14.14,unit:'ha',label:t('Luas restorasi tercatat','Recorded restoration area'),intro:t('Penanaman mangrove dan pembibitan masyarakat untuk mendukung pemulihan pesisir.','Mangrove planting and community nurseries supporting coastal recovery.'),rows:[['Total Bibit Ditanam',45915,t('Bibit ditanam','Seedlings planted')],['Rumah Bibit',4,t('Rumah bibit','Community nurseries')],['Desa Program',5,t('Desa program','Program villages')]],note:t('Jumlah bibit ditanam berbeda dari jumlah tanaman hidup. Perkembangan tanaman ditelusuri melalui monitoring lapangan.','Seedlings planted are distinct from surviving trees. Plant development is tracked through field monitoring.'),url:'https://webgisyg.id/programme-detail.html?programme=mangrove'},
 {key:'peat',title:t('Restorasi Gambut','Peatland Restoration'),value:613.75,unit:'ha',label:t('Cakupan restorasi dan estimasi pembasahan','Restoration coverage and estimated rewetting'),intro:t('Pengelolaan air, sekat kanal, dan penanaman untuk menjaga fungsi lahan gambut.','Water management, canal blocks, and planting to support peatland functions.'),rows:[['Total Bibit Ditanam',14230,t('Bibit ditanam','Seedlings planted')],['Sekat Kanal',12,t('Sekat kanal','Canal blocks')],['Estimasi Area Rewetting',600,t('Estimasi pembasahan (ha)','Estimated rewetting (ha)')]],note:t('Cakupan mengikuti perhitungan dashboard, termasuk estimasi pembasahan berbasis jumlah sekat kanal. Angka ini bukan luas pemulihan ekologis yang seluruhnya telah terukur.','Coverage follows the dashboard calculation, including rewetting estimated from canal-block numbers. It is not an entirely measured area of ecological recovery.'),url:'https://webgisyg.id/programme-detail.html?programme=peat'},
 {key:'mineral',title:t('Restorasi Lahan Mineral','Mineral Land Restoration'),value:11.44,unit:'ha',label:t('Luas rehabilitasi tercatat','Recorded rehabilitation area'),intro:t('Pemulihan tutupan vegetasi melalui penanaman dan pemantauan pertumbuhan.','Restoring vegetation cover through planting and growth monitoring.'),rows:[['Total Bibit Ditanam',1200,t('Bibit ditanam','Seedlings planted')],['Menara Air',1,t('Menara air','Water tower')],['Plot Ukur Permanen',7,t('Plot ukur permanen','Permanent measurement plots')]],note:t('Plot ukur permanen membantu mengikuti pertumbuhan tanaman dan perkembangan pemulihan dari waktu ke waktu.','Permanent measurement plots help track plant growth and restoration progress over time.'),url:'https://webgisyg.id/programme-detail.html?programme=mineral'},
 {key:'engagement',title:t('Pelibatan Masyarakat & Kapasitas','Community Engagement & Capacity'),value:1218,unit:'',label:t('Partisipasi tercatat','Recorded participations'),intro:t('Pelatihan dan kegiatan lapangan memperkuat peran masyarakat dalam pengelolaan ekosistem.','Training and field activities strengthen community involvement in ecosystem management.'),rows:[['Kegiatan Tercatat',26,t('Kegiatan tercatat','Recorded activities')],['Perempuan Terlibat',449,t('Partisipasi perempuan','Women’s participations')],['Pemuda Terlibat',173,t('Partisipasi pemuda','Youth participations')]],note:t('Partisipasi dapat mencakup orang yang mengikuti lebih dari satu kegiatan. Kategori perempuan dan pemuda dapat saling beririsan.','Participation may include people attending more than one activity. Women and youth categories may overlap.'),url:'https://webgisyg.id/community-engagement.html'}
];
const fmt=(n:number,d=0)=>new Intl.NumberFormat(id?'id-ID':'en-GB',{maximumFractionDigits:d}).format(n);

const stories=[
 {tag:t('Mangrove & pesisir','Mangroves & coasts'),place:'Buruk Bakul · Bengkalis',period:t('Dokumentasi Mei 2025','Documented May 2025'),image:'/wp-content/uploads/2025/07/DJI_0389-1024x576.jpg',alt:t('Pemecah ombak di pesisir Buruk Bakul','Wave breakers along the Buruk Bakul coast'),title:t('Merawat mangrove, menjaga pesisir.','Caring for mangroves and coasts.'),body:t('Bersama Sekat Bakau dan mitra, penanaman mangrove dipadukan dengan pembibitan masyarakat dan pembangunan pemecah ombak. Laporan Mei 2025 mencatat struktur pemecah ombak sepanjang 200 meter di Buruk Bakul.','With Sekat Bakau and partners, mangrove planting is combined with community nurseries and wave breakers. The May 2025 report documents 200 metres of wave breakers in Buruk Bakul.'),value:'200 m',label:t('pemecah ombak terdokumentasi','of documented wave breakers'),track:t('Perkembangan tanaman, sedimentasi, dan perubahan garis pantai menjadi ukuran lanjutan pemulihan.','Plant development, sedimentation, and shoreline change are the next measures of recovery.'),slug:'pendekatan-kolaboratif-dalam-pemberdayaan-masyarakat-dan-konservasi-kawasan-pesisir-di-kabupaten-bengkalis'},
 {tag:t('Gambut & air','Peatlands & water'),place:'Temiang · Tanjung Kuras',period:t('Dokumentasi November 2024','Documented November 2024'),image:'/wp-content/uploads/2024/11/WhatsApp-Image-2024-11-10-at-13.35.50-1024x576.jpeg',alt:t('Pembangunan sekat kanal bersama masyarakat','Community canal-block construction'),title:t('Menjaga air bersama masyarakat.','Managing water with communities.'),body:t('Masyarakat terlibat dalam survei lokasi dan pembangunan sekat kanal di Temiang dan Tanjung Kuras. Infrastruktur ini ditujukan untuk menahan aliran air keluar dari lahan gambut dan mendukung pemeliharaan oleh kelompok setempat.','Communities participated in site surveys and canal-block construction in Temiang and Tanjung Kuras. These structures aim to retain water in peatlands and support maintenance by local groups.'),value:'2',label:t('desa dalam dokumentasi pembangunan','villages in the construction report'),track:t('Muka air, kondisi sekat, dan risiko kebakaran perlu dipantau berkala untuk menilai hasilnya.','Water levels, structure condition, and fire risk require regular monitoring to assess results.'),slug:'menjaga-gambut-tetap-basah-pembangunan-canal-blocking-di-desa-temiang-dan-desa-tanjung-kuras'},
 {tag:t('Masyarakat & penghidupan','Communities & livelihoods'),place:'Temiang · Bengkalis',period:t('Dokumentasi November 2020','Documented November 2020'),image:'/wp-content/uploads/2020/11/WhatsApp-Image-2020-11-30-at-9.31.19-AM-1024x576.jpeg',alt:t('Kelompok perempuan Temiang dalam kegiatan pertanian tanpa bakar','Temiang women’s group working on zero-burning agriculture'),title:t('Perempuan menggerakkan pertanian tanpa bakar.','Women advancing zero-burning agriculture.'),body:t('Kelompok Makmur Jaya yang beranggotakan 11 perempuan memulai budidaya jahe merah bersama. Dokumentasi 2020 mencatat penanaman 1.000 bibit, dengan dukungan bibit dari YG serta media tanam dan karung dari kelompok.','The Makmur Jaya group of 11 women began growing red ginger together. Documentation from 2020 records 1,000 seedlings planted, with seedlings supported by YG and growing media and sacks supplied by the group.'),value:'11',label:t('perempuan anggota kelompok pada 2020','women in the group in 2020'),track:t('Keberlanjutan praktik tanpa bakar, panen, dan catatan usaha membantu menilai manfaat penghidupan.','Continued zero-burning practices, harvests, and business records help assess livelihood benefits.'),slug:'pertanian-zero-burning-kelompok-perempuan-desa-temiang'}
];
---
<section class="impact-opening"><div class="container"><p class="eyebrow">{t('Alam dan masyarakat','Nature and communities')}</p><h1>{t('Dampak Kerja Bersama','The Impact of Working Together')}</h1><p class="intro">{t('Merawat ekosistem, memperkuat masyarakat. Ikuti capaian restorasi dan pelibatan masyarakat yang tercatat dalam YG GeoPortal.','Caring for ecosystems and strengthening communities. Explore restoration and community engagement recorded in the YG GeoPortal.')}</p></div></section>
<section class="impact-dashboard" id="capaian" data-lang={lang}><div class="container"><div class="impact-cards">{cards.map(card=><article class={'impact-card '+card.key} data-card={card.key}><p class="eyebrow">{t('Capaian program','Program results')}</p><h2>{card.title}</h2><div class="card-value"><strong data-current>{fmt(card.value,card.unit?2:0)}</strong>{card.unit&&<span>{card.unit}</span>}</div><p class="metric-label">{card.label}</p><p class="card-intro">{card.intro}</p><dl>{card.rows.map(row=><div><dt>{row[2]}</dt><dd data-metric={row[0]}>{fmt(Number(row[1]))}</dd></div>)}</dl><details><summary>{t('Lihat capaian','Explore results')}</summary><p>{card.note}</p><a class="text-link external" href={card.url} target="_blank" rel="noreferrer">{t('Lihat data dan lokasi','Explore data and locations')}</a></details></article>)}</div><p class="sync-status" id="impact-sync-status" aria-live="polite">{t('Data tersimpan · 4 Oktober 2026. Memeriksa pembaruan dari YG GeoPortal…','Saved data · 4 October 2026. Checking YG GeoPortal for updates…')}</p></div></section>
<section class="field-results" id="hasil-lapangan"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t('Jejak kerja di Riau','Our work in Riau')}</p><h2>{t('Alam dan masyarakat, dalam satu perjalanan.','Nature and communities, on a shared journey.')}</h2></div><p>{t('Cerita dari lokasi program memperlihatkan kegiatan bersama masyarakat. Angka pada cerita mengikuti periode dokumentasinya.','Stories from program locations show our work with communities. Figures in each story refer to its documented period.')}</p></div><div class="story-list">{stories.map((s,i)=><article class="impact-story"><figure><img src={s.image} alt={s.alt} width="1024" height="576" loading="lazy" decoding="async"/><figcaption>{s.place} · {s.period}</figcaption></figure><div class="story-content"><p class="eyebrow"><span>0{i+1}</span> {s.tag}</p><h3>{s.title}</h3><p>{s.body}</p><div class="result"><strong>{s.value}</strong><span>{s.label}</span></div><p class="tracking"><b>{t('Yang perlu terus diukur','What needs continued measurement')}</b>{s.track}</p><a class="text-link" href={`/id/cerita/${s.slug}/`} hreflang="id">{t('Baca dokumentasi lapangan','Read field documentation (Indonesian)')} →</a></div></article>)}</div></div></section>

<section class="impact-close"><div class="container"><div class="next-step"><div><p class="eyebrow">{t('Lihat lebih dekat','Take a closer look')}</p><h2>{t('Temukan lokasi. Ikuti perkembangannya.','Find the places. Follow their progress.')}</h2><p>{t('Jelajahi lokasi kerja melalui peta dan baca laporan pemantauan yang tersedia untuk publik.','Explore work locations on the map and read publicly available monitoring reports.')}</p></div><div class="actions"><a class="button primary" href="https://webgisyg.id/webgis.html" target="_blank" rel="noreferrer">{t('Buka peta YG','Open the YG map')} ↗</a><a class="text-link" href={t('/id/publikasi/','/en/publications/')}>{t('Laporan dan publikasi','Reports and publications')} →</a></div></div><details class="method"><summary>{t('Bagaimana kami membaca dan menyajikan hasil','How we assess and present results')}</summary><div><p>{t('Kami membedakan kegiatan yang terlaksana, perubahan yang terukur, dan dampak jangka panjang. Penanaman atau pembangunan infrastruktur belum dengan sendirinya membuktikan pemulihan ekosistem.','We distinguish completed activities, measured changes, and long-term impact. Planting or building infrastructure does not, on its own, demonstrate ecosystem recovery.')}</p><p>{t('Contoh di halaman ini merujuk pada dokumentasi dengan tanggal yang dicantumkan. Data antarperiode dan antarlokasi tidak dijumlahkan tanpa memeriksa cakupan serta duplikasi. Klaim peningkatan pendapatan, pengurangan kebakaran, atau pemulihan habitat memerlukan data pembanding dan pemantauan lanjutan.','The examples on this page refer to dated documentation. Data across periods and locations are not added without checking scope and duplication. Claims of increased income, reduced fires, or habitat recovery require comparative data and further monitoring.')}</p></div></details></div></section>

<script is:inline>
(()=>{
 const root=document.querySelector('.impact-dashboard');if(!root)return;
 const id=root.dataset.lang==='id', status=document.getElementById('impact-sync-status');
 const keys=['mangrove','peat','mineral','engagement'];
 const required={mangrove:['Total Bibit Ditanam','Rumah Bibit','Desa Program'],peat:['Total Bibit Ditanam','Sekat Kanal','Estimasi Area Rewetting'],mineral:['Total Bibit Ditanam','Menara Air','Plot Ukur Permanen'],engagement:['Kegiatan Tercatat','Perempuan Terlibat','Pemuda Terlibat']};
 const cacheKey='yg-public-impact-v1';let received=false, lastDate='2026-10-04T15:55:45.432Z';
 function valid(p){return p&&p.type==='yg-public-impact'&&p.version===1&&typeof p.updatedAt==='string'&&Number.isFinite(Date.parse(p.updatedAt))&&Array.isArray(p.cards)&&p.cards.length===4&&keys.every(key=>{const c=p.cards.find(c=>c.key===key);return c&&typeof c.current==='number'&&Number.isFinite(c.current)&&c.current>=0&&Array.isArray(c.rows)&&required[key].every(label=>c.rows.some(r=>r.label===label&&typeof r.value==='number'&&Number.isFinite(r.value)&&r.value>=0));});}
 function date(s){return new Intl.DateTimeFormat(id?'id-ID':'en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Jakarta'}).format(new Date(s));}
 function render(p,live){if(!valid(p)||Date.parse(p.updatedAt)<Date.parse(lastDate))return false;lastDate=p.updatedAt;p.cards.forEach(c=>{const node=root.querySelector('[data-card="'+c.key+'"]');node.querySelector('[data-current]').textContent=new Intl.NumberFormat(id?'id-ID':'en-GB',{maximumFractionDigits:c.key==='engagement'?0:2}).format(c.current);node.querySelectorAll('[data-metric]').forEach(el=>{const r=c.rows.find(r=>r.label===el.dataset.metric);el.textContent=new Intl.NumberFormat(id?'id-ID':'en-GB',{maximumFractionDigits:2}).format(r.value);});});status.textContent=(live?(id?'Sumber: YG GeoPortal · Data ':'Source: YG GeoPortal · Data '):(id?'Data tersimpan · ':'Saved data · '))+date(p.updatedAt)+(live?'':(id?' · Memeriksa pembaruan…':' · Checking for updates…'));return true;}
 try{render(JSON.parse(localStorage.getItem(cacheKey)),false);}catch{}
 const frame=document.createElement('iframe');frame.title=id?'Sinkronisasi capaian publik YG GeoPortal':'YG GeoPortal public results synchronization';frame.hidden=true;frame.setAttribute('aria-hidden','true');frame.tabIndex=-1;
 window.addEventListener('message',event=>{if(event.origin!=='https://webgisyg.id'||event.source!==frame.contentWindow||!valid(event.data))return;if(render(event.data,true)){received=true;try{localStorage.setItem(cacheKey,JSON.stringify(event.data));}catch{}}});
 frame.src='https://webgisyg.id/?impact-feed=1';document.body.appendChild(frame);
 setTimeout(()=>{if(!received)status.textContent=(id?'Menampilkan data tersimpan · ':'Showing saved data · ')+date(lastDate)+(id?'. Pembaruan sumber belum tersedia.':'. Source update is currently unavailable.');},30000);
})();
</script>

<style>
.impact-opening{background:#e9efdf;padding:2.6rem 0}.opening-grid{display:grid;gap:2rem;align-items:center}.opening-grid h1{font-size:clamp(2.3rem,4.4vw,4rem);max-width:15ch;line-height:1.06;letter-spacing:-.045em}.intro{max-width:36rem;color:#425b50;font-size:1.05rem;line-height:1.7;margin:1.2rem 0 1.6rem}figure{margin:0}img{display:block;width:100%;object-fit:cover}.opening-grid img{height:290px;border-radius:1rem}.opening-grid figcaption{font-size:.78rem;padding-top:.6rem;color:#42604e}.field-results,.impact-close{padding:3.5rem 0;background:#fff}.section-heading{display:grid;gap:1rem;margin-bottom:2.3rem;align-items:end}.section-heading h2{max-width:24ch;font-size:clamp(1.8rem,3vw,2.7rem);line-height:1.15}.section-heading>p{max-width:34rem;color:#526258;margin:0;font-size:.95rem}.story-list{display:grid;gap:2.8rem}.impact-story{display:grid;gap:1.8rem;align-items:center;padding-bottom:2.8rem;border-bottom:1px solid #dce4da}.impact-story:last-child{border:0;padding-bottom:0}.impact-story img{aspect-ratio:4/3;border-radius:.8rem;background:#e6ecdf}.impact-story figcaption{padding-top:.7rem;font-size:.78rem;color:#526258}.story-content h3{font-size:clamp(1.6rem,2.7vw,2.3rem);line-height:1.17;max-width:24ch;margin:.6rem 0 1rem}.story-content>p:not(.eyebrow){color:#526258;line-height:1.65}.story-content .eyebrow span{padding-right:.6rem;color:#7a8f4c}.result{display:flex;gap:1rem;align-items:center;padding:1rem 0;border-top:1px solid #dce4da;border-bottom:1px solid #dce4da;margin:1.2rem 0}.result strong{font-size:2.5rem;line-height:1;white-space:nowrap;color:#174b3c}.result span{font-size:.85rem;max-width:22ch}.tracking{font-size:.86rem}.tracking b{display:block;color:#234b3b;margin-bottom:.2rem}.evidence{padding:3.2rem 0;background:#103e32;color:white}.evidence .eyebrow{color:#d1e5ae}.evidence h2{color:white}.evidence .section-heading>p{color:#d5e2d9}.evidence-grid{display:grid;margin:0;gap:1.4rem}.evidence-grid>div{display:flex;flex-direction:column;padding:1.4rem 0;border-top:1px solid #ffffff40}.evidence-grid dt{order:2;font-size:.9rem;font-weight:700;margin-top:.7rem}.evidence-grid dd{order:1;font-size:3rem;margin:0;line-height:1;font-weight:700;color:#d8ebae}.evidence-grid p{order:3;font-size:.85rem;color:#d5e2d9}.evidence-grid a{order:4;margin-top:auto;color:white;font-size:.85rem;min-height:44px;display:inline-flex;align-items:center}.data-date{font-size:.8rem;color:#c9dacf;margin:1.2rem 0 0}.next-step{display:grid;gap:1.5rem;align-items:center}.next-step h2{font-size:clamp(1.8rem,3vw,2.5rem);max-width:25ch}.next-step p:not(.eyebrow){color:#526258;max-width:38rem}.actions{display:flex;flex-direction:column;gap:1rem;align-items:flex-start}.method{border-top:1px solid #dce4da;margin-top:2rem;padding-top:1rem}.method summary{cursor:pointer;font-weight:700;min-height:44px;padding:.6rem 0}.method>div{max-width:55rem;color:#526258;font-size:.9rem}.impact-opening .eyebrow{color:#3d613e}
@media(min-width:760px){.opening-grid{grid-template-columns:1.1fr 1fr;gap:3rem}.impact-story{grid-template-columns:1fr 1fr;gap:3.2rem}.impact-story:nth-child(even)>figure{order:2}.section-heading{grid-template-columns:1.15fr 1fr;gap:3rem}.evidence-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:2.5rem}.next-step{grid-template-columns:1fr auto}}
@media(max-width:759px){.impact-opening{padding:2rem 0}.opening-grid img{height:auto;aspect-ratio:16/9}.field-results,.impact-close{padding:2.5rem 0}.impact-story img{aspect-ratio:16/10}.story-list{gap:2rem}.evidence-grid{gap:0}.evidence-grid>div{padding:1.2rem 0}.opening-grid h1{max-width:19ch}}

.impact-opening{background:var(--paper);padding:2.5rem 0 1.5rem}.impact-opening h1{font-size:clamp(2.4rem,4vw,3.7rem);max-width:22ch;margin-bottom:1rem}.impact-opening .intro{max-width:50rem;margin:0}.impact-opening .eyebrow{color:var(--peat-700)}
.impact-dashboard{background:var(--paper);padding:1rem 0 2.5rem}.impact-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.impact-card{padding:1.8rem;border:1px solid var(--line);border-top:4px solid var(--coast-700);border-radius:1rem;background:#fff}.impact-card.peat{border-top-color:var(--peat-700)}.impact-card.mineral{border-top-color:#66834a}.impact-card.engagement{border-top-color:var(--forest-650)}.impact-card .eyebrow{font-size:.68rem;color:var(--muted)}.impact-card h2{font-size:1.45rem;line-height:1.2;min-height:1.8rem;margin-bottom:1.2rem}.card-value{display:flex;align-items:baseline;gap:.6rem;color:var(--forest-950)}.card-value strong{font-size:clamp(2.8rem,5vw,4rem);line-height:1;font-weight:750;letter-spacing:-.04em}.card-value>span{font-size:1.15rem}.metric-label{font-size:.86rem;font-weight:700;margin:.6rem 0}.card-intro{font-size:.9rem;color:var(--muted);min-height:2.8rem}.impact-card dl{margin:1rem 0}.impact-card dl>div{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--line);padding:.65rem 0}.impact-card dt{font-size:.85rem;color:var(--muted)}.impact-card dd{font-weight:750;margin:0;white-space:nowrap}.impact-card summary{cursor:pointer;font-weight:750;color:var(--forest-800);padding:.75rem 0}.impact-card details p{font-size:.85rem;color:var(--muted)}.impact-card details a{font-size:.85rem}.sync-status{font-size:.78rem;color:var(--muted);margin:1.2rem 0 0}.field-results{background:#edf6f8}.impact-close{background:var(--paper)}.field-results .eyebrow{color:var(--peat-700)}@media(max-width:640px){.impact-cards{grid-template-columns:1fr;gap:1rem}.impact-card{padding:1.3rem}.card-intro{min-height:0}.impact-opening{padding-top:1.75rem}}
</style>
