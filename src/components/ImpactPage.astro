---
import { impactSnapshot, type Lang } from '../data/site';
const {lang} = Astro.props as {lang:Lang};
const id=lang==='id';
const t=(a:string,b:string)=>id?a:b;
const stories=[
 {tag:t('Mangrove & pesisir','Mangroves & coasts'),place:'Buruk Bakul · Bengkalis',period:t('Dokumentasi Mei 2025','Documented May 2025'),image:'/wp-content/uploads/2025/07/DJI_0389-1024x576.jpg',alt:t('Pemecah ombak di pesisir Buruk Bakul','Wave breakers along the Buruk Bakul coast'),title:t('Merawat mangrove, menjaga pesisir.','Caring for mangroves and coasts.'),body:t('Bersama Sekat Bakau dan mitra, penanaman mangrove dipadukan dengan pembibitan masyarakat dan pembangunan pemecah ombak. Laporan Mei 2025 mencatat struktur pemecah ombak sepanjang 200 meter di Buruk Bakul.','With Sekat Bakau and partners, mangrove planting is combined with community nurseries and wave breakers. The May 2025 report documents 200 metres of wave breakers in Buruk Bakul.'),value:'200 m',label:t('pemecah ombak terdokumentasi','of documented wave breakers'),track:t('Perkembangan tanaman, sedimentasi, dan perubahan garis pantai menjadi ukuran lanjutan pemulihan.','Plant development, sedimentation, and shoreline change are the next measures of recovery.'),slug:'pendekatan-kolaboratif-dalam-pemberdayaan-masyarakat-dan-konservasi-kawasan-pesisir-di-kabupaten-bengkalis'},
 {tag:t('Gambut & air','Peatlands & water'),place:'Temiang · Tanjung Kuras',period:t('Dokumentasi November 2024','Documented November 2024'),image:'/wp-content/uploads/2024/11/WhatsApp-Image-2024-11-10-at-13.35.50-1024x576.jpeg',alt:t('Pembangunan sekat kanal bersama masyarakat','Community canal-block construction'),title:t('Menjaga air bersama masyarakat.','Managing water with communities.'),body:t('Masyarakat terlibat dalam survei lokasi dan pembangunan sekat kanal di Temiang dan Tanjung Kuras. Infrastruktur ini ditujukan untuk menahan aliran air keluar dari lahan gambut dan mendukung pemeliharaan oleh kelompok setempat.','Communities participated in site surveys and canal-block construction in Temiang and Tanjung Kuras. These structures aim to retain water in peatlands and support maintenance by local groups.'),value:'2',label:t('desa dalam dokumentasi pembangunan','villages in the construction report'),track:t('Muka air, kondisi sekat, dan risiko kebakaran perlu dipantau berkala untuk menilai hasilnya.','Water levels, structure condition, and fire risk require regular monitoring to assess results.'),slug:'menjaga-gambut-tetap-basah-pembangunan-canal-blocking-di-desa-temiang-dan-desa-tanjung-kuras'},
 {tag:t('Masyarakat & penghidupan','Communities & livelihoods'),place:'Temiang · Bengkalis',period:t('Dokumentasi November 2020','Documented November 2020'),image:'/wp-content/uploads/2020/11/WhatsApp-Image-2020-11-30-at-9.31.19-AM-1024x576.jpeg',alt:t('Kelompok perempuan Temiang dalam kegiatan pertanian tanpa bakar','Temiang women’s group working on zero-burning agriculture'),title:t('Perempuan menggerakkan pertanian tanpa bakar.','Women advancing zero-burning agriculture.'),body:t('Kelompok Makmur Jaya yang beranggotakan 11 perempuan memulai budidaya jahe merah bersama. Dokumentasi 2020 mencatat penanaman 1.000 bibit, dengan dukungan bibit dari YG serta media tanam dan karung dari kelompok.','The Makmur Jaya group of 11 women began growing red ginger together. Documentation from 2020 records 1,000 seedlings planted, with seedlings supported by YG and growing media and sacks supplied by the group.'),value:'11',label:t('perempuan anggota kelompok pada 2020','women in the group in 2020'),track:t('Keberlanjutan praktik tanpa bakar, panen, dan catatan usaha membantu menilai manfaat penghidupan.','Continued zero-burning practices, harvests, and business records help assess livelihood benefits.'),slug:'pertanian-zero-burning-kelompok-perempuan-desa-temiang'}
];
---
<section class="impact-opening"><div class="container opening-grid"><div><p class="eyebrow">{t('Dampak kerja bersama','The impact of working together')}</p><h1>{t('Dari aksi di tapak, menuju perubahan.','Local action. Lasting commitment.')}</h1><p class="intro">{t('Bersama masyarakat, kami merawat ekosistem gambut dan pesisir serta mengembangkan penghidupan yang berkelanjutan. Berikut jejak kerja dan hasil yang telah didokumentasikan.','With communities, we care for peatland and coastal ecosystems and support sustainable livelihoods. Explore our documented work and results.')}</p><a class="button primary" href="#hasil-lapangan">{t('Lihat hasil di lapangan','Explore field results')} ↓</a></div><figure><img src="/images/community-mangrove-main.webp" width="1024" height="683" fetchpriority="high" alt={t('Masyarakat dan mitra dalam kegiatan mangrove Yayasan Gambut','Community members and partners in a Yayasan Gambut mangrove activity')}/><figcaption>{t('Konservasi tumbuh dari kerja bersama.','Conservation grows through collaboration.')}</figcaption></figure></div></section>
<section class="field-results" id="hasil-lapangan"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t('Jejak kerja di Riau','Our work in Riau')}</p><h2>{t('Alam dan masyarakat, dalam satu perjalanan.','Nature and communities, on a shared journey.')}</h2></div><p>{t('Contoh terpilih dari arsip lapangan. Setiap capaian memiliki lokasi dan periode sendiri; angka berikut bukan total seluruh program YG.','Selected examples from our field archive. Each result has its own location and period; these figures are not totals across all YG programs.')}</p></div><div class="story-list">{stories.map((s,i)=><article class="impact-story"><figure><img src={s.image} alt={s.alt} width="1024" height="576" loading="lazy" decoding="async"/><figcaption>{s.place} · {s.period}</figcaption></figure><div class="story-content"><p class="eyebrow"><span>0{i+1}</span> {s.tag}</p><h3>{s.title}</h3><p>{s.body}</p><div class="result"><strong>{s.value}</strong><span>{s.label}</span></div><p class="tracking"><b>{t('Yang perlu terus diukur','What needs continued measurement')}</b>{s.track}</p><a class="text-link" href={`/id/cerita/${s.slug}/`} hreflang="id">{t('Baca dokumentasi lapangan','Read field documentation (Indonesian)')} →</a></div></article>)}</div></div></section>
<section class="evidence"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t('Data di balik cerita','The data behind the stories')}</p><h2>{t('Bukti yang dapat ditelusuri.','Evidence you can explore.')}</h2></div><p>{t('Peta, laporan, dan catatan biodiversitas membuka akses pada dokumentasi kerja YG.','Maps, reports, and biodiversity records provide access to documentation of YG’s work.')}</p></div><dl class="evidence-grid">{impactSnapshot[lang].map(m=><div><dt>{m.label}</dt><dd>{m.value}</dd><p>{m.note}</p><a href={m.href} target="_blank" rel="noreferrer">{t('Telusuri data','Explore data')} ↗<span class="sr-only"> — {m.label}</span></a></div>)}</dl><p class="data-date">{t('Cakupan arsip publik per 28 September 2026, pukul 10.44 WIB. Angka ini menunjukkan dokumentasi yang tersedia, bukan ukuran dampak akhir.','Public archive coverage as of 28 September 2026, 10:44 WIB. These figures describe available documentation, not final impact.')}</p></div></section>
<section class="impact-close"><div class="container"><div class="next-step"><div><p class="eyebrow">{t('Lihat lebih dekat','Take a closer look')}</p><h2>{t('Temukan lokasi. Ikuti perkembangannya.','Find the places. Follow their progress.')}</h2><p>{t('Jelajahi lokasi kerja melalui peta dan baca laporan pemantauan yang tersedia untuk publik.','Explore work locations on the map and read publicly available monitoring reports.')}</p></div><div class="actions"><a class="button primary" href="https://webgisyg.id/webgis.html" target="_blank" rel="noreferrer">{t('Buka peta YG','Open the YG map')} ↗</a><a class="text-link" href={t('/id/publikasi/','/en/publications/')}>{t('Laporan dan publikasi','Reports and publications')} →</a></div></div><details class="method"><summary>{t('Bagaimana kami membaca dan menyajikan hasil','How we assess and present results')}</summary><div><p>{t('Kami membedakan kegiatan yang terlaksana, perubahan yang terukur, dan dampak jangka panjang. Penanaman atau pembangunan infrastruktur belum dengan sendirinya membuktikan pemulihan ekosistem.','We distinguish completed activities, measured changes, and long-term impact. Planting or building infrastructure does not, on its own, demonstrate ecosystem recovery.')}</p><p>{t('Contoh di halaman ini merujuk pada dokumentasi dengan tanggal yang dicantumkan. Data antarperiode dan antarlokasi tidak dijumlahkan tanpa memeriksa cakupan serta duplikasi. Klaim peningkatan pendapatan, pengurangan kebakaran, atau pemulihan habitat memerlukan data pembanding dan pemantauan lanjutan.','The examples on this page refer to dated documentation. Data across periods and locations are not added without checking scope and duplication. Claims of increased income, reduced fires, or habitat recovery require comparative data and further monitoring.')}</p></div></details></div></section>
<style>
.impact-opening{background:#e9efdf;padding:2.6rem 0}.opening-grid{display:grid;gap:2rem;align-items:center}.opening-grid h1{font-size:clamp(2.3rem,4.4vw,4rem);max-width:15ch;line-height:1.06;letter-spacing:-.045em}.intro{max-width:36rem;color:#425b50;font-size:1.05rem;line-height:1.7;margin:1.2rem 0 1.6rem}figure{margin:0}img{display:block;width:100%;object-fit:cover}.opening-grid img{height:290px;border-radius:1rem}.opening-grid figcaption{font-size:.78rem;padding-top:.6rem;color:#42604e}.field-results,.impact-close{padding:3.5rem 0;background:#fff}.section-heading{display:grid;gap:1rem;margin-bottom:2.3rem;align-items:end}.section-heading h2{max-width:24ch;font-size:clamp(1.8rem,3vw,2.7rem);line-height:1.15}.section-heading>p{max-width:34rem;color:#526258;margin:0;font-size:.95rem}.story-list{display:grid;gap:2.8rem}.impact-story{display:grid;gap:1.8rem;align-items:center;padding-bottom:2.8rem;border-bottom:1px solid #dce4da}.impact-story:last-child{border:0;padding-bottom:0}.impact-story img{aspect-ratio:4/3;border-radius:.8rem;background:#e6ecdf}.impact-story figcaption{padding-top:.7rem;font-size:.78rem;color:#526258}.story-content h3{font-size:clamp(1.6rem,2.7vw,2.3rem);line-height:1.17;max-width:24ch;margin:.6rem 0 1rem}.story-content>p:not(.eyebrow){color:#526258;line-height:1.65}.story-content .eyebrow span{padding-right:.6rem;color:#7a8f4c}.result{display:flex;gap:1rem;align-items:center;padding:1rem 0;border-top:1px solid #dce4da;border-bottom:1px solid #dce4da;margin:1.2rem 0}.result strong{font-size:2.5rem;line-height:1;white-space:nowrap;color:#174b3c}.result span{font-size:.85rem;max-width:22ch}.tracking{font-size:.86rem}.tracking b{display:block;color:#234b3b;margin-bottom:.2rem}.evidence{padding:3.2rem 0;background:#103e32;color:white}.evidence .eyebrow{color:#d1e5ae}.evidence h2{color:white}.evidence .section-heading>p{color:#d5e2d9}.evidence-grid{display:grid;margin:0;gap:1.4rem}.evidence-grid>div{display:flex;flex-direction:column;padding:1.4rem 0;border-top:1px solid #ffffff40}.evidence-grid dt{order:2;font-size:.9rem;font-weight:700;margin-top:.7rem}.evidence-grid dd{order:1;font-size:3rem;margin:0;line-height:1;font-weight:700;color:#d8ebae}.evidence-grid p{order:3;font-size:.85rem;color:#d5e2d9}.evidence-grid a{order:4;margin-top:auto;color:white;font-size:.85rem;min-height:44px;display:inline-flex;align-items:center}.data-date{font-size:.8rem;color:#c9dacf;margin:1.2rem 0 0}.next-step{display:grid;gap:1.5rem;align-items:center}.next-step h2{font-size:clamp(1.8rem,3vw,2.5rem);max-width:25ch}.next-step p:not(.eyebrow){color:#526258;max-width:38rem}.actions{display:flex;flex-direction:column;gap:1rem;align-items:flex-start}.method{border-top:1px solid #dce4da;margin-top:2rem;padding-top:1rem}.method summary{cursor:pointer;font-weight:700;min-height:44px;padding:.6rem 0}.method>div{max-width:55rem;color:#526258;font-size:.9rem}.impact-opening .eyebrow{color:#3d613e}
@media(min-width:760px){.opening-grid{grid-template-columns:1.1fr 1fr;gap:3rem}.impact-story{grid-template-columns:1fr 1fr;gap:3.2rem}.impact-story:nth-child(even)>figure{order:2}.section-heading{grid-template-columns:1.15fr 1fr;gap:3rem}.evidence-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:2.5rem}.next-step{grid-template-columns:1fr auto}}
@media(max-width:759px){.impact-opening{padding:2rem 0}.opening-grid img{height:auto;aspect-ratio:16/9}.field-results,.impact-close{padding:2.5rem 0}.impact-story img{aspect-ratio:16/10}.story-list{gap:2rem}.evidence-grid{gap:0}.evidence-grid>div{padding:1.2rem 0}.opening-grid h1{max-width:19ch}}
</style>
